<?xml version='1.0' encoding='utf-8'?>
<roblox version="4">
  <Item class="Folder" referent="RBXKartPackage">
    <Properties>
      <string name="Name">KartPackage</string>
    </Properties>
    <Item class="Folder" referent="RBXKartSystem">
      <Properties>
        <string name="Name">KartSystem</string>
      </Properties>
      <Item class="ModuleScript" referent="RBXKartConfig">
        <Properties>
          <string name="Name">KartConfig</string>
          <ProtectedString name="Source">-- Distances in studs, speeds in studs/second. Local forward is -Z.
return table.freeze({
	ReleaseVersion = 3,
	ModelScale = 0.84,
	MaxSpeed = 82,
	ReverseSpeed = 24,
	Acceleration = 39,
	BrakeAcceleration = 75,
	CoastDrag = 0.55,
	Grip = 10,
	DriftGrip = 3.5,
	SteerResponse = 12,
	ThrottleResponse = 9,
	DriftEnterResponse = 4.5,
	DriftExitResponse = 5.5,
	DriftSlipAngle = math.rad(11),
	YawResponse = 6,
	MaxYawAcceleration = 8,
	NormalResponse = 9,
	VisualSuspensionResponse = 18,
	CameraPositionResponse = 7,
	CameraHeightResponse = 3.5,
	CameraHeadingResponse = 5,
	MaxSteer = math.rad(29),
	MaxCornerAcceleration = 85,
	Wheelbase = 4.8 * 0.84,
	WheelRadius = 1.05 * 0.84,
	SuspensionRest = 0.65 * 0.84,
	SuspensionTravel = 0.65 * 0.84,
	SpringFrequency = 2.0,
	SpringDamping = 1.05,
	DriftMinSpeed = 27,
	DriftChargeTime = 1.5,
	TurboDuration = 1.15,
	TurboPower = 32,
	TurboCooldown = 6,
	InputTimeout = 0.5,
	InputRate = 30,
	SpawnCFrame = CFrame.new(0, 5, 0),
	-- Place anchored Parts in Workspace.KartSpawns to override this default.
	Palette = {
		Red = Color3.fromRGB(220, 26, 46),
		Blue = Color3.fromRGB(25, 119, 235),
		Green = Color3.fromRGB(79, 195, 42),
		Yellow = Color3.fromRGB(255, 190, 21),
		Purple = Color3.fromRGB(154, 48, 232),
		Black = Color3.fromRGB(30, 33, 40),
	},
})
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXKartDynamics">
        <Properties>
          <string name="Name">KartDynamics</string>
          <ProtectedString name="Source">-- Pure calculations shared by the server and the standalone Luau tests.
local Dynamics = {}

function Dynamics.approach(value, target, response, dt)
	return value+(target-value)*(1-math.exp(-response*dt))
end

function Dynamics.suspension(compression, normalVelocity, gravity, config)
	local omega=config.SpringFrequency*2*math.pi
	-- Acceleration per quarter mass; critically damped, bounded contact load.
	return math.clamp(gravity+compression*omega*omega-normalVelocity*2*config.SpringDamping*omega,0,gravity*2.5)
end

function Dynamics.steering(speed, steer, blend, config)
	local angle=-steer*config.MaxSteer/(1+(math.abs(speed)/36)^2)
	local limit=config.MaxCornerAcceleration/math.max(math.abs(speed),12)
	local yaw=math.clamp(math.tan(angle)*speed/config.Wheelbase*(1+blend*0.12),-limit,limit)
	return angle,yaw
end

function Dynamics.lateral(speed, sideSpeed, steer, blend, config)
	local target=-steer*math.max(speed,0)*math.tan(config.DriftSlipAngle)*blend
	local grip=config.Grip+(config.DriftGrip-config.Grip)*blend
	return math.clamp((target-sideSpeed)*grip,-config.MaxCornerAcceleration,config.MaxCornerAcceleration)
end

function Dynamics.longitudinal(speed, throttle, boost, config)
	local limit = config.MaxSpeed + boost
	local accel = 0
	if throttle &gt; 0 then
		accel = speed &lt; -1 and config.BrakeAcceleration or config.Acceleration
	elseif throttle &lt; 0 then
		accel = speed &gt; 1 and -config.BrakeAcceleration or -config.Acceleration * 0.65
	end
	accel *= math.abs(throttle)
	if boost &gt; 0 and throttle &gt;= 0 then accel += boost * 1.6 end
	if speed &gt; limit then accel = math.min(accel, -(speed - limit) * 7) end
	if speed &lt; -config.ReverseSpeed then accel = math.max(accel, (-config.ReverseSpeed - speed) * 7) end
	return accel - speed * config.CoastDrag * (throttle == 0 and 1 or 0.15)
end

function Dynamics.finite(value)
	return type(value) == "number" and value == value and math.abs(value) &lt; math.huge
end

function Dynamics.updateBoost(state, now, dt, grounded, speed, config)
	if state.player==nil then
		state.charge=0; state.wasDrift=false; state.boostEnd=0; state.boostPower=0
		-- The kart retains its recharge deadline when a driver leaves or respawns.
		return false,0
	end
	local drifting=state.drift and math.abs(state.steer)&gt;0.15 and speed&gt;config.DriftMinSpeed and grounded
	local readyAt=math.max(state.cooldown,state.boostEnd)
	if drifting and now&gt;=readyAt then
		-- A long simulation stall cannot instantly award a drift boost, and a
		-- frame straddling recharge completion only credits its eligible tail.
		local elapsed=Dynamics.finite(dt) and math.clamp(dt,0,1/15) or 0
		elapsed=math.min(elapsed,math.max(now-readyAt,0))
		state.charge=math.min(state.charge+elapsed,config.DriftChargeTime)
		-- Epoch deadlines have sub-microsecond double precision; allow that
		-- rounding error without adding a simulation frame to the charge.
		if state.charge+1e-6&gt;=config.DriftChargeTime then
			state.charge=0
			state.boostEnd=now+config.TurboDuration
			state.boostPower=config.TurboPower
			state.cooldown=now+config.TurboCooldown
		end
	else
		-- Releasing the drift or losing speed/contact cancels partial charge.
		-- Turbo and recharge also require a fresh charge after they finish.
		state.charge=0
	end
	state.wasDrift=drifting
	local power=now&lt;state.boostEnd and state.boostPower or 0
	if power==0 then state.boostPower=0 end
	return drifting,power
end

return table.freeze(Dynamics)
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXKartBuilder">
        <Properties>
          <string name="Name">KartBuilder</string>
          <ProtectedString name="Source">local Config = require(script.Parent.KartConfig)
local Builder = {}
local WHITE = Color3.fromRGB(235, 239, 245)
local BLACK = Color3.fromRGB(20, 23, 30)
local RUBBER = Color3.fromRGB(13, 14, 19)
local METAL = Color3.fromRGB(90, 101, 119)
local BLUE = Color3.fromRGB(20, 85, 220)
local YELLOW = Color3.fromRGB(255, 205, 35)
local SEAT = Color3.fromRGB(25, 34, 59)

function Builder.build(name, spawn, color)
	color = color or Config.Palette.Red
	local scale = Config.ModelScale or 0.84
	-- Build once in canonical units, then scale the entire assembly together.
	local rest = Config.SuspensionRest / scale
	local radius = Config.WheelRadius / scale
	local model = Instance.new("Model")
	model.Name = name
	model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	local function folder(label)
		local f = Instance.new("Folder")
		f.Name = label; f.Parent = model
		return f
	end
	local body = folder("Body")
	local wheels = folder("Wheels")
	local suspension = folder("Suspension")
	local effects = folder("Effects")
	local headlights = folder("Headlights")
	local exhaust = folder("Exhaust")
	local attachments = folder("Attachments")
	local chassis
	local function part(label, size, cf, tint, material, parent, shape, loose, class)
		local p = Instance.new(class or "Part")
		p.Name = label; p.Size = size; p.CFrame = spawn * cf
		p.Color = tint; p.Material = material or Enum.Material.SmoothPlastic
		p.TopSurface = Enum.SurfaceType.Smooth; p.BottomSurface = Enum.SurfaceType.Smooth
		p.CanCollide = false; p.CanTouch = false; p.CanQuery = false
		p.Massless = true
		if shape then p.Shape = shape end
		p.Parent = parent or body
		if chassis and not loose then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = chassis; weld.Part1 = p; weld.Parent = p
		end
		return p
	end
	local function bar(label, a, b, width, tint, parent)
		return part(label, Vector3.new((b-a).Magnitude, width, width), CFrame.lookAt((a+b)/2,b)*CFrame.Angles(0,math.pi/2,0), tint, Enum.Material.Metal, parent, Enum.PartType.Cylinder)
	end
	local function ring(parent, base, radius, thickness, tint, material, count, target)
		for i = 1, count do
			local angle = (i-0.5)*math.pi*2/count
			local cf = base * CFrame.Angles(0,0,angle) * CFrame.new(radius,0,0) * CFrame.Angles(0,0,math.pi/2)
			local segment = part("RingSegment", Vector3.new(2*radius*math.tan(math.pi/count), thickness, thickness), cf, tint, material, parent, nil, target ~= nil)
			if target then
				local w = Instance.new("WeldConstraint"); w.Part0 = target; w.Part1 = segment; w.Parent = segment
			end
		end
	end
	local function rounded(label,size,cf,tint,radius,parent)
		radius=math.min(radius,size.X/2-0.01,size.Z/2-0.01)
		part(label,Vector3.new(size.X-2*radius,size.Y,size.Z),cf,tint,nil,parent)
		for _,side in ipairs({-1,1}) do
			part(label,Vector3.new(radius,size.Y,size.Z-2*radius),cf*CFrame.new(side*(size.X/2-radius/2),0,0),tint,nil,parent)
		end
		for _,x in ipairs({-1,1}) do for _,z in ipairs({-1,1}) do
			-- Flattened ellipsoids curve away from the top surface; flat cylinder
			-- caps would overlap the panels and create visible z-fighting.
			part(label.."Corner",Vector3.new(2*radius,size.Y,2*radius),cf*CFrame.new(x*(size.X/2-radius),0,z*(size.Z/2-radius)),tint,nil,parent,Enum.PartType.Ball)
		end end
	end

	chassis = part("Chassis", Vector3.new(3.7,0.5,6.5), CFrame.new(), BLACK, Enum.Material.Metal, model, nil, true)
	chassis.Massless = false; chassis.CanCollide = true; chassis.CanQuery = true
	chassis.CustomPhysicalProperties = PhysicalProperties.new(3.5,0.12,0,100,100)
	chassis.RootPriority=127
	model.PrimaryPart = chassis
	part("FloorPan",Vector3.new(3.9,0.15,4.3),CFrame.new(0,0.48,0.1),METAL,Enum.Material.DiamondPlate)
	-- Molded elliptical bodywork gives the kart a compact toy-racer silhouette.
	-- Each shell is one smooth ellipsoid, avoiding a flat slab with tiled seams.
	part("BlueNoseLower",Vector3.new(3.25,0.74,2.5),CFrame.new(0,0.16,-2.2),BLUE,nil,body,Enum.PartType.Ball)
	local noseCF=CFrame.new(0,1.00,-2.15)*CFrame.Angles(math.rad(-23),0,0)
	part("WhiteNoseShell",Vector3.new(2.75,0.66,2.75),noseCF*CFrame.new(0,-0.10,0),WHITE,nil,body,Enum.PartType.Ball)
	part("RedNose",Vector3.new(2.46,0.65,2.68),noseCF,color,nil,body,Enum.PartType.Ball)
	for _,side in ipairs({-1,1}) do
		part("SidePodBlue",Vector3.new(0.98,0.78,2.22),CFrame.new(side*1.75,0.34,0.55),BLUE,nil,body,Enum.PartType.Ball)
		part("SidePodWhite",Vector3.new(1.00,0.50,2.30),CFrame.new(side*1.75,0.61,0.55),WHITE,nil,body,Enum.PartType.Ball)
		part("SidePodRed",Vector3.new(0.98,0.56,2.18),CFrame.new(side*1.75,0.81,0.55),color,nil,body,Enum.PartType.Ball)
		bar("CockpitRail",Vector3.new(side*1.18,1.05,-0.5),Vector3.new(side*1.18,1.55,1.55),0.13,BLACK)
		bar("SideGuard",Vector3.new(side*2.06,0.15,-0.45),Vector3.new(side*2.06,0.15,1.6),0.15,BLACK)
		-- Red rounded haunches sit inside, rather than over, the rear tires.
		part("RearFender",Vector3.new(0.75,0.37,1.15),CFrame.new(side*1.65,0.94,1.3),color,nil,body,Enum.PartType.Ball)
	end
	-- Four white bars form a flush tilted square with an actual open center.
	local badge=noseCF*CFrame.new(0,0.326,-0.10)*CFrame.Angles(0,math.rad(15),0)
	for _,side in ipairs({-1,1}) do
		part("RobloxBadge",Vector3.new(0.88,0.012,0.25),badge*CFrame.new(0,0,side*0.315),WHITE)
		part("RobloxBadge",Vector3.new(0.25,0.012,0.38),badge*CFrame.new(side*0.315,0,0),WHITE)
	end
	local bumper=folder("FrontBumper")
	rounded("WhiteFrontBumper",Vector3.new(3.13,0.28,0.66),CFrame.new(0,0.13,-3.37)*CFrame.Angles(math.pi/2,0,0),WHITE,0.23,bumper)
	for _,x in ipairs({-1.02,-0.52,0.52,1.02}) do
		part("BlueBumperVent",Vector3.new(0.22,0.31,0.035),CFrame.new(x,0.12,-3.525)*CFrame.Angles(0,0,math.rad(-12)),BLUE,nil,bumper)
	end
	bar("BumperLower",Vector3.new(-1.45,-0.25,-3.38),Vector3.new(1.45,-0.25,-3.38),0.15,BLACK,bumper)
	for _,side in ipairs({-1,1}) do
		bar("BumperCorner",Vector3.new(side*1.45,-0.25,-3.38),Vector3.new(side*1.58,0.22,-3.31),0.15,BLACK,bumper)
		local lamp=part("LED",Vector3.new(0.22,0.07,0.035),CFrame.new(side*1.48,0.42,-3.25),WHITE,Enum.Material.Neon,headlights)
		local beam=Instance.new("SpotLight"); beam.Face=Enum.NormalId.Front; beam.Brightness=0.8; beam.Range=22; beam.Angle=70; beam.Parent=lamp
		part("BrakeLight",Vector3.new(0.32,0.13,0.04),CFrame.new(side*1.28,0.42,3.20),Color3.fromRGB(110,5,10),nil,effects)
	end
	local seat=part("DriverSeat",Vector3.new(1.95,0.3,1.65),CFrame.new(0,0.84,0.65),SEAT,Enum.Material.Fabric,model,nil,false,"VehicleSeat")
	seat.HeadsUpDisplay=false; seat.MaxSpeed=0; seat.Torque=0; seat.TurnSpeed=0
	rounded("SeatBack",Vector3.new(1.95,0.28,1.75),CFrame.new(0,1.66,1.42)*CFrame.Angles(math.rad(80),0,0),SEAT,0.27)
	for _,side in ipairs({-1,1}) do
		part("SeatBolster",Vector3.new(0.22,0.9,0.6),CFrame.new(side*0.96,1.29,1.10)*CFrame.Angles(0,0,side*0.12),SEAT,Enum.Material.Fabric)
		bar("RearGuard",Vector3.new(side*2.04,0.15,1.6),Vector3.new(side*2.04,0.15,3.3),0.18,BLACK)
	end
	-- Compact exposed engine and axle replace the oversized rear wing.
	part("EngineBlock",Vector3.new(1.55,0.55,1.0),CFrame.new(0,0.47,2.45),METAL,Enum.Material.Metal)
	for i=1,6 do part("EngineCoolingFin",Vector3.new(1.62,0.045,0.10),CFrame.new(0,0.74,1.95+i*0.15),BLACK,Enum.Material.Metal) end
	bar("RearAxle",Vector3.new(-2.4,0,2.4),Vector3.new(2.4,0,2.4),0.22,METAL)
	bar("RearBumper",Vector3.new(-1.7,0.05,3.35),Vector3.new(1.7,0.05,3.35),0.22,BLACK)

	-- Non-colliding visual wheels; each client interpolates these same motors.
	-- Physical contacts are handled only by the spring forces and collision hull.
	local wheelData={}
	for _,desc in ipairs({{"FrontLeft",-1,-2.4,true},{"FrontRight",1,-2.4,true},{"RearLeft",-1,2.4,false},{"RearRight",1,2.4,false}}) do
		local label,side,z,front=table.unpack(desc)
		local group=Instance.new("Model"); group.Name=label; group.Parent=wheels
		local origin=Vector3.new(side*2.68,rest+0.4,z)
		-- Smaller chassis-mounted collision shells catch walls/curbs without
		-- competing with the raycast tires during normal spring compression.
		local guard=part(label.."Collision",Vector3.new(0.85,1.35,1.35),CFrame.new(origin-Vector3.new(0,0.35,0)),BLACK,Enum.Material.SmoothPlastic,suspension,Enum.PartType.Ball)
		guard.Transparency=1; guard.CanCollide=true; guard.CanQuery=true
		guard.CustomPhysicalProperties=PhysicalProperties.new(0.1,0.1,0,100,100)
		local cf=CFrame.new(origin-Vector3.new(0,rest,0))
		local tire=part("Tire",Vector3.new(0.91,2*radius,2*radius),cf,RUBBER,Enum.Material.SmoothPlastic,group,Enum.PartType.Cylinder,true)
		local motor=Instance.new("Motor6D"); motor.Name="WheelMotor"; motor.Part0=chassis; motor.Part1=tire; motor.C0=cf; motor.Parent=tire
		local function detail(label,size,offset,tint,material,shape)
			local p=part(label,size,cf*offset,tint,material,group,shape,true)
			local w=Instance.new("WeldConstraint"); w.Part0=tire; w.Part1=p; w.Parent=p
			return p
		end
		detail("Sidewall",Vector3.new(0.075,1.99,1.99),CFrame.new(side*0.445,0,0),RUBBER,Enum.Material.SmoothPlastic,Enum.PartType.Cylinder)
		detail("Rim",Vector3.new(0.1,1.42,1.42),CFrame.new(side*0.49,0,0),YELLOW,Enum.Material.Metal,Enum.PartType.Cylinder)
		detail("RimLip",Vector3.new(0.035,1.54,1.54),CFrame.new(side*0.48,0,0),YELLOW,Enum.Material.Metal,Enum.PartType.Cylinder)
		for _,offset in ipairs({-1,1}) do
			detail("RimCutout",Vector3.new(0.02,0.24,0.31),CFrame.new(side*0.55,offset*0.22,offset*0.12)*CFrame.Angles(math.rad(25),0,0),BLACK,Enum.Material.SmoothPlastic)
		end
		for n=1,12 do
			for _,offset in ipairs({-0.25,0.25}) do
				detail("Tread",Vector3.new(0.018,0.012,0.18),CFrame.Angles(n*math.pi/6,0,0)*CFrame.new(offset,radius,0),Color3.fromRGB(25,26,30),Enum.Material.SmoothPlastic)
			end
		end
		local mount=Instance.new("Attachment"); mount.Name=label.."Mount"; mount.Position=origin; mount.Parent=chassis
		local force=Instance.new("VectorForce"); force.Name=label.."Contact"; force.Attachment0=mount; force.RelativeTo=Enum.ActuatorRelativeTo.World; force.ApplyAtCenterOfMass=false; force.Force=Vector3.zero; force.Parent=suspension
		local emitterAt=Instance.new("Attachment"); emitterAt.Name=label.."ContactEffects"; emitterAt.Position=origin-Vector3.new(0,rest+radius,0); emitterAt.Parent=chassis
		local smoke=Instance.new("ParticleEmitter"); smoke.Name="TireSmoke"; smoke.Texture="rbxasset://textures/particles/smoke_main.dds"; smoke.Color=ColorSequence.new(Color3.fromRGB(180,187,200)); smoke.Lifetime=NumberRange.new(0.3,0.6); smoke.Speed=NumberRange.new(1,3); smoke.Rate=0; smoke.SpreadAngle=Vector2.new(30,30); smoke.Size=NumberSequence.new({NumberSequenceKeypoint.new(0,0.3),NumberSequenceKeypoint.new(1,1.8)}); smoke.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,0.65),NumberSequenceKeypoint.new(1,1)}); smoke.Parent=emitterAt
		local sparks=Instance.new("ParticleEmitter"); sparks.Name="DriftSparks"; sparks.Texture="rbxasset://textures/particles/sparkles_main.dds"; sparks.Lifetime=NumberRange.new(0.12,0.28); sparks.Speed=NumberRange.new(3,7); sparks.SpreadAngle=Vector2.new(45,45); sparks.LightEmission=1; sparks.Size=NumberSequence.new(0.18); sparks.Rate=0; sparks.Parent=emitterAt
		local glow={}
		for _,p in ipairs(group:GetChildren()) do if p:IsA("BasePart") and p.Material==Enum.Material.Neon then table.insert(glow,p) end end
		table.insert(wheelData,{motor=motor,origin=origin,front=front,force=force,smoke=smoke,sparks=sparks,emitterAt=emitterAt,glow=glow,spin=0})
		bar("Wishbone",Vector3.new(side*1.4,0.05,z),origin-Vector3.new(0,rest,0),0.13,METAL,suspension)
	end
	local steering=Instance.new("Model"); steering.Name="SteeringWheel"; steering.Parent=model
	local steeringBase=CFrame.new(0,1.95,-1.05)*CFrame.Angles(math.rad(-24),0,0)
	local hub=part("Hub",Vector3.new(0.24,0.24,0.18),steeringBase,BLACK,Enum.Material.Metal,steering,nil,true)
	local steeringMotor=Instance.new("Motor6D"); steeringMotor.Name="SteeringMotor"; steeringMotor.Part0=chassis; steeringMotor.Part1=hub; steeringMotor.C0=steeringBase; steeringMotor.Parent=hub
	ring(steering,steeringBase,0.63,0.12,BLACK,Enum.Material.SmoothPlastic,24,hub)
	for n=1,3 do
		local cf=steeringBase*CFrame.Angles(0,0,n*2*math.pi/3)*CFrame.new(0,-0.3,0)
		local p=part("Spoke",Vector3.new(0.12,0.6,0.10),cf,METAL,Enum.Material.Metal,steering,nil,true)
		local w=Instance.new("WeldConstraint"); w.Part0=hub; w.Part1=p; w.Parent=p
	end
	for _,side in ipairs({-1,1}) do
		local a=Instance.new("Attachment"); a.Name=side&lt;0 and "LeftGrip" or "RightGrip"; a.Position=Vector3.new(side*0.59,0.13,0); a.Parent=hub
	end
	bar("SteeringColumn",Vector3.new(0,0.65,-0.65),Vector3.new(0,1.95,-1.05),0.16,METAL)
	local flames={}
	for _,side in ipairs({-1,1}) do
		local pipe=CFrame.new(side*1.02,1.25,2.42)*CFrame.Angles(math.rad(-28),0,0)
		part("BlackExhaust",Vector3.new(1.26,0.6,0.6),pipe*CFrame.Angles(0,math.pi/2,0),BLACK,Enum.Material.Metal,exhaust,Enum.PartType.Cylinder)
		part("YellowExhaustLip",Vector3.new(0.10,0.65,0.65),pipe*CFrame.new(0,0,0.64)*CFrame.Angles(0,math.pi/2,0),YELLOW,Enum.Material.Metal,exhaust,Enum.PartType.Cylinder)
		part("ExhaustOpening",Vector3.new(0.11,0.46,0.46),pipe*CFrame.new(0,0,0.66)*CFrame.Angles(0,math.pi/2,0),RUBBER,Enum.Material.SmoothPlastic,exhaust,Enum.PartType.Cylinder)
		local at=Instance.new("Attachment"); at.Name="ExhaustOutlet"; at.CFrame=pipe*CFrame.new(0,0,0.74)*CFrame.Angles(0,math.pi,0); at.Parent=chassis
		local flame=Instance.new("ParticleEmitter"); flame.Name="TurboFlame"; flame.Texture="rbxasset://textures/particles/fire_main.dds"; flame.EmissionDirection=Enum.NormalId.Front; flame.Rate=0; flame.Speed=NumberRange.new(12,19); flame.Lifetime=NumberRange.new(0.12,0.22); flame.SpreadAngle=Vector2.new(8,8); flame.LightEmission=1; flame.Color=ColorSequence.new(Color3.fromRGB(255,230,90),Color3.fromRGB(255,70,20)); flame.Size=NumberSequence.new({NumberSequenceKeypoint.new(0,0.65),NumberSequenceKeypoint.new(1,0)}); flame.Parent=at
		local light=Instance.new("PointLight"); light.Color=Color3.fromRGB(255,143,30); light.Range=9; light.Brightness=0; light.Parent=at
		local smoke=Instance.new("ParticleEmitter"); smoke.Name="EngineExhaust"; smoke.Texture="rbxasset://textures/particles/smoke_main.dds"; smoke.Rate=0; smoke.Lifetime=NumberRange.new(0.25,0.45); smoke.Speed=NumberRange.new(2,4); smoke.EmissionDirection=Enum.NormalId.Front; smoke.Size=NumberSequence.new(0.25); smoke.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,0.85),NumberSequenceKeypoint.new(1,1)}); smoke.Parent=at
		table.insert(flames,{emitter=flame,light=light,smoke=smoke})
	end
	local rootAt=Instance.new("Attachment"); rootAt.Name="StabilityAttachment"; rootAt.Parent=chassis
	local torque=Instance.new("Torque"); torque.Name="ArcadeStability"; torque.Attachment0=rootAt; torque.RelativeTo=Enum.ActuatorRelativeTo.World; torque.Parent=attachments
	local driveForce=Instance.new("VectorForce"); driveForce.Name="TireTraction"; driveForce.Attachment0=rootAt; driveForce.RelativeTo=Enum.ActuatorRelativeTo.World; driveForce.ApplyAtCenterOfMass=true; driveForce.Force=Vector3.zero; driveForce.Parent=attachments
	local prompt=Instance.new("ProximityPrompt"); prompt.Name="EnterKart"; prompt.ActionText="Drive"; prompt.ObjectText="Racing Kart"; prompt.KeyboardKeyCode=Enum.KeyCode.E; prompt.MaxActivationDistance=9; prompt.RequiresLineOfSight=false; prompt.Parent=seat
	model:SetAttribute("IsRacingKart",true)
	model:SetAttribute("ColorName","Red")
	-- ScaleTo also scales Attachments, Motor6Ds and their welded children about
	-- the chassis pivot. Metadata returned to the physics controller must agree.
	model:ScaleTo(scale)
	for _,wheel in ipairs(wheelData) do wheel.origin=wheel.origin*scale end
	steeringBase=steeringMotor.C0
	model:SetAttribute("ModelScale",scale)
	return {model=model,chassis=chassis,seat=seat,prompt=prompt,wheels=wheelData,driveForce=driveForce,torque=torque,steering=steeringMotor,steeringBase=steeringBase,hub=hub,flames=flames}
end

return Builder
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXKartSeatLock">
        <Properties>
          <string name="Name">KartSeatLock</string>
          <ProtectedString name="Source">-- Server seat lifecycle. A living driver stays assigned until legitimate cleanup.
-- Dependency injection lets the lifecycle run against deterministic test doubles.
local SeatLock = {}
SeatLock.__index = SeatLock

function SeatLock.new(seat, humanoid, valid, onRelease, scheduler)
	local self=setmetatable({},SeatLock)
	self.seat=seat; self.humanoid=humanoid
	self.valid=valid; self.onRelease=onRelease; self.scheduler=scheduler or task
	self.released=false; self.pending=false
	self.original={power=humanoid.JumpPower,height=humanoid.JumpHeight,
		jumping=humanoid:GetStateEnabled(Enum.HumanoidStateType.Jumping),
		gettingUp=humanoid:GetStateEnabled(Enum.HumanoidStateType.GettingUp)}
	humanoid.JumpPower=0; humanoid.JumpHeight=0
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping,false)
	humanoid:SetStateEnabled(Enum.HumanoidStateType.GettingUp,false)
	local function checkAlive()
		if not self:IsAlive() and not self.released then
			self:Release()
			onRelease()
		end
	end
	self.connections={
		humanoid.Died:Connect(checkAlive),
		humanoid.AncestryChanged:Connect(checkAlive),
		seat.AncestryChanged:Connect(checkAlive),
	}
	return self
end

function SeatLock:IsAlive()
	return not self.released and self.seat.Parent~=nil and self.humanoid.Parent~=nil
		and self.humanoid.Health&gt;0 and self.valid()
end

function SeatLock:Enforce()
	if not self:IsAlive() then return false end
	if self.seat.Occupant==self.humanoid or self.pending then return true end
	self.pending=true
	if self.seat.Occupant then self.seat.Occupant.Sit=false end
	self.scheduler.delay(0.08,function()
		if self:IsAlive() and self.seat.Occupant~=self.humanoid then
			self.humanoid.Jump=false
			self.seat:Sit(self.humanoid)
		end
		self.pending=false
		-- If Sit is temporarily refused by the engine, the next simulation
		-- update retries. No unbounded deferred loop or duplicate driver state.
	end)
	return true
end

function SeatLock:Release()
	if self.released then return end
	self.released=true
	for _,connection in ipairs(self.connections or {}) do connection:Disconnect() end
	local humanoid=self.humanoid
	if humanoid.Parent then
		humanoid.JumpPower=self.original.power; humanoid.JumpHeight=self.original.height
		humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping,self.original.jumping)
		humanoid:SetStateEnabled(Enum.HumanoidStateType.GettingUp,self.original.gettingUp)
	end
end

return SeatLock
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXKartHUD">
        <Properties>
          <string name="Name">KartHUD</string>
          <ProtectedString name="Source">-- Client presentation only. All charge, boost and cooldown decisions are server-owned.
local HUD = {}
HUD.__index = HUD

local INK = Color3.fromRGB(9, 14, 25)
local CYAN = Color3.fromRGB(76, 224, 255)
local AMBER = Color3.fromRGB(255, 190, 63)
local PINK = Color3.fromRGB(227, 103, 255)
local MUTED = Color3.fromRGB(133, 153, 178)
local WHITE = Color3.fromRGB(240, 248, 255)

local function create(class, props, parent)
	local instance = Instance.new(class)
	for key, value in pairs(props) do instance[key] = value end
	instance.Parent = parent
	return instance
end

local function corner(parent, radius)
	create("UICorner", {CornerRadius = UDim.new(0, radius)}, parent)
end

local function text(parent, name, position, size, value, fontSize, color, font)
	return create("TextLabel", {
		Name = name, Position = position, Size = size,
		BackgroundTransparency = 1, BorderSizePixel = 0,
		Text = value, TextColor3 = color, TextSize = fontSize,
		Font = font or Enum.Font.GothamBold,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
	}, parent)
end

function HUD.new(playerGui, config)
	local self = setmetatable({}, HUD)
	self.config = config
	self.progress = 0
	self.speed = 0
	self.viewport = Vector2.zero
	self.gui = create("ScreenGui", {
		Name = "KartHUD", ResetOnSpawn = false, Enabled = false,
		IgnoreGuiInset = false, DisplayOrder = 20, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	}, playerGui)
	local shell = create("Frame", {
		Name = "DriveCluster", AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -28, 1, -28), Size = UDim2.fromOffset(370, 150),
		BackgroundColor3 = INK, BackgroundTransparency = 0.07,
		BorderSizePixel = 0, ClipsDescendants = true,
	}, self.gui)
	self.shell = shell
	corner(shell, 18)
	self.outline = create("UIStroke", {
		Color = Color3.fromRGB(75, 114, 147), Transparency = 0.45, Thickness = 1.2,
	}, shell)
	create("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(29, 46, 68)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(8, 12, 22)),
		}), Rotation = 25,
	}, shell)
	self.scale = create("UIScale", {Scale = 1}, shell)
	self.edge = create("Frame", {
		Name = "AccentEdge", Position = UDim2.fromOffset(0, 18),
		Size = UDim2.fromOffset(3, 114), BorderSizePixel = 0, BackgroundColor3 = CYAN,
	}, shell)
	-- Racing slashes add depth without requiring any uploaded image assets.
	for index = 1, 3 do
		create("Frame", {
			Name = "RacingSlash", Position = UDim2.fromOffset(292 + index * 22, -25),
			Size = UDim2.fromOffset(10, 200), Rotation = 22,
			BorderSizePixel = 0, BackgroundColor3 = CYAN, BackgroundTransparency = 0.95,
		}, shell)
	end
	text(shell, "SpeedCaption", UDim2.fromOffset(20, 13), UDim2.fromOffset(100, 18), "S P E E D", 10, MUTED)
	self.speedText = text(shell, "Speed", UDim2.fromOffset(17, 27), UDim2.fromOffset(111, 79), "000", 64, WHITE, Enum.Font.GothamBlack)
	self.speedBars = {}
	for index = 1, 9 do
		local bar = create("Frame", {
			Name = "SpeedBar", Position = UDim2.fromOffset(22 + (index - 1) * 10, 127 - index * 1.7),
			Size = UDim2.fromOffset(6, 6 + index * 1.7),
			BorderSizePixel = 0, BackgroundColor3 = CYAN, BackgroundTransparency = 0.82,
		}, shell)
		corner(bar, 2)
		self.speedBars[index] = bar
	end
	create("Frame", {
		Name = "Divider", Position = UDim2.fromOffset(135, 22), Size = UDim2.fromOffset(1, 107),
		BorderSizePixel = 0, BackgroundColor3 = Color3.fromRGB(84, 119, 150), BackgroundTransparency = 0.6,
	}, shell)
	text(shell, "BoostCaption", UDim2.fromOffset(153, 15), UDim2.fromOffset(166, 18), "A U T O  T U R B O", 10, MUTED)
	self.status = text(shell, "BoostState", UDim2.fromOffset(153, 37), UDim2.fromOffset(196, 29), "READY", 22, CYAN, Enum.Font.GothamBlack)
	self.timer = text(shell, "BoostTimer", UDim2.fromOffset(153, 68), UDim2.fromOffset(192, 24), "", 19, WHITE)
	self.stateDot = create("Frame", {
		Name = "StateDot", Position = UDim2.fromOffset(338, 20), Size = UDim2.fromOffset(7, 7),
		BackgroundColor3 = CYAN, BorderSizePixel = 0,
	}, shell)
	corner(self.stateDot, 5)
	self.segments = {}
	for index = 1, 16 do
		local track = create("Frame", {
			Name = "ChargeSegment", Position = UDim2.fromOffset(154 + (index - 1) * 12, 104),
			Size = UDim2.fromOffset(8, 12), BackgroundColor3 = Color3.fromRGB(43, 59, 81), BorderSizePixel = 0,
			ClipsDescendants = true,
		}, shell)
		corner(track, 2)
		local fill = create("Frame", {
			Name = "Fill", Size = UDim2.fromScale(0, 1), BackgroundColor3 = CYAN, BorderSizePixel = 0,
		}, track)
		corner(fill, 2)
		self.segments[index] = fill
	end
	self.phaseCaption = text(shell, "PhaseCaption", UDim2.fromOffset(153, 121), UDim2.fromOffset(195, 17), "DRIFT BOOST", 9, MUTED)
	self.lines = {}
	local random = Random.new(17)
	for index = 1, 18 do
		local line = create("Frame", {
			Name = "BoostStreak", BorderSizePixel = 0, BackgroundColor3 = Color3.fromRGB(180, 225, 255),
			AnchorPoint = Vector2.new(0.5, 0.5), Visible = false,
		}, self.gui)
		self.lines[index] = {frame = line, angle = index * 2 * math.pi / 18, phase = random:NextNumber()}
	end
	return self
end

function HUD:SetVisible(visible)
	self.gui.Enabled = visible
	if visible then self.progress = 0; self.speed = 0 end
end

function HUD:Update(model, actualSpeed, dt, now, viewport, touch)
	if viewport ~= self.viewport or touch ~= self.touch then
		self.viewport = viewport
		self.touch = touch
		if touch then
			self.shell.AnchorPoint = Vector2.new(0.5, 0)
			self.shell.Position = UDim2.new(0.5, 0, 0, 14)
		else
			self.shell.AnchorPoint = Vector2.new(1, 1)
			self.shell.Position = UDim2.new(1, -28, 1, -28)
		end
		self.scale.Scale = math.clamp(math.min(viewport.X / 650, viewport.Y / 600), 0.62, 1)
	end
	self.speed += (actualSpeed - self.speed) * (1 - math.exp(-dt * 10))
	self.speedText.Text = string.format("%03d", math.floor(math.max(self.speed, 0) + 0.5))
	local ratio = math.clamp(self.speed / (self.config.MaxSpeed + self.config.TurboPower), 0, 1)
	for index, bar in ipairs(self.speedBars) do bar.BackgroundTransparency = ratio &gt;= index / 9 and 0.05 or 0.82 end

	local charge = math.clamp(model:GetAttribute("DriftCharge") or 0, 0, 1)
	local boosting = model:GetAttribute("Boosting") == true
	local boostEnd = model:GetAttribute("BoostEnd") or 0
	local cooldownEnd = model:GetAttribute("TurboCooldownEnd") or 0
	local remaining = math.max(cooldownEnd - now, 0)
	local color, target, status, timer, caption
	if boosting then
		color, target, status = PINK, math.clamp((boostEnd - now) / self.config.TurboDuration, 0, 1), "TURBO"
		timer, caption = string.format("%.1fs", math.max(boostEnd - now, 0)), "DRIFT BOOST ACTIVE"
	elseif remaining &gt; 0 or model:GetAttribute("DriftReady") ~= true then
		color, target, status = CYAN, 1 - math.clamp(remaining / self.config.TurboCooldown, 0, 1), "RECHARGING"
		timer, caption = remaining &gt; 0 and string.format("%.1fs", remaining) or "…", "TURBO RECOVERY"
	elseif charge &gt; 0 then
		color, target, status = CYAN:Lerp(AMBER, charge), charge, "CHARGING"
		timer, caption = string.format("%.1fs", math.max(self.config.DriftChargeTime * (1 - charge), 0)), "DRIFT CHARGE"
	else
		color, target, status, timer, caption = CYAN, 1, "READY", "", "DRIFT BOOST"
	end
	-- Follow authoritative progress; never predict charge completion or readiness.
	if self.lastState ~= status then
		self.progress = status == "CHARGING" and 0 or target
		self.lastState = status
	end
	self.progress += (target - self.progress) * (1 - math.exp(-dt * 18))
	self.status.Text, self.status.TextColor3 = status, color
	self.timer.Text, self.phaseCaption.Text = timer, caption
	self.edge.BackgroundColor3, self.stateDot.BackgroundColor3 = color, color
	self.outline.Color = color:Lerp(Color3.fromRGB(75, 114, 147), 0.55)
	local pulse = boosting and (0.5 + 0.5 * math.sin(now * 13)) or 0
	self.outline.Transparency = 0.5 - pulse * 0.3
	for index, fill in ipairs(self.segments) do
		fill.Size = UDim2.fromScale(math.clamp(self.progress * 16 - (index - 1), 0, 1), 1)
		fill.BackgroundColor3 = color
	end
	for _, line in ipairs(self.lines) do
		line.frame.Visible = boosting and actualSpeed &gt; self.config.MaxSpeed
		if line.frame.Visible then
			line.phase = (line.phase + dt * 1.5) % 1
			local radius = 0.36 + line.phase * 0.25
			line.frame.Position = UDim2.fromScale(0.5 + math.cos(line.angle) * radius, 0.5 + math.sin(line.angle) * radius)
			line.frame.Size = UDim2.fromOffset(18 + line.phase * 65, 2)
			line.frame.Rotation = math.deg(line.angle)
			line.frame.BackgroundTransparency = 0.65 + line.phase * 0.3
		end
	end
end

return HUD
</ProtectedString>
        </Properties>
      </Item>
    </Item>
    <Item class="Script" referent="RBXKartServer">
      <Properties>
        <string name="Name">KartServer</string>
        <ProtectedString name="Source">local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local System = ReplicatedStorage:WaitForChild("KartSystem")
local Config = require(System.KartConfig)
local Dynamics = require(System.KartDynamics)
local Builder = require(System.KartBuilder)
local SeatLock = require(System.KartSeatLock)

local remotes = Instance.new("Folder"); remotes.Name="Remotes"; remotes.Parent=System
local input = Instance.new("RemoteEvent"); input.Name="Input"; input.Parent=remotes
local states = {}
local playerStates = {}
local rates = {}
local chargeColors = {Color3.fromRGB(70,190,255),Color3.fromRGB(255,165,45)}
local world = workspace:FindFirstChild("RacingKarts") or Instance.new("Folder")
world.Name="RacingKarts"; world.Parent=workspace

local function restoreDriver(s)
	if s.restoring then return end
	s.restoring=true
	local previousHumanoid=s.humanoid
	if s.seatLock then s.seatLock:Release(); s.seatLock=nil end
	for part,original in pairs(s.driverMass or {}) do if part.Parent then part.Massless=original end end
	s.driverMass={}
	if s.driverStateConnection then s.driverStateConnection:Disconnect(); s.driverStateConnection=nil end
	for part,original in pairs(s.driverCollisions or {}) do if part.Parent then part.CanCollide=original end end
	s.driverCollisions={}
	if s.driverCollision then s.driverCollision:Destroy(); s.driverCollision=nil end
	for _,ik in ipairs(s.iks or {}) do ik:Destroy() end
	s.iks={}
	if s.waist and s.waist.Parent then s.waist.C0=s.waistBase end
	s.waist=nil
	s.humanoid=nil
	if s.player then playerStates[s.player]=nil end
	s.player=nil; s.throttle=0; s.steer=0; s.drift=false
	s.charge=0; s.boostEnd=0; s.boostPower=0
	-- Cooldown is retained across character replacement/cleanup.
	s.model:SetAttribute("DriverUserId",0)
	s.model:SetAttribute("DriverLocked",false)
	s.prompt.Enabled=true
	-- Legitimate cleanup must detach living replaced/removed characters too.
	-- The Occupant listener is suppressed until this assignment is fully clear.
	if previousHumanoid and previousHumanoid.Parent then previousHumanoid.Sit=false end
	s.restoring=false
end

local function attachDriver(s)
	restoreDriver(s)
	local humanoid=s.seat.Occupant
	if not humanoid then return end
	local player=Players:GetPlayerFromCharacter(humanoid.Parent)
	if not player or humanoid.Health&lt;=0 or playerStates[player] then humanoid.Sit=false; return end
	s.player=player; playerStates[player]=s; s.humanoid=humanoid
	s.seatLock=SeatLock.new(s.seat,humanoid,function()
		return s.player==player and player.Parent==Players and player.Character==humanoid.Parent
			and humanoid:IsDescendantOf(workspace) and s.model:IsDescendantOf(workspace)
	end,function() if s.humanoid==humanoid then restoreDriver(s) end end)
	s.model:SetAttribute("DriverJumpingBeforeLock",s.seatLock.original.jumping)
	s.model:SetAttribute("DriverGettingUpBeforeLock",s.seatLock.original.gettingUp)
	s.prompt.Enabled=false; s.lastInput=workspace:GetServerTimeNow()
	s.chassis.Anchored=false
	s.chassis:SetNetworkOwner(nil) -- authoritative forces, boosts and speed caps
	-- An animated driver's limbs must not shift the physics assembly's COM or
	-- collide with its hull. Restore every original Massless flag on departure.
	s.driverMass={}
	s.driverCollisions={}
	s.driverCollision=Instance.new("Folder"); s.driverCollision.Name="DriverCollisionOverrides"; s.driverCollision.Parent=s.model
	local hulls={s.chassis}
	for _,part in ipairs(s.model.Suspension:GetChildren()) do
		if part:IsA("BasePart") and part.CanCollide then table.insert(hulls,part) end
	end
	for _,part in ipairs(humanoid.Parent:GetDescendants()) do
		if part:IsA("BasePart") then
			s.driverMass[part]=part.Massless; part.Massless=true
			s.driverCollisions[part]=part.CanCollide; part.CanCollide=false
			for _,hull in ipairs(hulls) do
				local constraint=Instance.new("NoCollisionConstraint"); constraint.Part0=part; constraint.Part1=hull; constraint.Parent=s.driverCollision
			end
		end
	end
	s.driverStateConnection=humanoid.StateChanged:Connect(function()
		-- Shorter body clearance must not let seated feet push against the road.
		-- Vehicle collision hulls remain enabled; avatar settings restore on cleanup.
		if s.humanoid==humanoid then
			for part in pairs(s.driverCollisions) do if part.Parent then part.CanCollide=false end end
		end
	end)
	s.model:SetAttribute("DriverUserId",player.UserId)
	if humanoid.RigType==Enum.HumanoidRigType.R15 then
		for _,side in ipairs({"Left","Right"}) do
			local upper=humanoid.Parent:FindFirstChild(side.."UpperArm")
			local hand=humanoid.Parent:FindFirstChild(side.."Hand")
			if upper and hand then
				local ik=Instance.new("IKControl"); ik.Name="Kart"..side.."Grip"
				ik.Type=Enum.IKControlType.Position; ik.ChainRoot=upper; ik.EndEffector=hand
				ik.Target=s.hub:FindFirstChild(side.."Grip"); ik.Weight=1; ik.SmoothTime=0.08; ik.Priority=10; ik.Parent=humanoid
				table.insert(s.iks,ik)
			end
		end
		local upperTorso=humanoid.Parent:FindFirstChild("UpperTorso")
		local waist=upperTorso and upperTorso:FindFirstChild("Waist")
		if waist and waist:IsA("Motor6D") then s.waist=waist; s.waistBase=waist.C0 end
	end
end

local function spawnKart(cf, colorName)
	local s=Builder.build("RacingKart",cf,Config.Palette[colorName] or Config.Palette.Red)
	s.model:SetAttribute("ColorName",colorName)
	s.model.Parent=world
	CollectionService:AddTag(s.model,"RacingKart")
	s.spawn=cf; s.throttle=0; s.steer=0; s.visualSteer=0; s.drift=false
	s.lastInput=0; s.charge=0; s.boostEnd=0; s.boostPower=0; s.cooldown=0
	s.visualClock=0; s.iks={}; s.emptyTime=0
	s.filteredSteer=0; s.filteredThrottle=0; s.driftBlend=0; s.normal=Vector3.yAxis; s.driveAccel=0
	s.params=RaycastParams.new(); s.params.FilterType=Enum.RaycastFilterType.Exclude
	s.params.RespectCanCollide=true
	s.chassis:SetNetworkOwner(nil)
	s.prompt.Triggered:Connect(function(player)
		local humanoid=player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if not humanoid or humanoid.Health&lt;=0 or not root or playerStates[player] or s.seat.Occupant or s.reserved then return end
		if (root.Position-s.seat.Position).Magnitude&gt;11 then return end
		s.reserved=true; s.prompt.Enabled=false
		s.seat:Sit(humanoid)
		task.delay(1,function()
			s.reserved=false
			if s.model.Parent and not s.seat.Occupant then s.prompt.Enabled=true end
		end)
	end)
	s.seat:GetPropertyChangedSignal("Occupant"):Connect(function()
		if s.restoring then return end
		if s.seatLock and s.seatLock:Enforce() then return end
		attachDriver(s)
	end)
	table.insert(states,s)
end

local markers=workspace:FindFirstChild("KartSpawns")
if markers then
	for _,marker in ipairs(markers:GetChildren()) do
		if marker:IsA("BasePart") then
			marker.CanCollide=false; marker.CanTouch=false; marker.CanQuery=false; marker.Transparency=1
			spawnKart(marker.CFrame,marker:GetAttribute("ColorName") or "Red")
		end
	end
end
if #states==0 then spawnKart(Config.SpawnCFrame,"Red") end

input.OnServerEvent:Connect(function(player, throttle, steer, drift, ...)
	local now=workspace:GetServerTimeNow()
	local rate=rates[player]
	if not rate or now-rate.time&gt;=1 then rate={time=now,count=0}; rates[player]=rate end
	rate.count+=1
	if rate.count&gt;Config.InputRate+15 then return end
	local s=playerStates[player]
	if not s or s.seat.Occupant~=s.humanoid or s.humanoid.Health&lt;=0 then return end
	if select("#",...)~=0 or not Dynamics.finite(throttle) or not Dynamics.finite(steer) or type(drift)~="boolean" then return end
	s.lastInput=now
	s.throttle=math.clamp(throttle,-1,1); s.steer=math.clamp(steer,-1,1)
	s.drift=drift
end)

Players.PlayerRemoving:Connect(function(player)
	local s=playerStates[player]
	if s then restoreDriver(s) end
	rates[player]=nil
end)

RunService.PreSimulation:Connect(function(delta)
	local dt=math.min(delta,1/15)
	local now=workspace:GetServerTimeNow()
	local characters={}
	for _,player in ipairs(Players:GetPlayers()) do
		if player.Character then table.insert(characters,player.Character) end
	end
	for index=#states,1,-1 do
		local s=states[index]
		if not s.model:IsDescendantOf(workspace) or not s.chassis:IsDescendantOf(workspace)
			or not s.seat:IsDescendantOf(workspace) then
			restoreDriver(s); table.remove(states,index); continue
		end
		local root=s.chassis
		if s.seatLock then
			if not s.seatLock:Enforce() then restoreDriver(s) end
		end
		if root.Position.Y&lt;workspace.FallenPartsDestroyHeight+30 then
			-- Recover the seated assembly without unlocking a living driver.
			local character=s.player and s.player.Character
			local relative=character and root.CFrame:ToObjectSpace(character:GetPivot())
			root.Anchored=false; s.model:PivotTo(s.spawn)
			if character and relative then character:PivotTo(s.spawn*relative) end
			root.AssemblyLinearVelocity=Vector3.zero; root.AssemblyAngularVelocity=Vector3.zero
			s.charge=0; s.boostEnd=0; s.boostPower=0
		end
		if s.player and now-s.lastInput&gt;Config.InputTimeout then
			s.throttle=0; s.steer=0; s.drift=false; s.charge=0
		end
		local exclusions={s.model,table.unpack(characters)}
		s.params.FilterDescendantsInstances=exclusions
		local mass=root.AssemblyMass
		if root.Anchored then mass=root:GetMass() end
		local cf=root.CFrame
		local velocity=root.AssemblyLinearVelocity
		local speed=velocity:Dot(cf.LookVector)
		local contacts={}; local groundNormal=Vector3.zero
		for _,wheel in ipairs(s.wheels) do
			local mount=cf:PointToWorldSpace(wheel.origin)
			local ray=workspace:Raycast(mount,-cf.UpVector*(Config.WheelRadius+Config.SuspensionRest+Config.SuspensionTravel),s.params)
			wheel.distance=Config.SuspensionRest+Config.SuspensionTravel
			wheel.force.Force=Vector3.zero
			if ray and ray.Normal.Y&gt;0.15 then
				wheel.distance=math.max(-0.2,ray.Distance-Config.WheelRadius)
				local compression=Config.SuspensionRest-wheel.distance
				-- Include moving ground velocity so platforms do not kick the springs.
				local groundVelocity=Vector3.zero
				if ray.Instance:IsA("BasePart") then groundVelocity=ray.Instance:GetVelocityAtPosition(ray.Position) end
				-- Damp heave here, not angular point velocity: four full-strength
				-- corner dampers massively overdamp the low-inertia chassis roll.
				-- Pitch/roll receive a separate inertia-scaled angular damper below.
				local vertical=(velocity-groundVelocity):Dot(cf.UpVector)
				local support=Dynamics.suspension(compression,vertical,workspace.Gravity,Config)*mass/4
				wheel.force.Force=cf.UpVector*support
				table.insert(contacts,wheel); groundNormal+=ray.Normal
			end
		end
		local grounded=#contacts&gt;=2
		local drifting,boost=Dynamics.updateBoost(s,now,dt,grounded,speed,Config)
		s.filteredSteer=Dynamics.approach(s.filteredSteer,s.player and s.steer or 0,Config.SteerResponse,dt)
		s.filteredThrottle=Dynamics.approach(s.filteredThrottle,s.player and s.throttle or 0,Config.ThrottleResponse,dt)
		if math.abs(s.filteredThrottle)&lt;0.001 then s.filteredThrottle=0 end
		s.driftBlend=Dynamics.approach(s.driftBlend,drifting and 1 or 0,drifting and Config.DriftEnterResponse or Config.DriftExitResponse,dt)
		local steerAngle,desiredYaw=Dynamics.steering(speed,s.filteredSteer,s.driftBlend,Config)
		local targetNormal=grounded and groundNormal.Unit or s.normal
		s.normal=s.normal:Lerp(targetNormal,1-math.exp(-dt*Config.NormalResponse)).Unit
		local normal=s.normal
		local forward=cf.LookVector-normal*cf.LookVector:Dot(normal)
		if forward.Magnitude&gt;0.01 then forward=forward.Unit else forward=cf.LookVector end
		local right=forward:Cross(normal).Unit
		-- Tire traction acts once at the COM. It no longer injects a second yaw
		-- controller at the axles or rolls the chassis by acting above its COM.
		local sideAccel=Dynamics.lateral(speed,velocity:Dot(right),s.filteredSteer,s.driftBlend,Config)
		local drive=Dynamics.longitudinal(speed,s.filteredThrottle,boost,Config)
		if not s.player then drive=math.clamp(-speed*10,-80,80) end
		s.driveAccel=Dynamics.approach(s.driveAccel,drive,10,dt)
		s.driveForce.Force=grounded and (forward*s.driveAccel+right*sideAccel)*mass*(#contacts/4) or Vector3.zero
		if grounded then
			local angular=root.AssemblyAngularVelocity
			local tilt=cf.UpVector:Cross(normal)
			local inertia=mass*(root.Size.X^2+root.Size.Z^2)/12
			local pitchInertia=mass*(root.Size.Y^2+root.Size.Z^2)/12
			local rollInertia=mass*(root.Size.X^2+root.Size.Y^2)/12
			local yawAccel=math.clamp((desiredYaw-angular:Dot(normal))*Config.YawResponse,-Config.MaxYawAcceleration,Config.MaxYawAcceleration)
			-- Springs handle contact roll/pitch; this bounded damper suppresses
			-- excess tilt instead of repeatedly forcing a new orientation.
			local angularDamping=cf.RightVector*angular:Dot(cf.RightVector)*pitchInertia*26
				+cf.LookVector*angular:Dot(cf.LookVector)*rollInertia*26
			s.torque.Torque=tilt*10*inertia-angularDamping+normal*yawAccel*inertia
		else s.torque.Torque=-root.AssemblyAngularVelocity*mass*0.8 end
		-- Empty vehicles settle before anchoring, then remain parked even on slopes.
		if not s.player then
			s.emptyTime+=dt
			if grounded and (velocity.Magnitude&lt;1 or s.emptyTime&gt;2) then
				root.AssemblyLinearVelocity=Vector3.zero; root.AssemblyAngularVelocity=Vector3.zero; root.Anchored=true
			end
		else
			s.emptyTime=0
			local hardLimit=Config.MaxSpeed+Config.TurboPower+15
			local horizontal=Vector3.new(velocity.X,0,velocity.Z)
			if horizontal.Magnitude&gt;hardLimit then
				local capped=horizontal.Unit*hardLimit
				root.AssemblyLinearVelocity=Vector3.new(capped.X,velocity.Y,capped.Z)
			end
		end
		s.visualSteer=steerAngle
		s.visualClock+=delta
		if s.visualClock&gt;=1/20 then
			s.visualClock=0
			local charge=math.clamp(s.charge/Config.DriftChargeTime,0,1)
			for _,wheel in ipairs(s.wheels) do
				wheel.motor:SetAttribute("SuspensionDistance",wheel.distance)
				wheel.emitterAt.Position=wheel.origin-Vector3.new(0,wheel.distance+Config.WheelRadius,0)
				wheel.smoke.Rate=drifting and not wheel.front and 12 or 0
				wheel.sparks.Rate=drifting and not wheel.front and (5+charge*15) or 0
				wheel.sparks.Color=ColorSequence.new(chargeColors[1]:Lerp(chargeColors[2],charge))
			end
			s.model:SetAttribute("SteerAngle",s.visualSteer)
			s.model:SetAttribute("DriftBlend",s.driftBlend)
			if s.waist then s.waist.C0=s.waistBase*CFrame.Angles(0,0,-s.visualSteer*0.16) end
			for _,flame in ipairs(s.flames) do flame.emitter.Rate=boost&gt;0 and 35 or 0; flame.light.Brightness=boost&gt;0 and 2 or 0; flame.smoke.Rate=s.player and s.filteredThrottle&gt;0.1 and 3 or 0 end
			for _,light in ipairs(s.model.Effects:GetChildren()) do
				if light.Name=="BrakeLight" and light:IsA("BasePart") then
					local braking=s.throttle&lt;0 and speed&gt;2
					light.Material=braking and Enum.Material.Neon or Enum.Material.SmoothPlastic
					light.Color=braking and Color3.fromRGB(255,30,35) or Color3.fromRGB(110,5,10)
				end
			end
			s.model:SetAttribute("Speed",math.abs(speed)); s.model:SetAttribute("Boosting",boost&gt;0)
			s.model:SetAttribute("DriftCharge",charge)
			s.model:SetAttribute("BoostEnd",s.boostEnd)
			s.model:SetAttribute("TurboCooldownEnd",s.cooldown)
			s.model:SetAttribute("TurboCooldownRemaining",math.max(0,s.cooldown-now))
			s.model:SetAttribute("DriftReady",now&gt;=s.cooldown and boost==0)
			s.model:SetAttribute("DriverLocked",s.seatLock~=nil)
		end
	end
end)
</ProtectedString>
        <bool name="Disabled">true</bool>
      </Properties>
    </Item>
    <Item class="LocalScript" referent="RBXKartController">
      <Properties>
        <string name="Name">KartController</string>
        <ProtectedString name="Source">local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local RunService=game:GetService("RunService")
local ContextActionService=game:GetService("ContextActionService")
local UserInputService=game:GetService("UserInputService")
local CollectionService=game:GetService("CollectionService")
local player=Players.LocalPlayer
local input=ReplicatedStorage:WaitForChild("KartSystem"):WaitForChild("Remotes"):WaitForChild("Input")
local active,seat,root
local throttle,steer=0,0
local drift=false
local held={}
local analog=Vector2.zero
local clock=0
local Config=require(ReplicatedStorage:WaitForChild("KartSystem"):WaitForChild("KartConfig"))
local Dynamics=require(ReplicatedStorage.KartSystem:WaitForChild("KartDynamics"))
local presentations={}
local cameraFocus,cameraHeading
local cameraCF
local previousCamera
local previousJump
local previousZoom
local HUD=require(ReplicatedStorage.KartSystem:WaitForChild("KartHUD"))
local hud=HUD.new(player:WaitForChild("PlayerGui"),Config)
local previousStates
local seatedHumanoid
local originalStates=setmetatable({},{__mode="k"})
local lockedStates={Enum.HumanoidStateType.Jumping,Enum.HumanoidStateType.GettingUp}

-- Capture local defaults before entering; do not sample a state already locked
-- by another part of the seating lifecycle and later restore that false value.
local function rememberCharacter(character)
	local humanoid=character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid",10)
	if humanoid and not originalStates[humanoid] then
		local states={}
		for _,state in ipairs(lockedStates) do states[state]=humanoid:GetStateEnabled(state) end
		originalStates[humanoid]=states
	end
end
player.CharacterAdded:Connect(rememberCharacter)
if player.Character then rememberCharacter(player.Character) end

local function send()
	if active then input:FireServer(throttle,steer,drift) end
end

local function action(name,state,obj)
	if UserInputService:GetFocusedTextBox() then
		held={}; analog=Vector2.zero; throttle=0; steer=0; drift=false; send()
		return Enum.ContextActionResult.Pass
	end
	if name=="KartBlockExitJump" then return Enum.ContextActionResult.Sink end
	local down=state==Enum.UserInputState.Begin or state==Enum.UserInputState.Change
	if state==Enum.UserInputState.Cancel then down=false end
	if name=="KartThumbstick" then
		analog=down and Vector2.new(obj.Position.X,obj.Position.Y) or Vector2.zero

	else held[name..":"..obj.KeyCode.Name]=down end
	local function pressed(actionName)
		for key,value in pairs(held) do if value and key:sub(1,#actionName+1)==actionName..":" then return true end end
		return false
	end
	throttle=(pressed("KartForward") and 1 or 0)-(pressed("KartReverse") and 1 or 0)
	steer=(pressed("KartRight") and 1 or 0)-(pressed("KartLeft") and 1 or 0)
	if math.abs(analog.Y)&gt;0.15 then throttle=analog.Y end
	if math.abs(analog.X)&gt;0.15 then steer=analog.X end
	drift=pressed("KartDrift")
	return Enum.ContextActionResult.Sink
end

local bindings={
	{"KartForward","Gas",Enum.KeyCode.W,Enum.KeyCode.Up,Enum.KeyCode.ButtonR2},
	{"KartReverse","Brake",Enum.KeyCode.S,Enum.KeyCode.Down,Enum.KeyCode.ButtonL2},
	{"KartLeft","Left",Enum.KeyCode.A,Enum.KeyCode.Left},
	{"KartRight","Right",Enum.KeyCode.D,Enum.KeyCode.Right},
	{"KartDrift","DRIFT",Enum.KeyCode.LeftShift,Enum.KeyCode.RightShift,Enum.KeyCode.ButtonA,Enum.KeyCode.ButtonX},
	{"KartBlockExitJump","",Enum.KeyCode.Space,Enum.KeyCode.E,Enum.KeyCode.F,Enum.KeyCode.ButtonB},
}

local function stop()
	if not active then return end
	throttle=0; steer=0; drift=false; send()
	for _,binding in ipairs(bindings) do ContextActionService:UnbindAction(binding[1]) end
	ContextActionService:UnbindAction("KartThumbstick")
	if seatedHumanoid and seatedHumanoid.Parent and previousStates then
		for state,enabled in pairs(previousStates) do seatedHumanoid:SetStateEnabled(state,enabled) end
	end
	seatedHumanoid=nil; previousStates=nil
	if previousJump~=nil then player.AutoJumpEnabled=previousJump end
	if previousZoom then player.CameraMinZoomDistance=previousZoom[1]; player.CameraMaxZoomDistance=previousZoom[2] end
	local camera=workspace.CurrentCamera
	if camera and previousCamera then
		camera.CameraType=previousCamera.kind
		camera.CameraSubject=previousCamera.subject
		camera.FieldOfView=previousCamera.fov
	end
	active=nil; seat=nil; root=nil; cameraCF=nil; cameraFocus=nil; cameraHeading=nil; hud:SetVisible(false)
	held={}; analog=Vector2.zero
end

local function start(model)
	if active==model then return end
	stop()
	local driverSeat=model:FindFirstChild("DriverSeat")
	local chassis=model:FindFirstChild("Chassis")
	if not driverSeat or not chassis then return end
	active=model; seat=driverSeat; root=chassis
	local camera=workspace.CurrentCamera
	if not camera then stop(); return end
	previousCamera={kind=camera.CameraType,subject=camera.CameraSubject,fov=camera.FieldOfView}
	previousJump=player.AutoJumpEnabled; player.AutoJumpEnabled=false
	previousZoom={player.CameraMinZoomDistance,player.CameraMaxZoomDistance}
	camera.CameraType=Enum.CameraType.Scriptable
	seatedHumanoid=player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	previousStates={}
	if seatedHumanoid then
		for _,state in ipairs(lockedStates) do
			local original=originalStates[seatedHumanoid]
			local attribute=state==Enum.HumanoidStateType.Jumping and "DriverJumpingBeforeLock" or "DriverGettingUpBeforeLock"
			local beforeLock=model:GetAttribute(attribute)
			if type(beforeLock)=="boolean" then previousStates[state]=beforeLock
			else previousStates[state]=original and original[state] end
			if previousStates[state]==nil then previousStates[state]=seatedHumanoid:GetStateEnabled(state) end
			seatedHumanoid:SetStateEnabled(state,false)
		end
		seatedHumanoid.Jump=false
	end
	for index,binding in ipairs(bindings) do
		local keys={table.unpack(binding,3)}
		local touch=binding[1]~="KartBlockExitJump"
		ContextActionService:BindActionAtPriority(binding[1],action,touch,5000,table.unpack(keys))
		if touch then
			ContextActionService:SetTitle(binding[1],binding[2])
			local positions={UDim2.new(1,-88,1,-166),UDim2.new(1,-170,1,-100),UDim2.new(0,45,1,-130),UDim2.new(0,133,1,-130),UDim2.new(1,-88,1,-82)}
			ContextActionService:SetPosition(binding[1],positions[index])
			local button=ContextActionService:GetButton(binding[1])
			if button then
				button.ImageColor3=binding[1]=="KartDrift" and Color3.fromRGB(76,224,255) or Color3.fromRGB(38,57,83)
				button.ImageTransparency=0.12
			end
		end
	end
	ContextActionService:BindActionAtPriority("KartThumbstick",action,false,5000,Enum.KeyCode.Thumbstick1)
	hud:SetVisible(true); clock=1
end

local function prepareVisuals(model)
	if presentations[model] then return end
	local chassis=model:FindFirstChild("Chassis")
	local wheels=model:FindFirstChild("Wheels")
	local steering=model:FindFirstChild("SteeringWheel")
	if not chassis or not wheels or not steering then return end
	local hub=steering:FindFirstChild("Hub")
	local motor=hub and hub:FindFirstChild("SteeringMotor")
	if not motor then return end
	local state={root=chassis,wheels={},steering=motor,base=motor.C0,angle=0}
	for _,wheel in ipairs(wheels:GetChildren()) do
		local tire=wheel:FindFirstChild("Tire")
		local wheelMotor=tire and tire:FindFirstChild("WheelMotor")
		if wheelMotor then
			table.insert(state.wheels,{motor=wheelMotor,origin=wheelMotor.C0.Position+Vector3.new(0,Config.SuspensionRest,0),distance=Config.SuspensionRest,spin=0,speed=0,front=wheel.Name:sub(1,5)=="Front"})
		end
	end
	presentations[model]=state
end

-- Every observer animates the same replicated assembly locally at render rate.
-- Motors are visual only; no client writes physics velocity or position.
RunService:BindToRenderStep("KartVisuals",Enum.RenderPriority.Character.Value+1,function(dt)
	for model,state in pairs(presentations) do
		if not model:IsDescendantOf(workspace) or not state.root:IsDescendantOf(workspace) then presentations[model]=nil; continue end
		state.angle=Dynamics.approach(state.angle,model:GetAttribute("SteerAngle") or 0,18,dt)
		for _,wheel in ipairs(state.wheels) do
			local target=wheel.motor:GetAttribute("SuspensionDistance") or Config.SuspensionRest
			local response=target&lt;wheel.distance and Config.VisualSuspensionResponse*2 or Config.VisualSuspensionResponse
			wheel.distance=Dynamics.approach(wheel.distance,target,response,dt)
			local direction=(state.root.CFrame*CFrame.Angles(0,wheel.front and state.angle or 0,0)).LookVector
			local pv=state.root:GetVelocityAtPosition(state.root.CFrame:PointToWorldSpace(wheel.origin))
			wheel.speed=Dynamics.approach(wheel.speed,pv:Dot(direction),16,dt)
			wheel.spin=(wheel.spin-wheel.speed/Config.WheelRadius*dt)%(math.pi*2)
			wheel.motor.C0=CFrame.new(wheel.origin-Vector3.new(0,wheel.distance,0))*CFrame.Angles(0,wheel.front and state.angle or 0,0)*CFrame.Angles(wheel.spin,0,0)
		end
		state.steering.C0=state.base*CFrame.Angles(0,0,state.angle*1.8)
	end
end)

local function watch(model)
	prepareVisuals(model)
	local function changed()
		prepareVisuals(model)
		if model:GetAttribute("DriverUserId")==player.UserId then start(model)
		elseif active==model then stop() end
	end
	model:GetAttributeChangedSignal("DriverUserId"):Connect(changed)
	model.AncestryChanged:Connect(function() if active==model and not model:IsDescendantOf(workspace) then stop() end end)
	changed()
end
for _,model in ipairs(CollectionService:GetTagged("RacingKart")) do watch(model) end
CollectionService:GetInstanceAddedSignal("RacingKart"):Connect(watch)
player.CharacterRemoving:Connect(stop)
UserInputService.WindowFocusReleased:Connect(function()
	held={}; analog=Vector2.zero; throttle=0; steer=0; drift=false; send()
end)
UserInputService.TextBoxFocused:Connect(function()
	held={}; analog=Vector2.zero; throttle=0; steer=0; drift=false; send()
end)

UserInputService.JumpRequest:Connect(function()
	if active and seatedHumanoid then seatedHumanoid.Jump=false end
end)

local rayParams=RaycastParams.new(); rayParams.FilterType=Enum.RaycastFilterType.Exclude; rayParams.RespectCanCollide=true
RunService:BindToRenderStep("KartCamera",Enum.RenderPriority.Camera.Value+1,function(dt)
	if not active or not root then return end
	if not root:IsDescendantOf(workspace) then stop(); return end
	clock+=dt
	if clock&gt;=1/30 then clock=0; send() end
	local camera=workspace.CurrentCamera
	if not camera then return end
	local cf=root.CFrame
	local speed=active:GetAttribute("Speed") or 0
	local boosting=active:GetAttribute("Boosting") or false
	local flat=Vector3.new(cf.LookVector.X,0,cf.LookVector.Z)
	if flat.Magnitude&lt;0.01 then flat=Vector3.new(0,0,-1) else flat=flat.Unit end
	local motion=Vector3.new(root.AssemblyLinearVelocity.X,0,root.AssemblyLinearVelocity.Z)
	local blend=active:GetAttribute("DriftBlend") or 0
	if motion.Magnitude&gt;10 and motion.Unit:Dot(flat)&gt;0.3 then flat=flat:Lerp(motion.Unit,blend*0.3).Unit end
	cameraHeading=cameraHeading and cameraHeading:Lerp(flat,1-math.exp(-dt*Config.CameraHeadingResponse)).Unit or flat
	-- Compensate the horizontal filter's steady-speed lag; otherwise stacking
	-- position and CFrame filters makes the kart outrun its camera at high speed.
	local targetFocus=root.Position+Vector3.new(0,1.7,0)+motion/Config.CameraPositionResponse
	if cameraFocus then
		local planar=1-math.exp(-dt*Config.CameraPositionResponse)
		local vertical=1-math.exp(-dt*Config.CameraHeightResponse)
		cameraFocus=Vector3.new(cameraFocus.X+(targetFocus.X-cameraFocus.X)*planar,cameraFocus.Y+(targetFocus.Y-cameraFocus.Y)*vertical,cameraFocus.Z+(targetFocus.Z-cameraFocus.Z)*planar)
	else cameraFocus=targetFocus end
	local scale=Config.ModelScale
	local focus=cameraFocus+cameraHeading*(1.5*scale)
	local desired=focus-cameraHeading*((11+math.min(speed/40,2))*scale)+Vector3.new(0,4.5*scale,0)
	rayParams.FilterDescendantsInstances={active,player.Character}
	local hit=workspace:Raycast(focus,desired-focus,rayParams)
	if hit then desired=hit.Position+hit.Normal*0.6 end
	local desiredCF=CFrame.lookAt(desired,focus)
	cameraCF=desiredCF -- focus and heading have already been independently filtered
	camera.CFrame=cameraCF -- no procedural shake, including drift and turbo
	local targetFov=70+math.clamp(speed/100,0,1)*12+(boosting and 5 or 0)
	camera.FieldOfView+=(targetFov-camera.FieldOfView)*(1-math.exp(-dt*5))
	hud:Update(active,speed,dt,workspace:GetServerTimeNow(),camera.ViewportSize,UserInputService.TouchEnabled)
end)
</ProtectedString>
        <bool name="Disabled">true</bool>
      </Properties>
    </Item>
  </Item>
</roblox>