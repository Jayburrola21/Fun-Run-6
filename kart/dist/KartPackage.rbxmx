<?xml version='1.0' encoding='utf-8'?>
<roblox version="4">
  <Item class="Folder" referent="RBX1">
    <Properties>
      <string name="Name">KartPackage</string>
    </Properties>
    <Item class="Folder" referent="RBX2">
