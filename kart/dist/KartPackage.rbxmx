      <Item class="ModuleScript" referent="RBX3">
        <Properties>
          <string name="Name">KartConfig</string>
          <ProtectedString name="Source">-- Distances in studs, speeds in studs/second. Local forward is -Z.
return table.freeze({
	ReleaseVersion = 7,
	ModelScale = 0.84,
	MaxSpeed = 82,
	ReverseSpeed = 24,
	Acceleration = 39,
	BrakeAcceleration = 75,
	CoastDrag = 0.55,
	Grip = 10,
	DriftGrip = 3.5,
	SteerResponse = 12,
	ThrottleResponse = 9,
	DriftEnterResponse = 4.5,
	DriftExitResponse = 5.5,
	DriftSlipAngle = math.rad(11),
	YawResponse = 6,
	MaxYawAcceleration = 8,
	NormalResponse = 9,
	VisualSuspensionResponse = 18,
	CameraPositionResponse = 7,
	CameraHeightResponse = 3.5,
	CameraHeadingResponse = 5,
	CameraDistance = 10.8 * 0.84,
	CameraHeight = 4.0 * 0.84,
	CameraLookAhead = 2.4 * 0.84,
	CameraFocusHeight = 1.6,
	CameraDriftFollow = 0.12,
	MaxSteer = math.rad(29),
	MaxCornerAcceleration = 85,
	Wheelbase = 4.32 * 0.84,
	WheelTrack = 4.4 * 0.84,
	WheelRadius = 0.96 * 0.84,
	SuspensionRest = 0.65 * 0.84,
	SuspensionTravel = 0.65 * 0.84,
	SpringFrequency = 2.0,
	SpringDamping = 1.05,
	DriftMinSpeed = 27,
	DriftChargeTime = 0.5,
	TurboActivation = "Release", -- "Immediate" fires at the threshold while Shift stays held.
	TurboDuration = 1.5,
	TurboPower = 32,
	TurboCooldown = 6,
	-- Default Roblox unit conversion: one stud = 0.28 metres.
	StudsToMPH = 0.28 * 2.2369362921,
	GaugeMaxMPH = 100,
	RaceTotalLaps = 3,
	RaceMaxRacers = 6,
	RaceTrackWidth = 18,
	CareerWinsEnabled = true,
	CareerWinsDataStore = "FunRunKartCareerWins_v1",
	RaceProgressBinding = {
		Checkpoint = {"RaceCheckpoint", "Checkpoint"},
		CompletedLaps = {"RaceCompletedLaps", "CompletedLaps"},
		Progress = {"RaceSegmentProgress", "SegmentProgress"},
		Finished = {"RaceFinished"},
		FinishOrder = {"RaceFinishOrder"},
	},
	RaceStatNames = {
		Lap = {"Lap", "CurrentLap"},
		TotalLaps = {"TotalLaps", "MaxLaps"},
		Coins = {"Coins"},
		Wins = {"Wins", "Trophies"},
	},
	InputTimeout = 0.5,
	InputRate = 30,
	SpawnCFrame = CFrame.new(0, 5, 0),
	-- Place anchored Parts in Workspace.KartSpawns to override this default.
	Palette = {
		Red = Color3.fromRGB(220, 26, 46),
		Blue = Color3.fromRGB(25, 119, 235),
		Green = Color3.fromRGB(79, 195, 42),
		Yellow = Color3.fromRGB(255, 190, 21),
		Purple = Color3.fromRGB(154, 48, 232),
		Black = Color3.fromRGB(30, 33, 40),
	},
})
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX4">
        <Properties>
          <string name="Name">KartDynamics</string>
          <ProtectedString name="Source">-- Pure calculations shared by the server and the standalone Luau tests.
local Dynamics = {}

function Dynamics.approach(value, target, response, dt)
	return value+(target-value)*(1-math.exp(-response*dt))
end

function Dynamics.suspension(compression, normalVelocity, gravity, config)
	local omega=config.SpringFrequency*2*math.pi
	-- Acceleration per quarter mass; critically damped, bounded contact load.
	return math.clamp(gravity+compression*omega*omega-normalVelocity*2*config.SpringDamping*omega,0,gravity*2.5)
end

function Dynamics.steering(speed, steer, blend, config)
	local angle=-steer*config.MaxSteer/(1+(math.abs(speed)/36)^2)
	local limit=config.MaxCornerAcceleration/math.max(math.abs(speed),12)
	local yaw=math.clamp(math.tan(angle)*speed/config.Wheelbase*(1+blend*0.12),-limit,limit)
	return angle,yaw
end

function Dynamics.lateral(speed, sideSpeed, steer, blend, config)
	local target=-steer*math.max(speed,0)*math.tan(config.DriftSlipAngle)*blend
	local grip=config.Grip+(config.DriftGrip-config.Grip)*blend
	return math.clamp((target-sideSpeed)*grip,-config.MaxCornerAcceleration,config.MaxCornerAcceleration)
end

function Dynamics.longitudinal(speed, throttle, boost, config)
	local limit = config.MaxSpeed + boost
	local accel = 0
	if throttle &gt; 0 then
		accel = speed &lt; -1 and config.BrakeAcceleration or config.Acceleration
	elseif throttle &lt; 0 then
		accel = speed &gt; 1 and -config.BrakeAcceleration or -config.Acceleration * 0.65
	end
	accel *= math.abs(throttle)
	if boost &gt; 0 and throttle &gt;= 0 then accel += boost * 1.6 end
	if speed &gt; limit then accel = math.min(accel, -(speed - limit) * 7) end
	if speed &lt; -config.ReverseSpeed then accel = math.max(accel, (-config.ReverseSpeed - speed) * 7) end
	return accel - speed * config.CoastDrag * (throttle == 0 and 1 or 0.15)
end

function Dynamics.finite(value)
	return type(value) == "number" and value == value and math.abs(value) &lt; math.huge
end

local function activateTurbo(state, now, config)
	state.charge=0; state.turboArmed=false
	state.boostEnd=now+config.TurboDuration
	state.boostPower=config.TurboPower
	state.cooldown=now+config.TurboCooldown
end

function Dynamics.updateBoost(state, now, dt, grounded, speed, config)
	if state.player==nil then
		state.charge=0; state.turboArmed=false; state.wasDrift=false; state.boostEnd=0; state.boostPower=0
		-- The kart retains its recharge deadline when a driver leaves or respawns.
		return false,0
	end
	local onRoad=grounded and speed&gt;config.DriftMinSpeed
	local validMotion=math.abs(state.steer)&gt;0.15 and onRoad
	local drifting=state.drift and validMotion
	local readyAt=math.max(state.cooldown,state.boostEnd)
	if now&lt;readyAt then
		state.charge=0; state.turboArmed=false
	elseif drifting then
		-- A stalled simulation cannot instantly arm turbo. A frame straddling
		-- recharge completion only credits its eligible tail.
		local elapsed=Dynamics.finite(dt) and math.clamp(dt,0,1/15) or 0
		elapsed=math.min(elapsed,math.max(now-readyAt,0))
		state.charge=math.min(state.charge+elapsed,config.DriftChargeTime)
		-- Epoch deadlines have sub-microsecond double precision. Keep the meter
		-- exactly full when that rounding tolerance completes the charge.
		if state.charge+1e-6&gt;=config.DriftChargeTime then
			state.charge=config.DriftChargeTime; state.turboArmed=true
			if config.TurboActivation=="Immediate" then activateTurbo(state,now,config) end
		end
	elseif config.TurboActivation~="Immediate" and not state.drift and state.wasDrift and state.turboArmed and onRoad then
		-- Shift and the turn key may be released in the same input packet. The
		-- preceding drift must be valid, but current steering need not remain held.
		-- Airborne/slow releases and straightening while still held cancel charge.
		activateTurbo(state,now,config)
	else
		state.charge=0; state.turboArmed=false
	end
	state.wasDrift=drifting
	local power=now&lt;state.boostEnd and state.boostPower or 0
	if power==0 then state.boostPower=0 end
	return drifting,power
end

return table.freeze(Dynamics)
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX5">
        <Properties>
          <string name="Name">KartBuilder</string>
          <ProtectedString name="Source">local Config = require(script.Parent.KartConfig)
local Builder = {}
local WHITE = Color3.fromRGB(235, 239, 245)
local BLACK = Color3.fromRGB(20, 23, 30)
local RUBBER = Color3.fromRGB(13, 14, 19)
local METAL = Color3.fromRGB(90, 101, 119)
local BLUE = Color3.fromRGB(20, 85, 220)
local YELLOW = Color3.fromRGB(255, 205, 35)
local SEAT = Color3.fromRGB(12, 14, 18)

function Builder.build(name, spawn, color)
	color = color or Config.Palette.Red
	local scale = Config.ModelScale or 0.84
	-- Build once in canonical units, then scale the entire assembly together.
	local rest = Config.SuspensionRest / scale
	local radius = Config.WheelRadius / scale
	local track = (Config.WheelTrack or 4.40*scale) / scale
	local wheelbase = Config.Wheelbase / scale
	local tireWidth = 0.76
	local model = Instance.new("Model")
	model.Name = name
	model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	local function folder(label)
		local f = Instance.new("Folder")
		f.Name = label; f.Parent = model
		return f
	end
	local body = folder("Body")
	local wheels = folder("Wheels")
	local suspension = folder("Suspension")
	local effects = folder("Effects")
	local headlights = folder("Headlights")
	local exhaust = folder("Exhaust")
	local attachments = folder("Attachments")
	local chassis
	local function part(label, size, cf, tint, material, parent, shape, loose, class)
		local p = Instance.new(class or "Part")
		p.Name = label; p.Size = size; p.CFrame = spawn * cf
		p.Color = tint; p.Material = material or Enum.Material.SmoothPlastic
		p.TopSurface = Enum.SurfaceType.Smooth; p.BottomSurface = Enum.SurfaceType.Smooth
		p.CanCollide = false; p.CanTouch = false; p.CanQuery = false
		p.Massless = true
		if shape then p.Shape = shape end
		p.Parent = parent or body
		if chassis and not loose then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = chassis; weld.Part1 = p; weld.Parent = p
		end
		return p
	end
	local function bar(label, a, b, width, tint, parent)
		return part(label, Vector3.new((b-a).Magnitude, width, width), CFrame.lookAt((a+b)/2,b)*CFrame.Angles(0,math.pi/2,0), tint, Enum.Material.Metal, parent, Enum.PartType.Cylinder)
	end
	local function ring(parent, base, radius, thickness, tint, material, count, target)
		for i = 1, count do
			local angle = (i-0.5)*math.pi*2/count
			local cf = base * CFrame.Angles(0,0,angle) * CFrame.new(radius,0,0) * CFrame.Angles(0,0,math.pi/2)
			local segment = part("RingSegment", Vector3.new(2*radius*math.tan(math.pi/count), thickness, thickness), cf, tint, material, parent, nil, target ~= nil)
			if material==Enum.Material.Neon then segment.Name="BoostGlow"; segment.Transparency=1 end
			if target then
				local w = Instance.new("WeldConstraint"); w.Part0 = target; w.Part1 = segment; w.Parent = segment
			end
		end
	end
	local function rounded(label,size,cf,tint,radius,parent)
		radius=math.min(radius,size.X/2-0.01,size.Z/2-0.01)
		part(label,Vector3.new(size.X-2*radius,size.Y,size.Z),cf,tint,nil,parent)
		for _,side in ipairs({-1,1}) do
			part(label,Vector3.new(radius,size.Y,size.Z-2*radius),cf*CFrame.new(side*(size.X/2-radius/2),0,0),tint,nil,parent)
		end
		for _,x in ipairs({-1,1}) do for _,z in ipairs({-1,1}) do
			-- Flattened ellipsoids curve away from the top surface; flat cylinder
			-- caps would overlap the panels and create visible z-fighting.
			part(label.."Corner",Vector3.new(2*radius,size.Y,2*radius),cf*CFrame.new(x*(size.X/2-radius),0,z*(size.Z/2-radius)),tint,nil,parent,Enum.PartType.Ball)
		end end
	end

	chassis = part("Chassis", Vector3.new(3.7,0.5,6.5), CFrame.new(), BLACK, Enum.Material.Metal, model, nil, true)
	chassis.Massless = false; chassis.CanCollide = true; chassis.CanQuery = true
	-- Preserve the original mass/inertia collider for unchanged driving feel.
	-- Rendered bodywork has true wheel cutouts and conceals this collision box.
	chassis.Transparency = 1
	chassis.CustomPhysicalProperties = PhysicalProperties.new(3.5,0.12,0,100,100)
	chassis.RootPriority=127
	model.PrimaryPart = chassis
	part("FloorPan",Vector3.new(2.45,0.12,3.60),CFrame.new(0,0.34,0.1),BLACK,Enum.Material.SmoothPlastic)
	part("TaperedSkid",Vector3.new(2.65,0.22,5.80),CFrame.new(0,-0.10,-0.05),BLACK,nil,body,Enum.PartType.Ball)
	part("EnclosedLowerShell",Vector3.new(3.25,0.48,3.95),CFrame.new(0,0.05,0.40),BLUE,nil,body,Enum.PartType.Ball)
	-- A tapered, crowned hood loft follows a gentle longitudinal curve. The
	-- white center stripe is part of that surface instead of a floating decal.
	part("BlueNoseLower",Vector3.new(2.45,0.66,2.5),CFrame.new(0,0.15,-2.12),BLUE,nil,body,Enum.PartType.Ball)
	part("RedNoseCore",Vector3.new(2.18,0.58,2.58),CFrame.new(0,0.62,-2.10)*CFrame.Angles(math.rad(-22),0,0),color,nil,body,Enum.PartType.Ball)
	local function hood(t)
		return -3.22+2.37*t,0.40+1.10*t+0.16*math.sin(math.pi*t),2.25-0.43*t
	end
	for i=0,7 do
		local z0,y0,width0=hood(i/8)
		local z1,y1,width1=hood((i+1)/8)
		local width=(width0+width1)/2
		local length=math.sqrt((z1-z0)^2+(y1-y0)^2)+0.012
		local tilt=-math.atan((y1-y0)/(z1-z0))
		local middle=CFrame.new(0,(y0+y1)/2,(z0+z1)/2)*CFrame.Angles(tilt,0,0)
		part("WhiteCenterStripe",Vector3.new(0.84,0.055,length),middle,WHITE)
		for _,side in ipairs({-1,1}) do
			local panel=(width-0.84)/2
			local x=side*(0.42+panel/2)
			local crown=0.10*(math.abs(x)/(width/2))^2
			local bank=-0.20*x/(width/2)^2
			part("RedHoodPanel",Vector3.new(panel+0.018,0.075,length),middle*CFrame.new(x,-crown,0)*CFrame.Angles(0,0,bank),color)
		end
	end
	for _,side in ipairs({-1,1}) do
		part("RoundedHoodEdge",Vector3.new(0.27,0.27,2.48),CFrame.new(side*0.98,0.88,-2.03)*CFrame.Angles(math.rad(-26),-side*math.rad(6),0),color,nil,body,Enum.PartType.Ball)
	end
	-- Red tilted square with a real white center, centered on the stripe.
	local bz,by=hood(0.53)
	local badge=CFrame.new(0,by+0.07,bz)*CFrame.Angles(math.rad(-26),math.rad(15),0)
	for _,side in ipairs({-1,1}) do
		part("NoseSquareBadge",Vector3.new(0.55,0.012,0.16),badge*CFrame.new(0,0,side*0.195),color)
		part("NoseSquareBadge",Vector3.new(0.16,0.012,0.23),badge*CFrame.new(side*0.195,0,0),color)
	end
	-- Full-length curved pods enclose the lower cockpit and blend into the
	-- rear housing. Their front tips and rear haunches stop inside wheel sweep.
	for _,side in ipairs({-1,1}) do
		part("SidePodBlue",Vector3.new(0.74,0.52,2.80),CFrame.new(side*1.33,0.13,0.30),BLUE,nil,body,Enum.PartType.Ball)
		part("SidePodWhite",Vector3.new(0.70,0.18,2.78),CFrame.new(side*1.34,0.36,0.30),WHITE,nil,body,Enum.PartType.Ball)
		part("SidePodRed",Vector3.new(0.66,1.10,2.70),CFrame.new(side*1.34,0.64,0.30),color,nil,body,Enum.PartType.Ball)
		part("RoundSidePanel",Vector3.new(0.12,1.05,1.05),CFrame.new(side*1.625,0.64,0.35),color,nil,body,Enum.PartType.Cylinder)
		part("WhiteSideRoundel",Vector3.new(0.012,0.78,0.78),CFrame.new(side*1.695,0.64,0.35),WHITE,nil,body,Enum.PartType.Cylinder)
		local sideBadge=CFrame.new(side*1.708,0.64,0.35)*CFrame.Angles(math.rad(15),0,0)
		for _,offset in ipairs({-1,1}) do
			part("SideSquareBadge",Vector3.new(0.010,0.48,0.14),sideBadge*CFrame.new(0,0,offset*0.17),color)
			part("SideSquareBadge",Vector3.new(0.010,0.14,0.20),sideBadge*CFrame.new(0,offset*0.17,0),color)
		end
		bar("CockpitRail",Vector3.new(side*1.06,0.97,-0.50),Vector3.new(side*1.06,1.12,1.30),0.10,BLACK)
		part("RearHaunch",Vector3.new(0.56,0.85,1.40),CFrame.new(side*1.36,0.56,1.53),color,nil,body,Enum.PartType.Ball)
	end

	local bumper=folder("FrontBumper")
	rounded("WhiteFrontBumper",Vector3.new(2.80,0.28,0.62),CFrame.new(0,0.13,-3.22)*CFrame.Angles(math.pi/2,0,0),WHITE,0.23,bumper)
	for _,x in ipairs({-1.02,-0.52,0.52,1.02}) do
		part("BlueBumperVent",Vector3.new(0.22,0.31,0.035),CFrame.new(x*0.88,0.12,-3.375)*CFrame.Angles(0,0,math.rad(-12)),BLUE,nil,bumper)
	end
	bar("BumperLower",Vector3.new(-1.30,-0.25,-3.23),Vector3.new(1.30,-0.25,-3.23),0.15,BLACK,bumper)
	for _,side in ipairs({-1,1}) do
		bar("BumperCorner",Vector3.new(side*1.30,-0.25,-3.23),Vector3.new(side*1.40,0.22,-3.16),0.15,BLACK,bumper)
		local lamp=part("LED",Vector3.new(0.22,0.07,0.035),CFrame.new(side*1.30,0.42,-3.15),WHITE,Enum.Material.Neon,headlights)
		local beam=Instance.new("SpotLight"); beam.Face=Enum.NormalId.Front; beam.Brightness=0.8; beam.Range=22; beam.Angle=70; beam.Parent=lamp
		part("BrakeLight",Vector3.new(0.32,0.13,0.04),CFrame.new(side*1.16,0.48,2.86),Color3.fromRGB(110,5,10),nil,effects)
	end
	local seat=part("DriverSeat",Vector3.new(1.95,0.3,1.65),CFrame.new(0,0.84,0.65),SEAT,Enum.Material.Fabric,model,nil,false,"VehicleSeat")
	seat.HeadsUpDisplay=false; seat.MaxSpeed=0; seat.Torque=0; seat.TurnSpeed=0
	rounded("SeatBack",Vector3.new(1.95,0.28,1.75),CFrame.new(0,1.66,1.42)*CFrame.Angles(math.rad(80),0,0),SEAT,0.27)
	for _,side in ipairs({-1,1}) do
		part("SeatBolster",Vector3.new(0.22,0.9,0.6),CFrame.new(side*0.96,1.29,1.10)*CFrame.Angles(0,0,side*0.12),SEAT,Enum.Material.Fabric)
		bar("RearGuard",Vector3.new(side*1.58,0.10,1.35),Vector3.new(side*1.58,0.10,2.72),0.13,BLACK)
	end
	-- A closed engine cowl joins both haunches and the seat into one rear.
	part("RearLowerHousing",Vector3.new(3.10,0.54,1.65),CFrame.new(0,0.21,2.00),BLUE,nil,body,Enum.PartType.Ball)
	part("RearEngineHousing",Vector3.new(3.00,0.86,1.55),CFrame.new(0,0.68,1.97),color,nil,body,Enum.PartType.Ball)
	part("EngineInset",Vector3.new(1.20,0.10,0.65),CFrame.new(0,1.06,2.00),BLACK,Enum.Material.Metal)
	for i=1,5 do part("EngineCoolingFin",Vector3.new(1.10,0.04,0.055),CFrame.new(0,1.12,1.69+i*0.105),METAL,Enum.Material.Metal) end
	bar("RearAxle",Vector3.new(-2.05,0.40,2.16),Vector3.new(2.05,0.40,2.16),0.18,METAL)
	rounded("RearBumper",Vector3.new(3.10,0.34,0.40),CFrame.new(0,0.12,2.93),BLACK,0.16,body)
	part("RearBumperAccent",Vector3.new(2.65,0.09,0.04),CFrame.new(0,0.21,3.145),WHITE)

	for _,side in ipairs({-1,1}) do
		local lower=Vector3.new(side*1.08,0.34,-1.48)
		local upper=Vector3.new(side*0.94,1.28,-1.20)
		local axis=upper-lower
		local shock=CFrame.lookAt((lower+upper)/2,upper)
		bar("DamperRod",lower,upper,0.075,METAL,suspension)
		bar("DamperBody",lower,lower+axis*0.45,0.17,METAL,suspension)
		for _,point in ipairs({lower,upper}) do
			part("DamperEye",Vector3.new(0.22,0.22,0.22),CFrame.new(point),BLACK,Enum.Material.Metal,suspension,Enum.PartType.Ball)
		end
		local previous
		for n=0,32 do
			local t=n/32
			local phase=t*math.pi*8
			local offset=Vector3.new(math.cos(phase)*0.13,math.sin(phase)*0.13,(t-0.5)*axis.Magnitude*0.83)
			local point=(shock*CFrame.new(offset)).Position
			if previous then bar("BlueCoilSpring",previous,point,0.043,BLUE,suspension) end
			previous=point
		end
	end

	-- Non-colliding visual wheels; each client interpolates these same motors.
	-- Physical contacts are handled only by the spring forces and collision hull.
	local wheelData={}
	for _,desc in ipairs({{"FrontLeft",-1,-wheelbase/2,true},{"FrontRight",1,-wheelbase/2,true},{"RearLeft",-1,wheelbase/2,false},{"RearRight",1,wheelbase/2,false}}) do
		local label,side,z,front=table.unpack(desc)
		local group=Instance.new("Model"); group.Name=label; group.Parent=wheels
		local origin=Vector3.new(side*track/2,rest+0.4,z)
		-- Smaller chassis-mounted collision shells catch walls/curbs without
		-- competing with the raycast tires during normal spring compression.
		local guard=part(label.."Collision",Vector3.new(0.64,1.22,1.22),CFrame.new(origin-Vector3.new(0,0.35,0)),BLACK,Enum.Material.SmoothPlastic,suspension,Enum.PartType.Ball)
		guard.Transparency=1; guard.CanCollide=true; guard.CanQuery=true
		guard.CustomPhysicalProperties=PhysicalProperties.new(0.1,0.1,0,100,100)
		local cf=CFrame.new(origin-Vector3.new(0,rest,0))
		local tire=part("Tire",Vector3.new(tireWidth,2*radius,2*radius),cf,RUBBER,Enum.Material.SmoothPlastic,group,Enum.PartType.Cylinder,true)
		local motor=Instance.new("Motor6D"); motor.Name="WheelMotor"; motor.Part0=chassis; motor.Part1=tire; motor.C0=cf; motor.Parent=tire
		local function detail(label,size,offset,tint,material,shape)
			local p=part(label,size,cf*offset,tint,material,group,shape,true)
			local w=Instance.new("WeldConstraint"); w.Part0=tire; w.Part1=p; w.Parent=p
			return p
		end
		detail("Sidewall",Vector3.new(0.060,1.82,1.82),CFrame.new(side*0.367,0,0),RUBBER,Enum.Material.SmoothPlastic,Enum.PartType.Cylinder)
		detail("Rim",Vector3.new(0.080,1.28,1.28),CFrame.new(side*0.40,0,0),YELLOW,Enum.Material.Metal,Enum.PartType.Cylinder)
		detail("RimLip",Vector3.new(0.025,1.39,1.39),CFrame.new(side*0.395,0,0),YELLOW,Enum.Material.Metal,Enum.PartType.Cylinder)
		for _,offset in ipairs({-1,1}) do
			detail("RimCutout",Vector3.new(0.02,0.24,0.31),CFrame.new(side*0.448,offset*0.20,offset*0.11)*CFrame.Angles(math.rad(25),0,0),BLACK,Enum.Material.SmoothPlastic)
		end
		for n=1,12 do
			for _,offset in ipairs({-0.20,0.20}) do
				detail("Tread",Vector3.new(0.018,0.012,0.18),CFrame.Angles(n*math.pi/6,0,0)*CFrame.new(offset,radius,0),Color3.fromRGB(25,26,30),Enum.Material.SmoothPlastic)
			end
		end
		if not front then
			ring(group,cf*CFrame.new(side*0.455,0,0)*CFrame.Angles(0,math.pi/2,0),0.72,0.040,Color3.fromRGB(50,185,255),Enum.Material.Neon,16,tire)
		end
		local mount=Instance.new("Attachment"); mount.Name=label.."Mount"; mount.Position=origin; mount.Parent=chassis
		local force=Instance.new("VectorForce"); force.Name=label.."Contact"; force.Attachment0=mount; force.RelativeTo=Enum.ActuatorRelativeTo.World; force.ApplyAtCenterOfMass=false; force.Force=Vector3.zero; force.Parent=suspension
		local emitterAt=Instance.new("Attachment"); emitterAt.Name=label.."ContactEffects"; emitterAt.Position=origin-Vector3.new(0,rest+radius,0); emitterAt.Parent=chassis
		local smoke=Instance.new("ParticleEmitter"); smoke.Name="TireSmoke"; smoke.Texture="rbxasset://textures/particles/smoke_main.dds"; smoke.Color=ColorSequence.new(Color3.fromRGB(180,187,200)); smoke.Lifetime=NumberRange.new(0.3,0.6); smoke.Speed=NumberRange.new(1,3); smoke.Rate=0; smoke.SpreadAngle=Vector2.new(30,30); smoke.Size=NumberSequence.new({NumberSequenceKeypoint.new(0,0.3),NumberSequenceKeypoint.new(1,1.8)}); smoke.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,0.65),NumberSequenceKeypoint.new(1,1)}); smoke.Parent=emitterAt
		local sparks=Instance.new("ParticleEmitter"); sparks.Name="DriftSparks"; sparks.Texture="rbxasset://textures/particles/sparkles_main.dds"; sparks.Lifetime=NumberRange.new(0.12,0.28); sparks.Speed=NumberRange.new(3,7); sparks.SpreadAngle=Vector2.new(45,45); sparks.LightEmission=1; sparks.Size=NumberSequence.new(0.18); sparks.Rate=0; sparks.Parent=emitterAt
		local glow={}
		for _,p in ipairs(group:GetChildren()) do if p:IsA("BasePart") and p.Material==Enum.Material.Neon then table.insert(glow,p) end end
		table.insert(wheelData,{motor=motor,origin=origin,front=front,force=force,smoke=smoke,sparks=sparks,emitterAt=emitterAt,glow=glow,spin=0})
		bar("Wishbone",Vector3.new(side*1.16,0.05,z),origin-Vector3.new(0,rest,0),0.13,METAL,suspension)
	end
	local steering=Instance.new("Model"); steering.Name="SteeringWheel"; steering.Parent=model
	local steeringBase=CFrame.new(0,1.95,-1.05)*CFrame.Angles(math.rad(-24),0,0)
	local hub=part("Hub",Vector3.new(0.24,0.24,0.18),steeringBase,BLACK,Enum.Material.Metal,steering,nil,true)
	local steeringMotor=Instance.new("Motor6D"); steeringMotor.Name="SteeringMotor"; steeringMotor.Part0=chassis; steeringMotor.Part1=hub; steeringMotor.C0=steeringBase; steeringMotor.Parent=hub
	ring(steering,steeringBase,0.63,0.12,BLACK,Enum.Material.SmoothPlastic,24,hub)
	for n=1,3 do
		local cf=steeringBase*CFrame.Angles(0,0,n*2*math.pi/3)*CFrame.new(0,-0.3,0)
		local p=part("Spoke",Vector3.new(0.12,0.6,0.10),cf,METAL,Enum.Material.Metal,steering,nil,true)
		local w=Instance.new("WeldConstraint"); w.Part0=hub; w.Part1=p; w.Parent=p
	end
	for _,side in ipairs({-1,1}) do
		local a=Instance.new("Attachment"); a.Name=side&lt;0 and "LeftGrip" or "RightGrip"; a.Position=Vector3.new(side*0.59,0.13,0); a.Parent=hub
	end
	bar("SteeringColumn",Vector3.new(0,0.65,-0.65),Vector3.new(0,1.95,-1.05),0.16,METAL)
	local flames={}
	for _,side in ipairs({-1,1}) do
		local pipe=CFrame.new(side*0.78,1.06154,2.58005)*CFrame.Angles(-math.atan(0.32/0.948),0,0)
		part("BlackExhaust",Vector3.new(0.76,0.470,0.470),pipe*CFrame.Angles(0,math.pi/2,0),BLACK,Enum.Material.Metal,exhaust,Enum.PartType.Cylinder)
		part("YellowExhaustLip",Vector3.new(0.075,0.492,0.492),pipe*CFrame.new(0,0,0.38)*CFrame.Angles(0,math.pi/2,0),YELLOW,Enum.Material.Metal,exhaust,Enum.PartType.Cylinder)
		part("ExhaustOpening",Vector3.new(0.04,0.36,0.36),pipe*CFrame.new(0,0,0.428)*CFrame.Angles(0,math.pi/2,0),RUBBER,Enum.Material.SmoothPlastic,exhaust,Enum.PartType.Cylinder)
		local at=Instance.new("Attachment"); at.Name="ExhaustOutlet"; at.CFrame=pipe*CFrame.new(0,0,0.46)*CFrame.Angles(0,math.pi,0); at.Parent=chassis
		local flame=Instance.new("ParticleEmitter"); flame.Name="TurboFlame"; flame.Texture="rbxasset://textures/particles/fire_main.dds"; flame.EmissionDirection=Enum.NormalId.Front; flame.Rate=0; flame.Speed=NumberRange.new(12,19); flame.Lifetime=NumberRange.new(0.12,0.22); flame.SpreadAngle=Vector2.new(8,8); flame.LightEmission=1; flame.Color=ColorSequence.new(Color3.fromRGB(255,230,90),Color3.fromRGB(255,70,20)); flame.Size=NumberSequence.new({NumberSequenceKeypoint.new(0,0.65),NumberSequenceKeypoint.new(1,0)}); flame.Parent=at
		local light=Instance.new("PointLight"); light.Color=Color3.fromRGB(255,143,30); light.Range=9; light.Brightness=0; light.Parent=at
		local smoke=Instance.new("ParticleEmitter"); smoke.Name="EngineExhaust"; smoke.Texture="rbxasset://textures/particles/smoke_main.dds"; smoke.Rate=0; smoke.Lifetime=NumberRange.new(0.25,0.45); smoke.Speed=NumberRange.new(2,4); smoke.EmissionDirection=Enum.NormalId.Front; smoke.Size=NumberSequence.new(0.25); smoke.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,0.85),NumberSequenceKeypoint.new(1,1)}); smoke.Parent=at
		table.insert(flames,{emitter=flame,light=light,smoke=smoke})
	end
	local rootAt=Instance.new("Attachment"); rootAt.Name="StabilityAttachment"; rootAt.Parent=chassis
	local torque=Instance.new("Torque"); torque.Name="ArcadeStability"; torque.Attachment0=rootAt; torque.RelativeTo=Enum.ActuatorRelativeTo.World; torque.Parent=attachments
	local driveForce=Instance.new("VectorForce"); driveForce.Name="TireTraction"; driveForce.Attachment0=rootAt; driveForce.RelativeTo=Enum.ActuatorRelativeTo.World; driveForce.ApplyAtCenterOfMass=true; driveForce.Force=Vector3.zero; driveForce.Parent=attachments
	local prompt=Instance.new("ProximityPrompt"); prompt.Name="EnterKart"; prompt.ActionText="Drive"; prompt.ObjectText="Racing Kart"; prompt.KeyboardKeyCode=Enum.KeyCode.E; prompt.MaxActivationDistance=9; prompt.RequiresLineOfSight=false; prompt.Parent=seat
	model:SetAttribute("IsRacingKart",true)
	model:SetAttribute("ColorName","Red")
	-- ScaleTo also scales Attachments, Motor6Ds and their welded children about
	-- the chassis pivot. Metadata returned to the physics controller must agree.
	model:ScaleTo(scale)
	for _,wheel in ipairs(wheelData) do wheel.origin=wheel.origin*scale end
	steeringBase=steeringMotor.C0
	model:SetAttribute("ModelScale",scale)
	return {model=model,chassis=chassis,seat=seat,prompt=prompt,wheels=wheelData,driveForce=driveForce,torque=torque,steering=steeringMotor,steeringBase=steeringBase,hub=hub,flames=flames}
end

return Builder
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX6">
        <Properties>
          <string name="Name">KartSeatLock</string>
          <ProtectedString name="Source">-- Server seat lifecycle. A living driver stays assigned until legitimate cleanup.
-- Dependency injection lets the lifecycle run against deterministic test doubles.
local SeatLock = {}
SeatLock.__index = SeatLock

function SeatLock.new(seat, humanoid, valid, onRelease, scheduler)
	local self=setmetatable({},SeatLock)
	self.seat=seat; self.humanoid=humanoid
	self.valid=valid; self.onRelease=onRelease; self.scheduler=scheduler or task
	self.released=false; self.pending=false
	self.original={power=humanoid.JumpPower,height=humanoid.JumpHeight,
		jumping=humanoid:GetStateEnabled(Enum.HumanoidStateType.Jumping),
		gettingUp=humanoid:GetStateEnabled(Enum.HumanoidStateType.GettingUp)}
	humanoid.JumpPower=0; humanoid.JumpHeight=0
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping,false)
	humanoid:SetStateEnabled(Enum.HumanoidStateType.GettingUp,false)
	local function checkAlive()
		if not self:IsAlive() and not self.released then
			self:Release()
			onRelease()
		end
	end
	self.connections={
		humanoid.Died:Connect(checkAlive),
		humanoid.AncestryChanged:Connect(checkAlive),
		seat.AncestryChanged:Connect(checkAlive),
	}
	return self
end

function SeatLock:IsAlive()
	return not self.released and self.seat.Parent~=nil and self.humanoid.Parent~=nil
		and self.humanoid.Health&gt;0 and self.valid()
end

function SeatLock:Enforce()
	if not self:IsAlive() then return false end
	if self.seat.Occupant==self.humanoid or self.pending then return true end
	self.pending=true
	if self.seat.Occupant then self.seat.Occupant.Sit=false end
	self.scheduler.delay(0.08,function()
		if self:IsAlive() and self.seat.Occupant~=self.humanoid then
			self.humanoid.Jump=false
			self.seat:Sit(self.humanoid)
		end
		self.pending=false
		-- If Sit is temporarily refused by the engine, the next simulation
		-- update retries. No unbounded deferred loop or duplicate driver state.
	end)
	return true
end

function SeatLock:Release()
	if self.released then return end
	self.released=true
	for _,connection in ipairs(self.connections or {}) do connection:Disconnect() end
	local humanoid=self.humanoid
	if humanoid.Parent then
		humanoid.JumpPower=self.original.power; humanoid.JumpHeight=self.original.height
		humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping,self.original.jumping)
		humanoid:SetStateEnabled(Enum.HumanoidStateType.GettingUp,self.original.gettingUp)
	end
end

return SeatLock
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX7">
        <Properties>
          <string name="Name">KartHUD</string>
          <ProtectedString name="Source">-- Reference racing HUD: coins/laps, six real racers, placement and actual-course map.
-- It reads published race data only; driving and boost logic are intentionally absent.
local HUD={}
HUD.__index=HUD
local activeHUDs=setmetatable({},{__mode="k"})
local BLACK=Color3.fromRGB(5,7,10)
local GLASS=Color3.fromRGB(18,21,25)
local WHITE=Color3.fromRGB(247,249,252)
local GOLD=Color3.fromRGB(255,205,65)
local ORANGE=Color3.fromRGB(255,130,27)
local SILVER=Color3.fromRGB(194,205,215)
local BLUE=Color3.fromRGB(86,201,255)
local MARKERS={WHITE,Color3.fromRGB(102,213,255),Color3.fromRGB(244,107,110),Color3.fromRGB(153,236,150),Color3.fromRGB(199,151,255),Color3.fromRGB(255,163,99)}
local function create(class,properties,parent)
 local instance=Instance.new(class)
 for key,value in pairs(properties) do instance[key]=value end
 instance.Parent=parent
 return instance
end
local function frame(parent,name,x,y,w,h,color,z,rotation,transparency)
 return create("Frame",{Name=name,Position=UDim2.fromOffset(x,y),Size=UDim2.fromOffset(w,h),BackgroundColor3=color,BackgroundTransparency=transparency or 0,BorderSizePixel=0,ZIndex=z or 1,Rotation=rotation or 0},parent)
end
local function rounded(parent,radius)
 create("UICorner",{CornerRadius=UDim.new(radius=="circle" and 0.5 or 0,radius=="circle" and 0 or radius)},parent)
end
local function circle(parent,name,x,y,diameter,color,z)
 local object=frame(parent,name,x-diameter/2,y-diameter/2,diameter,diameter,color,z)
 rounded(object,"circle"); return object
end
local function stroke(parent,color,width,transparency)
 return create("UIStroke",{Color=color,Thickness=width,Transparency=transparency or 0},parent)
end
local function gradient(parent,top,bottom,rotation)
 if parent:IsA("TextLabel") then parent.TextColor3=WHITE else parent.BackgroundColor3=WHITE end
 return create("UIGradient",{Color=ColorSequence.new(top,bottom),Rotation=rotation or 90},parent)
end
local function text(parent,name,x,y,w,h,value,size,color,z,align)
 return create("TextLabel",{Name=name,Position=UDim2.fromOffset(x,y),Size=UDim2.fromOffset(w,h),BackgroundTransparency=1,BorderSizePixel=0,Text=value,TextColor3=color,TextSize=size,Font=Enum.Font.GothamBlack,TextXAlignment=align or Enum.TextXAlignment.Center,TextYAlignment=Enum.TextYAlignment.Center,ZIndex=z or 10},parent)
end
local function finite(value) return type(value)=="number" and value==value and math.abs(value)&lt;math.huge end
local function count(value)
 if not finite(value) or value&lt;0 then return "—" end
 return string.format("%d",math.floor(value))
end
local function rank(value)
 return finite(value) and value%1==0 and value&gt;=1 and value&lt;=6 and value or nil
end
local function point(value)
 return typeof(value)=="Vector3" and finite(value.X) and finite(value.Y) and finite(value.Z)
end
local function choose(...)
 for index=1,select("#",...) do local value=select(index,...); if value~=nil then return value end end
 return nil
end
local function trophy(parent,x,y,color,z)
 local left=frame(parent,"TrophyLeftHandle",x,y+2,8,10,color,z,0,1); rounded(left,4); stroke(left,color,2,0)
 local right=frame(parent,"TrophyRightHandle",x+17,y+2,8,10,color,z,0,1); rounded(right,4); stroke(right,color,2,0)
 local cup=frame(parent,"TrophyCup",x+5,y,15,13,color,z+1); rounded(cup,4)
 frame(parent,"TrophyStem",x+11,y+11,3,8,color,z+1)
 local base=frame(parent,"TrophyFoot",x+6,y+18,13,3,color,z+1); rounded(base,1)
end
local function placeholder(parent)
 local root=frame(parent,"PendingHeadshot",0,0,38,38,Color3.fromRGB(44,49,56),7)
 rounded(root,8)
 circle(root,"PendingAvatarHead",19,13,13,Color3.fromRGB(113,123,133),8)
 local shoulders=frame(root,"PendingAvatarShoulders",7,23,24,14,Color3.fromRGB(113,123,133),8); rounded(shoulders,9)
 return root
end
local function panel(parent,name,x,width)
 local shell=frame(parent,name,x,0,width,58,BLACK,2,-3,0.1)
 rounded(shell,5); stroke(shell,BLACK,2,0)
 gradient(shell,Color3.fromRGB(37,39,42),Color3.fromRGB(7,9,12),100)
 frame(shell,"TopHighlight",8,3,width-16,1,SILVER,3,0,0.7)
 return shell
end

function HUD.new(playerGui,config,context)
 local existing=activeHUDs[playerGui]
 if existing then existing:Destroy() end
 local self=setmetatable({},HUD)
 self.playerGui=playerGui; activeHUDs[playerGui]=self
 self.config=config; self.context=context or {}; self.destroyed=false; self.token=1
 self.playerId=self.context.player and self.context.player.UserId or nil
 self.pollTimer=1; self.rows={}; self.markers={}; self.rowsById={}; self.thumbnails={}; self.racers={}
 self.pathObjects={}; self.viewport=Vector2.zero; self.mapValid=false; self.pathVersion=nil
 local previous=playerGui:FindFirstChild("KartHUD")
 if previous then previous:Destroy() end -- remove old dial/turbo and avoid respawn/reload duplicates
 self.gui=create("ScreenGui",{Name="KartHUD",ResetOnSpawn=false,Enabled=false,IgnoreGuiInset=false,DisplayOrder=20,ZIndexBehavior=Enum.ZIndexBehavior.Sibling},playerGui)
 self.shell=frame(self.gui,"RaceHUDCanvas",0,0,1,1,BLACK,1,0,1)
 self.shell.Size=UDim2.fromScale(1,1)
 self.topLeft=frame(self.shell,"CoinsAndLaps",28,24,330,62,BLACK,2,0,1)
 self.topScale=create("UIScale",{Scale=1},self.topLeft)
 local coins=panel(self.topLeft,"CoinPanel",0,154)
 circle(coins,"CoinShadow",29,29,33,Color3.fromRGB(100,59,5),4)
 local coin=circle(coins,"GoldCoin",29,27,28,GOLD,5); stroke(coin,Color3.fromRGB(255,237,146),2,0)
 frame(coins,"CoinStamp",27,18,4,17,Color3.fromRGB(157,91,9),6)
 self.coinText=text(coins,"LiveCoins",54,5,88,46,"—",35,WHITE,6)
 self.coinText.TextStrokeColor3=BLACK; self.coinText.TextStrokeTransparency=0.2
 local lap=panel(self.topLeft,"LapPanel",167,155)
 frame(lap,"FlagPole",15,17,3,29,SILVER,5,-10)
 for row=0,3 do for column=0,4 do
  frame(lap,"CheckeredFlag",18+column*4.8,13+row*4.8,4.8,4.8,(row+column)%2==0 and WHITE or BLACK,6)
 end end
 self.lapText=text(lap,"LiveLap",47,6,100,43,"—/—",31,WHITE,6)
 self.lapText.TextStrokeColor3=BLACK; self.lapText.TextStrokeTransparency=0.2

 self.leaderboard=frame(self.shell,"SixRacerLeaderboard",0,22,238,290,BLACK,3,0,1)
 self.leaderboard.AnchorPoint=Vector2.new(1,0); self.leaderboard.Position=UDim2.new(1,-26,0,22)
 self.boardScale=create("UIScale",{Scale=1},self.leaderboard)
 for index=1,6 do
  local group=frame(self.leaderboard,"RacerSlot"..index,0,(index-1)*48,238,43,GLASS,4,0,0.16)
  rounded(group,11)
  local outline=stroke(group,BLACK,2,0)
  local glass=gradient(group,Color3.fromRGB(37,41,45),Color3.fromRGB(7,10,14),90)
  local position=text(group,"LivePlace",8,1,33,40,"—",25,WHITE,6)
  local head=create("ImageLabel",{Name="RealAvatarHeadshot",Position=UDim2.fromOffset(48,3),Size=UDim2.fromOffset(38,38),BackgroundColor3=Color3.fromRGB(34,38,44),BorderSizePixel=0,Image="",ScaleType=Enum.ScaleType.Crop,ZIndex=7},group)
  rounded(head,8); stroke(head,BLACK,1,0)
  local pending=placeholder(head)
  local localDot=circle(group,"LocalRacerDot",102,21,6,GOLD,7); localDot.Visible=false
  trophy(group,126,11,GOLD,7)
  local wins=text(group,"RealCareerWins",161,3,65,37,"—",27,WHITE,7,Enum.TextXAlignment.Right)
  group.Visible=false
  self.rows[index]={frame=group,rank=position,head=head,pending=pending,wins=wins,outline=outline,glass=glass,dot=localDot,y=(index-1)*48,targetY=(index-1)*48,userId=nil,slot=index}
 end

 self.placement=frame(self.shell,"LargeRacePlacement",32,0,228,155,BLACK,3,-6,1)
 self.placement.AnchorPoint=Vector2.new(0,1); self.placement.Position=UDim2.new(0,32,1,-28)
 self.placeScale=create("UIScale",{Scale=1},self.placement)
 self.placeNumberLayers={}; self.placeSuffixLayers={}
 for _,offset in ipairs({{-4,-3},{4,-3},{-4,3},{4,3},{0,-4},{0,4},{-4,0},{4,0}}) do
  table.insert(self.placeNumberLayers,text(self.placement,"NumberBlackOutline",offset[1],offset[2],128,146,"—",135,BLACK,4))
  table.insert(self.placeSuffixLayers,text(self.placement,"SuffixBlackOutline",116+offset[1]*0.6,73+offset[2]*0.6,98,62,"",47,BLACK,4))
 end
 local extrusion=text(self.placement,"NumberExtrusion",3,7,128,146,"—",135,Color3.fromRGB(137,65,5),5)
 table.insert(self.placeNumberLayers,extrusion)
 self.placeNumber=text(self.placement,"LivePlacementNumber",0,0,128,146,"—",135,WHITE,6)
 self.placeNumber.TextStrokeColor3=BLACK; self.placeNumber.TextStrokeTransparency=0
 self.placeGradient=gradient(self.placeNumber,Color3.fromRGB(255,220,92),ORANGE,90)
 self.placeSuffix=text(self.placement,"LivePlacementSuffix",116,73,98,62,"",47,WHITE,6)
 self.placeSuffix.TextStrokeColor3=BLACK; self.placeSuffix.TextStrokeTransparency=0
 gradient(self.placeSuffix,WHITE,Color3.fromRGB(154,167,180),90)

 self.mapRoot=frame(self.shell,"ActualCourseMinimap",0,0,236,184,BLACK,3,0,1)
 self.mapRoot.AnchorPoint=Vector2.new(1,1); self.mapRoot.Position=UDim2.new(1,-32,1,-32)
 self.mapScale=create("UIScale",{Scale=1},self.mapRoot)
 self.mapPlot=frame(self.mapRoot,"WorldXZCourse",0,0,236,184,BLACK,4,0,1)
 self.finishMarker=frame(self.mapPlot,"RealFinishLine",0,0,20,10,WHITE,8,0,1)
 self.finishMarker.AnchorPoint=Vector2.new(0.5,0.5)
 for row=0,1 do for column=0,3 do
  frame(self.finishMarker,"FinishCheck",column*5,row*5,5,5,(row+column)%2==0 and WHITE or BLACK,8)
 end end
 for index=1,6 do
  local dot=circle(self.mapPlot,"RealRacerMarker"..index,0,0,13,MARKERS[index],10)
  dot.AnchorPoint=Vector2.new(0.5,0.5)
  local outline=stroke(dot,BLACK,2.2,0)
  local label=text(dot,"ActualMarkerPlace",0,0,13,13,"",8,BLACK,12)
  dot.Visible=false
  self.markers[index]={frame=dot,label=label,outline=outline,x=nil,y=nil,targetX=0,targetY=0,valid=false}
 end
 self.mapRoot.Visible=false
 return self
end

function HUD:SetVisible(visible)
 if self.destroyed then return end
 self.gui.Enabled=visible
 if visible then self.pollTimer=1 end
end

function HUD:_thumbnail(userId)
 if self.thumbnails[userId] or not self.context.players then return end
 -- Studio test racers use synthetic non-positive IDs, not public avatar IDs.
 if userId&lt;=0 then self.thumbnails[userId]={url=nil,attempts=0}; return end
 local cache={url=nil,attempts=0}; self.thumbnails[userId]=cache
 local token=self.token
 local function load()
  if self.destroyed or self.token~=token then return end
  cache.attempts+=1
  local ok,url,ready=pcall(function()
   return self.context.players:GetUserThumbnailAsync(userId,Enum.ThumbnailType.HeadShot,Enum.ThumbnailSize.Size100x100)
  end)
  if self.destroyed or self.token~=token then return end
  if ok and ready==true and type(url)=="string" and url~="" then
   cache.url=url
   local row=self.rowsById[userId]
   if row and row.userId==userId then row.head.Image=url; row.pending.Visible=false end
  elseif cache.attempts&lt;3 then task.delay(2,load) end
 end
 task.spawn(load)
end

function HUD:_map(state)
 local path=state and state:FindFirstChild("Path")
 local expected=state and state:GetAttribute("PathPointCount")
 local revision=state and state:GetAttribute("PathRevision")
 local version=state and tostring(state:GetAttribute("RoundId"))..":"..tostring(revision)..":"..tostring(expected)..":"..tostring(state:GetAttribute("CourseValid")) or "none"
 if self.mapValid and version==self.pathVersion and path==self.pathObject then return end
 -- Replicated attributes can arrive before children (or before an old path is
 -- replaced). A pending/partial revision must stay retryable, never cached.
 self.pathVersion=nil; self.pathObject=nil
 for _,object in ipairs(self.pathObjects) do object:Destroy() end
 self.pathObjects={}; self.mapValid=false; self.mapRoot.Visible=false
 if not state or state:GetAttribute("CourseValid")~=true or not path then return end
 if not finite(expected) or expected%1~=0 or expected&lt;2 or not finite(revision) then return end
 local children=path:GetChildren()
 if #children~=expected then return end
 table.sort(children,function(a,b)
  local ai,bi=tonumber(a.Name),tonumber(b.Name)
  if ai and bi then return ai&lt;bi end
  return a.Name&lt;b.Name
 end)
 local points={}; local minX,maxX,minZ,maxZ=math.huge,-math.huge,math.huge,-math.huge
 for index,value in ipairs(children) do
  if not value:IsA("Vector3Value") or tonumber(value.Name)~=index or not point(value.Value) or value:GetAttribute("PathRevision")~=revision then return end
  local p=value.Value; table.insert(points,p)
  minX=math.min(minX,p.X); maxX=math.max(maxX,p.X); minZ=math.min(minZ,p.Z); maxZ=math.max(maxZ,p.Z)
 end
 if #points&lt;2 or math.max(maxX-minX,maxZ-minZ)&lt;0.001 then return end
 local scale=math.min(204/math.max(maxX-minX,0.001),152/math.max(maxZ-minZ,0.001))
 self.projection={minX=minX,minZ=minZ,scale=scale,offsetX=(236-(maxX-minX)*scale)/2,offsetY=(184-(maxZ-minZ)*scale)/2}
 local projected={}
 for _,p in ipairs(points) do local x,y=self:_project(p); table.insert(projected,{x=x,y=y}) end
 local function keep(object) table.insert(self.pathObjects,object); return object end
 for index,a in ipairs(projected) do
  local b=projected[index%#projected+1]
  local dx,dy=b.x-a.x,b.y-a.y; local length=math.sqrt(dx*dx+dy*dy)
  if length&gt;0.001 then
   local rotation=math.deg(math.atan2(dy,dx))
   local outer=keep(frame(self.mapPlot,"ActualRouteOutline",(a.x+b.x)/2,(a.y+b.y)/2,length+2,16,BLACK,5,rotation))
   outer.AnchorPoint=Vector2.new(0.5,0.5)
   local inner=keep(frame(self.mapPlot,"ActualRoute",(a.x+b.x)/2,(a.y+b.y)/2,length+2,9,Color3.fromRGB(203,207,211),6,rotation))
   inner.AnchorPoint=Vector2.new(0.5,0.5)
  end
  keep(circle(self.mapPlot,"RouteJointBlack",a.x,a.y,16,BLACK,5))
  keep(circle(self.mapPlot,"RouteJointGray",a.x,a.y,9,Color3.fromRGB(203,207,211),6))
 end
 local first,second=projected[1],projected[2]
 self.finishMarker.Position=UDim2.fromOffset(first.x,first.y)
 self.finishMarker.Rotation=math.deg(math.atan2(second.y-first.y,second.x-first.x))+90
 self.pathVersion=version; self.pathObject=path
 self.mapValid=true; self.mapRoot.Visible=true
end

function HUD:_project(position)
 local p=self.projection
 return math.clamp((position.X-p.minX)*p.scale+p.offsetX,8,228),math.clamp((position.Z-p.minZ)*p.scale+p.offsetY,8,176)
end

function HUD:_poll()
 local state=self.context.raceState
 if self.context.getRaceState then state=self.context.getRaceState() end
 self:_map(state)
 self.standingsValid=not state or state:GetAttribute("StandingsValid")~=false
 local folder=state and state:FindFirstChild("Racers")
 local racers={}
 if folder then
  for _,record in ipairs(folder:GetChildren()) do
   local id=record:GetAttribute("UserId")
   if record:IsA("Folder") and record:GetAttribute("Active")==true and finite(id) and id%1==0 then
    table.insert(racers,{id=id,place=self.standingsValid and rank(record:GetAttribute("Place")) or nil,position=record:GetAttribute("Position"),lap=record:GetAttribute("Lap"),totalLaps=record:GetAttribute("TotalLaps"),coins=record:GetAttribute("Coins"),wins=record:GetAttribute("Wins")})
   end
  end
 end
 table.sort(racers,function(a,b) if a.place~=b.place then return (a.place or 99)&lt;(b.place or 99) end; return a.id&lt;b.id end)
 local present={}; self.localRace=nil
 for index,record in ipairs(racers) do
  if index&gt;6 then break end
  present[record.id]=true
  if record.id==self.playerId then self.localRace=record end
 end
 for id,row in pairs(self.rowsById) do
  if not present[id] then row.userId=nil; row.frame.Visible=false; self.rowsById[id]=nil end
 end
 self.racers={}
 for _,marker in ipairs(self.markers) do marker.valid=false end
 for index,record in ipairs(racers) do
  if index&gt;6 then break end
  table.insert(self.racers,record)
  local row=self.rowsById[record.id]
  if not row then
   for _,candidate in ipairs(self.rows) do if not candidate.userId then row=candidate; break end end
   row.userId=record.id; row.y=(index-1)*48; self.rowsById[record.id]=row
  end
  local localPlayer=record.id==self.playerId
  row.targetY=(index-1)*48; row.frame.Visible=true
  row.rank.Text=count(record.place); row.rank.TextColor3=record.place==1 and GOLD or WHITE
  row.wins.Text=count(record.wins); row.dot.Visible=localPlayer
  row.outline.Color=localPlayer and GOLD or BLACK; row.outline.Thickness=localPlayer and 2.5 or 2
  row.glass.Color=localPlayer and ColorSequence.new(Color3.fromRGB(83,65,25),Color3.fromRGB(24,21,17)) or ColorSequence.new(Color3.fromRGB(37,41,45),Color3.fromRGB(7,10,14))
  self:_thumbnail(record.id)
  local cached=self.thumbnails[record.id]
  row.head.Image=cached and cached.url or ""; row.pending.Visible=not (cached and cached.url)
  local marker=self.markers[row.slot]
  marker.frame.Visible=self.mapValid and point(record.position)
  marker.valid=marker.frame.Visible
  marker.frame.BackgroundColor3=localPlayer and GOLD or MARKERS[index]
  marker.frame.ZIndex=localPlayer and 14 or 10
  marker.frame.Size=UDim2.fromOffset(localPlayer and 17 or 13,localPlayer and 17 or 13)
  marker.label.Size=UDim2.fromScale(1,1); marker.label.Text=count(record.place)
  marker.label.ZIndex=localPlayer and 16 or 12
  if marker.valid then
   marker.targetX,marker.targetY=self:_project(record.position)
   if marker.userId~=record.id then marker.x,marker.y=marker.targetX,marker.targetY end
  end
  marker.userId=record.id
 end
 for _,marker in ipairs(self.markers) do if not marker.valid then marker.frame.Visible=false end end
end

function HUD:_placement(place)
 if place==self.lastPlace then return end
 self.lastPlace=place
 local digit=place and tostring(place) or "—"
 local suffix=place and ({"ST","ND","RD","TH","TH","TH"})[place] or ""
 for _,label in ipairs(self.placeNumberLayers) do label.Text=digit end
 for _,label in ipairs(self.placeSuffixLayers) do label.Text=suffix end
 self.placeNumber.Text=digit; self.placeSuffix.Text=suffix
 self.placeGradient.Color=place==2 and ColorSequence.new(WHITE,SILVER) or ColorSequence.new(Color3.fromRGB(255,220,92),ORANGE)
end

function HUD:Update(_model,_actualSpeed,dt,_now,viewport,touch,snapshot)
 if self.destroyed then return end
 if viewport~=self.viewport or touch~=self.touch then
  self.viewport=viewport; self.touch=touch
  local scale=touch and math.clamp(math.min(viewport.X/620,viewport.Y/700),0.45,0.72) or math.clamp(math.min(viewport.X/1280,viewport.Y/720),0.6,1.2)
  for _,object in ipairs({self.topScale,self.boardScale,self.placeScale,self.mapScale}) do object.Scale=scale end
  self.topLeft.Position=UDim2.fromOffset(touch and 14 or 28,touch and 16 or 24)
  self.leaderboard.Position=UDim2.new(1,touch and -14 or -26,0,touch and 16 or 22)
  self.placement.Position=UDim2.new(0,touch and 18 or 32,1,touch and -208 or -28)
  self.mapRoot.Position=UDim2.new(1,touch and -18 or -32,1,touch and -208 or -32)
 end
 self.pollTimer+=dt
 if self.pollTimer&gt;=0.1 then self.pollTimer=0; self:_poll() end
 local data=snapshot or {}; local own=self.localRace or {}; local player=self.context.player
 local function attribute(name) return player and player:GetAttribute(name) or nil end
 self.coinText.Text=count(choose(data.coins,own.coins,attribute("KartCoins")))
 self.lapText.Text=count(choose(data.lap,own.lap,attribute("KartLap"))).."/"..count(choose(data.totalLaps,own.totalLaps,attribute("KartTotalLaps")))
 local place=rank(choose(data.place,own.place,attribute("KartPlace")))
 if not self.standingsValid then place=nil end
 self:_placement(place)
 local blend=1-math.exp(-dt*12)
 for _,row in ipairs(self.rows) do
  if row.userId then row.y+=(row.targetY-row.y)*blend; row.frame.Position=UDim2.fromOffset(0,row.y) end
 end
 for _,marker in ipairs(self.markers) do
  if marker.valid then
   marker.x+=(marker.targetX-marker.x)*blend; marker.y+=(marker.targetY-marker.y)*blend
   marker.frame.Position=UDim2.fromOffset(marker.x,marker.y)
  end
 end
end

function HUD:Destroy()
 if self.destroyed then return end
 self.destroyed=true; self.token+=1
 if activeHUDs[self.playerGui]==self then activeHUDs[self.playerGui]=nil end
 self.rowsById={}; self.thumbnails={}; self.gui:Destroy()
end
return HUD
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX8">
        <Properties>
          <string name="Name">KartRace</string>
          <ProtectedString name="Source">-- Server-authoritative six-racer match, standings and actual course snapshot.
local Players=game:GetService("Players")
local HttpService=game:GetService("HttpService")
local Rules=require(script.Parent.KartRaceRules)
local Career=require(script.Parent.KartCareerWins)
local Race={}
Race.__index=Race
local fields={Lap="KartLap",TotalLaps="KartTotalLaps",Coins="KartCoins",Wins="KartWins"}
local defaults={Lap={"Lap","CurrentLap"},TotalLaps={"TotalLaps","MaxLaps"},Coins={"Coins"},Wins={"Wins","Trophies"}}
local progressDefaults={Checkpoint={"RaceCheckpoint","Checkpoint"},CompletedLaps={"RaceCompletedLaps","CompletedLaps"},Progress={"RaceSegmentProgress","SegmentProgress"},Finished={"RaceFinished"},FinishOrder={"RaceFinishOrder"}}
local reserved={KartLap=true,KartTotalLaps=true,KartCoins=true,KartWins=true,KartPlace=true}

local function binding(player,field,config,progress)
	local definitions=progress and progressDefaults or defaults
	local configured=progress and config.RaceProgressBinding or config.RaceStatNames
	local names=(configured and configured[field]) or definitions[field]
	if type(names)=="string" then names={names} end
	if type(names)~="table" then names=definitions[field] end
	local stats=player:FindFirstChild("leaderstats")
	local function valid(raw)
		if field=="Finished" then if type(raw)=="boolean" then return raw end; return nil end
		if field=="Progress" then
			return type(raw)=="number" and raw==raw and raw&gt;=0 and raw&lt;=1 and raw or nil
		end
		local value=Rules.counter(raw)
		if value~=nil and (field~="TotalLaps" and field~="FinishOrder" or value&gt;=1) and (not progress or value==raw) then return value end
		return nil
	end
	for _,name in ipairs(names or {}) do
		if type(name)=="string" and not reserved[name] then
			local value=valid(player:GetAttribute(name))
			if value~=nil then return value end
			local stat=stats and stats:FindFirstChild(name)
			if stat and (stat:IsA("IntValue") or stat:IsA("NumberValue") or stat:IsA("BoolValue")) then
				value=valid(stat.Value)
				if value~=nil then return value end
			end
		end
	end
	return nil
end

local function folder(parent,name)
	local value=Instance.new("Folder"); value.Name=name; value.Parent=parent
	return value
end
local function attribute(object,name,value)
	if object:GetAttribute(name)~=value then object:SetAttribute(name,value) end
end
local function ordered(parent)
	local result,count={},0
	if not parent then return nil end
	for _,part in ipairs(parent:GetChildren()) do
		if part:IsA("BasePart") then
			local raw=part:GetAttribute("Order")
			if raw==nil then raw=tonumber(part.Name) end
			local order=Rules.counter(raw)
			if not order or order&lt;1 or order~=raw or result[order] then return nil end
			result[order]=part; count+=1
		end
	end
	if count&lt;2 or count&gt;500 then return nil end
	for index=1,count do if not result[index] then return nil end end
	return result
end

function Race.new(config,dependencies)
	dependencies=dependencies or {}
	local self=setmetatable({config=config,elapsed=0,refresh=0,states={},positions={},round={},
		checkpoints={},coins={},admitted={},serial=0,activeDrivers={},rows={},pathRevision=0},Race)
	self.maxRacers=math.clamp(Rules.counter(config.RaceMaxRacers) or 6,1,6)
	self.career=dependencies.career or Career.new(config)
	local existing=script.Parent:FindFirstChild("RaceState")
	if existing then existing:Destroy() end
	self.snapshot=folder(script.Parent,"RaceState")
	self.pathFolder=folder(self.snapshot,"Path"); self.racerFolder=folder(self.snapshot,"Racers")
	self.removing=Players.PlayerRemoving:Connect(function(player)
		self:ReleaseAdmission(player)
		self.career:Remove(player)
		self.states[player]=nil; self.positions[player]=nil
	end)
	self:_refresh()
	return self
end

function Race:_state(player)
	if not self.states[player] then self.states[player]=Rules.new() end
	return self.states[player]
end

function Race:CanJoin(player)
	if self.destroyed or not player or player.Parent~=Players then return false end
	if self.admitted[player] then return true end
	local count=self.round.finishCount or 0
	for racer in pairs(self.admitted) do if not self:_state(racer).finishOrder then count+=1 end end
	return count&lt;self.maxRacers
end

function Race:TryJoin(player)
	if not self:CanJoin(player) then return false end
	if self.admitted[player] then return true end
	self.serial+=1; self.admitted[player]=self.serial
	self:_state(player)
	local row=folder(self.racerFolder,tostring(player.UserId))
	row:SetAttribute("UserId",player.UserId); row:SetAttribute("Active",true)
	self.rows[player]=row
	attribute(player,"KartRaceAdmitted",true)
	return true
end

function Race:ReleaseAdmission(player)
	self.admitted[player]=nil; self.positions[player]=nil; self.activeDrivers[player]=nil
	if self.rows[player] then self.rows[player]:Destroy(); self.rows[player]=nil end
	attribute(player,"KartRaceAdmitted",false); attribute(player,"KartPlace",nil)
end

function Race:ResetRound()
	self.round={finishCount=0,finishOwners={}}
	self.roundId=HttpService:GenerateGUID(false)
	self.positions={}
	for player,state in pairs(self.states) do
		local fresh=Rules.new(); fresh.coins=state.coins
		-- A provider must actually reset its progress before its previous finish
		-- can be consumed in a new round. Never write to another race's stats.
		local external=self:_externalProgress(player,binding(player,"TotalLaps",self.config) or self.total)
		fresh.externalFinishBlocked=state.externalFinishBlocked or state.externalFinished==true or (external and external.finished) or false
		self.states[player]=fresh
	end
	local inactive={}
	for player in pairs(self.admitted) do if not self.activeDrivers[player] then table.insert(inactive,player) end end
	for _,player in ipairs(inactive) do self:ReleaseAdmission(player) end
	attribute(self.snapshot,"RoundId",self.roundId)
	attribute(self.snapshot,"WinnerUserId",nil)
end

function Race:_refresh()
	local course=workspace:FindFirstChild("KartRace")
	local checkpoints=ordered(course and course:FindFirstChild("Checkpoints"))
	local pathParts=ordered(course and course:FindFirstChild("Path"))
	local source=pathParts and "Path" or "Checkpoints"
	local points,gates={},{}
	if checkpoints then
		for _,part in ipairs(checkpoints) do table.insert(gates,part.Position) end
		for _,part in ipairs(pathParts or checkpoints) do table.insert(points,part.Position) end
	end
	local width=self.config.RaceTrackWidth or 18
	local track=checkpoints and Rules.track(points,gates,width) or nil
	local valid=track~=nil
	local total=Rules.counter(course and course:GetAttribute("TotalLaps"))
	if not total or total&lt;1 then total=Rules.counter(self.config.RaceTotalLaps) or 3 end
	total=math.max(total,1)
	local changed=self.course~=course or self.total~=total or self.hasCourse~=valid
	if not changed and valid then
		if #self.checkpoints~=#checkpoints or not self.track or #self.track.points~=#track.points then changed=true
		else
			for index,part in ipairs(checkpoints) do if self.checkpoints[index]~=part then changed=true; break end end
			if not changed then for index,point in ipairs(track.points) do
				if (point-self.track.points[index]).Magnitude&gt;0.01 then changed=true; break end
			end end
		end
	end
	local coins={}
	local coinFolder=course and course:FindFirstChild("Coins")
	if coinFolder then for _,part in ipairs(coinFolder:GetChildren()) do if part:IsA("BasePart") then table.insert(coins,part) end end end
	self.course=course; self.hasCourse=valid; self.hasCoins=coinFolder~=nil
	self.checkpoints=valid and checkpoints or {}; self.track=track; self.coins=coins; self.total=total
	attribute(self.snapshot,"CourseValid",valid); attribute(self.snapshot,"TotalLaps",total)
	attribute(self.snapshot,"PathSource",valid and source or nil)
	if changed then
		for _,child in ipairs(self.pathFolder:GetChildren()) do child:Destroy() end
		if valid then for index,point in ipairs(track.points) do
			local item=Instance.new("Vector3Value"); item.Name=string.format("%03d",index); item.Value=point
			item:SetAttribute("PathRevision",self.pathRevision+1); item.Parent=self.pathFolder
		end end
		attribute(self.snapshot,"PathPointCount",valid and #track.points or 0)
		self.pathRevision+=1; attribute(self.snapshot,"PathRevision",self.pathRevision)
		self:ResetRound()
	end
end

function Race:_externalProgress(player,total)
	if not self.hasCourse then return nil end
	local checkpoint=binding(player,"Checkpoint",self.config,true)
	local completed=binding(player,"CompletedLaps",self.config,true)
	local fraction=binding(player,"Progress",self.config,true)
	if not checkpoint or checkpoint&lt;1 or checkpoint&gt;#self.checkpoints or not completed or completed&gt;total or fraction==nil then return nil end
	return {completed=completed,checkpoint=checkpoint,fraction=fraction,
		finished=binding(player,"Finished",self.config,true)==true or completed&gt;=total,
		finishOrder=binding(player,"FinishOrder",self.config,true)}
end

function Race:_rank(player,position)
	local state=self:_state(player)
	local total=binding(player,"TotalLaps",self.config) or self.total
	local external=self:_externalProgress(player,total)
	if external and external.finished and state.externalFinishBlocked then external=nil end
	local checkpoint=state.started and (state.expected==1 and #self.checkpoints or state.expected-1) or 0
	local completed=state.completed
	local fraction=0
	if external then
		checkpoint=external.checkpoint; completed=external.completed; fraction=external.fraction
	elseif checkpoint&gt;0 then
		local sameLeg=state.rankCheckpoint==checkpoint and state.rankCompleted==completed
		local projected,distance=Rules.trackProgress(self.track,checkpoint,position,
			sameLeg and state.rankDistance or nil,self.config.RaceTrackWidth or 18)
		if projected~=nil then fraction=projected; state.rankDistance=distance
		elseif sameLeg then fraction=state.rankFraction or 0 end
	end
	state.rankCheckpoint=checkpoint; state.rankCompleted=completed; state.rankFraction=fraction
	return {player=player,serial=self.admitted[player],userId=player.UserId,completed=completed,
		checkpoint=checkpoint,fraction=fraction,finishOrder=state.finishOrder,external=external,total=total}
end

function Race:_values(player)
	local state=self:_state(player)
	local rank=state.rank
	local lap=binding(player,"Lap",self.config)
	local total=binding(player,"TotalLaps",self.config)
	if rank and self.hasCourse then
		total=total or rank.total
		if lap==nil then lap=rank.finishOrder and total or math.min(rank.completed+(rank.checkpoint&gt;0 and 1 or 0),total) end
	else
		if self.hasCourse and self.admitted[player] then lap=lap or state.lap; total=total or self.total end
	end
	local coins=binding(player,"Coins",self.config)
	if coins==nil and self.hasCoins then coins=state.coins end
	local wins=binding(player,"Wins",self.config)
	if wins==nil then self.career:Track(player); wins=self.career:Get(player) end
	return {Lap=lap,TotalLaps=total,Coins=coins,Wins=wins}
end

function Race:_publish(player)
	local values=self:_values(player)
	for field,name in pairs(fields) do attribute(player,name,values[field]) end
	local state=self:_state(player)
	attribute(player,"KartPlace",self.admitted[player] and self.hasCourse and state.place or nil)
	local row=self.rows[player]
	if row then
		attribute(row,"Active",true); attribute(row,"Place",self.hasCourse and state.place or nil)
		attribute(row,"Position",state.position)
		for field,value in pairs(values) do attribute(row,field,value) end
		-- pairs omits nil fields; remove stale unknown data explicitly.
		for field in pairs(fields) do attribute(row,field,values[field]) end
	end
end

function Race:Update(karts,dt)
	if self.destroyed then return end
	self.career:Update(dt)
	self.elapsed+=math.max(0,dt); self.refresh+=math.max(0,dt)
	if self.elapsed&lt;0.1 then return end
	local sample=self.elapsed; self.elapsed=0
	if self.refresh&gt;=1 then self.refresh=0; self:_refresh() end
	local active,candidates,finishers={},{},{}
	for _,kart in ipairs(karts) do
		local player=kart.player
		local occupant=kart.seat and kart.seat.Occupant
		if player and player.Parent==Players and occupant and occupant.Health&gt;0 and player.Character==occupant.Parent
			and kart.chassis and kart.chassis:IsDescendantOf(workspace) and Rules.finiteVector(kart.chassis.Position) then
			table.insert(candidates,kart)
		end
	end
	table.sort(candidates,function(a,b) return a.player.UserId&lt;b.player.UserId end)
	-- A Lap-only provider owns a different race whose ordering is unknown.
	-- Latch this round unavailable; resetting after the provider supplies its
	-- complete progress schema gives every participant a coherent fresh race.
	for _,kart in ipairs(candidates) do self:TryJoin(kart.player) end
	for player in pairs(self.admitted) do
		if binding(player,"Lap",self.config)~=nil and not self:_externalProgress(player,binding(player,"TotalLaps",self.config) or self.total) then
			self.round.progressBlocked=true
		end
	end
	local standingsValid=self.hasCourse and not self.round.progressBlocked
	attribute(self.snapshot,"StandingsValid",standingsValid)
	for _,kart in ipairs(candidates) do
		local player=kart.player
		if self:TryJoin(player) then
			active[player]=true
			local state=self:_state(player)
			local position=kart.chassis.Position; state.position=position
			local previous=self.positions[player]
			local limit=((self.config.MaxSpeed or 82)+(self.config.TurboPower or 32)+20)*sample+12
			local teleported=previous and (position-previous).Magnitude&gt;limit*2
			if teleported then previous=nil; Rules.resetRoute(state); state.rankCheckpoint=nil; state.rankDistance=nil end
			if not teleported and self.hasCourse then
				local external=self:_externalProgress(player,binding(player,"TotalLaps",self.config) or self.total)
				local ownsIncomplete=binding(player,"Lap",self.config)~=nil and not external
				if external then
					if not external.finished then state.externalFinishBlocked=false end
					state.externalFinished=external.finished
				end
				if state.externalActive and not external then Rules.resetRoute(state); state.rankDistance=nil end
				state.externalActive=external~=nil
				local events={}
				for order,gate in ipairs(self.checkpoints) do
					if gate:IsDescendantOf(workspace) then
						local entered=Rules.entry(previous and gate.CFrame:PointToObjectSpace(previous) or nil,
							gate.CFrame:PointToObjectSpace(position),gate.Size/2)
						if entered then table.insert(events,{order=order,time=entered}) end
					end
				end
				table.sort(events,function(a,b) return a.time==b.time and a.order&lt;b.order or a.time&lt;b.time end)
				for _,event in ipairs(events) do
					if not external and not ownsIncomplete and Rules.visit(state,event.order,#self.checkpoints,binding(player,"TotalLaps",self.config) or self.total)=="finish" and not state.finishOrder then
						table.insert(finishers,{player=player,state=state,time=event.time})
					end
				end
				if external and external.finished and not state.externalFinishBlocked and not state.finishOrder then
					state.finished=true
					table.insert(finishers,{player=player,state=state,time=external.finishOrder or math.huge,provided=external.finishOrder})
				end
			end
			if self.hasCoins and binding(player,"Coins",self.config)==nil then
				for _,coin in ipairs(self.coins) do
					if coin:IsDescendantOf(workspace) then
						local nearest=position
						if previous then
							local direction=position-previous; local squared=direction:Dot(direction)
							if squared&gt;1e-9 then nearest=previous+direction*math.clamp((coin.Position-previous):Dot(direction)/squared,0,1) end
						end
						if (nearest-coin.Position).Magnitude&lt;=(self.config.RaceCoinPickupRadius or 3.5) then Rules.collect(state,coin,coin:GetAttribute("Value") or 1) end
					end
				end
			end
			self.positions[player]=position
		end
	end
	self.activeDrivers=active
	table.sort(finishers,function(a,b) return a.time==b.time and a.player.UserId&lt;b.player.UserId or a.time&lt;b.time end)
	for _,finisher in ipairs(finishers) do
		if standingsValid and not finisher.state.finishOrder then
			local order=finisher.provided or 1
			if not finisher.provided then while self.round.finishOwners[order] do order+=1 end end
			if order&lt;=self.maxRacers and not self.round.finishOwners[order] then
				self.round.finishCount=(self.round.finishCount or 0)+1
				self.round.finishOwners[order]=finisher.player.UserId
				finisher.state.finishOrder=order
				if order==1 and Rules.claimWinner(self.round,finisher.player.UserId) then
					attribute(self.snapshot,"WinnerUserId",finisher.player.UserId)
					if binding(finisher.player,"Wins",self.config)==nil then self.career:Award(finisher.player,self.roundId..":"..tostring(finisher.player.UserId)) end
				end
			end
		end
	end

	for player in pairs(self.positions) do
		if not active[player] then self.positions[player]=nil; Rules.resetRoute(self:_state(player)) end
	end
	local standings={}
	for player in pairs(self.admitted) do
		local state=self:_state(player)
		if standingsValid and state.position then
			local rank=self:_rank(player,state.position); state.rank=rank
			table.insert(standings,rank)
		else state.place=nil; state.rank=nil end
	end
	table.sort(standings,Rules.ahead)
	local unfinished=0
	for _,rank in ipairs(standings) do
		if rank.finishOrder then self:_state(rank.player).place=rank.finishOrder
		else
			unfinished+=1
			while self.round.finishOwners[unfinished] do unfinished+=1 end
			self:_state(rank.player).place=unfinished
		end
	end
	for _,player in ipairs(Players:GetPlayers()) do self:_publish(player) end
end

function Race:Destroy()
	if self.destroyed then return end
	self.destroyed=true; self.removing:Disconnect()
	self.career:Destroy()
	for _,player in ipairs(Players:GetPlayers()) do
		for _,name in pairs(fields) do player:SetAttribute(name,nil) end
		player:SetAttribute("KartPlace",nil); player:SetAttribute("KartRaceAdmitted",false)
	end
	self.snapshot:Destroy()
	table.clear(self.states); table.clear(self.positions); table.clear(self.admitted)
end

return Race
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX9">
        <Properties>
          <string name="Name">KartRaceRules</string>
          <ProtectedString name="Source">-- Pure server race rules. No client can submit checkpoint, coin or finish events.
local Rules = {}

function Rules.counter(value)
	if type(value)~="number" or value~=value or math.abs(value)==math.huge or value&lt;0 then return nil end
	return math.floor(value)
end

function Rules.new()
	return {started=false,expected=1,lap=0,completed=0,finished=false,coins=0,wins=0,collected={}}
end

function Rules.visit(state, order, checkpointCount, totalLaps)
	if state.finished or order~=state.expected or checkpointCount&lt;2 or totalLaps&lt;1 then return nil end
	if not state.started then
		if order~=1 then return nil end
		state.started=true; state.lap=state.completed+1; state.expected=2
		return "start"
	end
	if order==1 then
		state.completed+=1
		if state.completed&gt;=totalLaps then
			state.finished=true; state.lap=totalLaps
			return "finish"
		end
		state.lap=state.completed+1; state.expected=2
		return "lap"
	end
	state.expected=order==checkpointCount and 1 or order+1
	return "checkpoint"
end

function Rules.resetRoute(state)
	if state.finished then return end
	state.started=false; state.expected=1; state.lap=state.completed
end

function Rules.claimWinner(round, userId)
	if round.winner~=nil then return false end
	round.winner=userId
	return true
end

function Rules.collect(state, coin, value)
	value=Rules.counter(value)
	if not value or value&lt;1 or state.finished or state.collected[coin] then return false end
	state.collected[coin]=true; state.coins+=value
	return true
end

function Rules.inside(point, half)
	return math.abs(point.X)&lt;=half.X and math.abs(point.Y)&lt;=half.Y and math.abs(point.Z)&lt;=half.Z
end

-- Slab intersection returns when a swept server position enters a gate.
-- A driver already inside a gate cannot repeatedly trigger it while parked.
function Rules.entry(previous, current, half)
	if not previous then return Rules.inside(current,half) and 0 or nil end
	if Rules.inside(previous,half) then return nil end
	local enter,leave=0,1
	for _,axis in ipairs({"X","Y","Z"}) do
		local origin=previous[axis]
		local delta=current[axis]-origin
		if math.abs(delta)&lt;1e-9 then
			if math.abs(origin)&gt;half[axis] then return nil end
		else
			local a,b=(-half[axis]-origin)/delta,(half[axis]-origin)/delta
			if a&gt;b then a,b=b,a end
			enter=math.max(enter,a); leave=math.min(leave,b)
			if enter&gt;leave then return nil end
		end
	end
	return enter
end

function Rules.finiteVector(value)
	if value==nil then return false end
	for _,axis in ipairs({"X","Y","Z"}) do
		local n=value[axis]
		if type(n)~="number" or n~=n or math.abs(n)==math.huge then return false end
	end
	return true
end

local function segments(points)
	local result,total={},0
	for index,a in ipairs(points) do
		local b=points[index%#points+1]
		local length=(b-a).Magnitude
		if length&gt;1e-5 then
			table.insert(result,{a=a,b=b,length=length,start=total,finish=total+length})
			total+=length
		end
	end
	return result,total
end

local function project(point,parts,from,to,previous)
	local best
	for _,segment in ipairs(parts) do
		local low=math.max(from,segment.start)
		local high=math.min(to,segment.finish)
		if high&gt;=low then
			local direction=segment.b-segment.a
			local t=math.clamp((point-segment.a):Dot(direction)/(segment.length^2),
				(low-segment.start)/segment.length,(high-segment.start)/segment.length)
			local projected=segment.a+direction*t
			local distance=(point-projected).Magnitude
			local arc=segment.start+segment.length*t
			local tie=previous and math.abs(arc-previous) or arc
			if not best or distance&lt;best.error-1e-6 or (math.abs(distance-best.error)&lt;=1e-6 and tie&lt;best.tie) then
				best={point=projected,arc=arc,error=distance,tie=tie,index=segment.index,t=t}
			end
		end
	end
	return best
end

-- Normalize the real closed polyline so checkpoint one is the minimap start.
-- Checkpoints must follow the path order. Invalid geometry is not ranked.
function Rules.track(points,checkpoints,maxError)
	if #points&lt;2 or #checkpoints&lt;2 then return nil end
	local clean={}
	for _,point in ipairs(points) do
		if not Rules.finiteVector(point) then return nil end
		if #clean==0 or (point-clean[#clean]).Magnitude&gt;1e-5 then table.insert(clean,point) end
	end
	if #clean&gt;1 and (clean[1]-clean[#clean]).Magnitude&lt;1e-5 then table.remove(clean) end
	if #clean&lt;2 then return nil end
	local raw,total=segments(clean)
	if total&lt;1e-4 then return nil end
	for index,segment in ipairs(raw) do segment.index=index end
	local first=project(checkpoints[1],raw,0,total)
	if not first or first.error&gt;maxError then return nil end
	local normalized={first.point}
	for offset=1,#clean do
		local index=(first.index+offset-1)%#clean+1
		local point=clean[index]
		if (point-normalized[#normalized]).Magnitude&gt;1e-5 and (point-normalized[1]).Magnitude&gt;1e-5 then table.insert(normalized,point) end
	end
	local path,length=segments(normalized)
	local gates={0}
	local previous=0
	for index=2,#checkpoints do
		local at=project(checkpoints[index],path,previous+1e-4,length-1e-4)
		if not at or at.error&gt;maxError or at.arc&lt;=previous then return nil end
		gates[index]=at.arc; previous=at.arc
	end
	return {points=normalized,segments=path,length=length,gates=gates}
end

-- Projection is confined to the legal leg between visited/next checkpoints.
-- Being physically near a later part of the circuit cannot skip race progress.
function Rules.trackProgress(track,checkpoint,position,previous,maxError)
	local from=track.gates[checkpoint]
	local to=track.gates[checkpoint+1] or track.length
	if not from or to-from&lt;1e-5 or not Rules.finiteVector(position) then return nil end
	local at=project(position,track.segments,from,to,previous)
	if not at or at.error&gt;maxError then return nil end
	return math.clamp((at.arc-from)/(to-from),0,1),at.arc
end

function Rules.ahead(a,b)
	if a.finishOrder or b.finishOrder then
		if not a.finishOrder then return false end
		if not b.finishOrder then return true end
		if a.finishOrder~=b.finishOrder then return a.finishOrder&lt;b.finishOrder end
	end
	if a.completed~=b.completed then return a.completed&gt;b.completed end
	if a.checkpoint~=b.checkpoint then return a.checkpoint&gt;b.checkpoint end
	if math.abs(a.fraction-b.fraction)&gt;1e-7 then return a.fraction&gt;b.fraction end
	if a.serial~=b.serial then return a.serial&lt;b.serial end
	return a.userId&lt;b.userId
end

return table.freeze(Rules)
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX10">
        <Properties>
          <string name="Name">KartCareerWins</string>
          <ProtectedString name="Source">-- Server career-win storage. Get never yields; unknown/failed loads remain nil.
-- UpdateAsync merges monotonic per-server-session award watermarks. Retrying a
-- write after an ambiguous response cannot increment twice or erase other servers.
local Career={}
Career.__index=Career

local function count(value)
	if type(value)~="number" or value~=value or math.abs(value)==math.huge or value&lt;0 then return nil end
	return math.floor(value)
end

local function record(value)
	if value==nil then return {version=1,wins=0,sessions={}} end
	if type(value)=="number" then
		local wins=count(value)
		if not wins then return nil end
		return {version=1,wins=wins,sessions={}}
	end
	if type(value)~="table" or count(value.wins)==nil then return nil end
	if value.sessions~=nil and type(value.sessions)~="table" then return nil end
	local sessions={}
	for session,sequence in pairs(value.sessions or {}) do
		if type(session)~="string" or count(sequence)==nil then return nil end
		sessions[session]=count(sequence)
	end
	local copy=table.clone(value)
	copy.version=1; copy.wins=count(value.wins); copy.sessions=sessions
	return copy
end

local function identity(player)
	local id=type(player)=="number" and player or (player and player.UserId)
	if type(id)~="number" or id~=id or math.abs(id)==math.huge or id%1~=0 then return nil end
	return tostring(id)
end

function Career.new(config, deps)
	deps=deps or {}
	local self=setmetatable({},Career)
	self.enabled=config.CareerWinsEnabled~=false
	self.records={}
	self.sequences={}; self.awardIds={}
	self.clock=deps.clock or os.clock
	self.spawn=deps.spawn or task.spawn
	self.wait=deps.wait or task.wait
	self.warning=deps.warn or warn
	self.session=deps.sessionId or game:GetService("HttpService"):GenerateGUID(false)
	self.retryBase=1
	self.closeBudget=math.clamp(config.CareerWinsCloseTimeout or 25,0,25)
	self.name=config.CareerWinsDataStore or "FunRunKartCareerWins_v1"
	self.store=deps.store
	self.factory=deps.storeFactory or function()
		return game:GetService("DataStoreService"):GetDataStore(self.name)
	end
	self.storeNext=0
	self.storeFailures=0
	local bind=deps.bindToClose or function(callback) game:BindToClose(callback) end
	if self.enabled then bind(function() self:Close() end) end
	return self
end

function Career:_getStore()
	if self.store then return self.store end
	if self.clock()&lt;self.storeNext then return nil end
	local ok,value=pcall(self.factory)
	if ok and value then self.store=value; self.storeFailures=0; return value end
	self.storeFailures+=1
	self.storeNext=self.clock()+math.min(60,self.retryBase*2^math.min(self.storeFailures-1,6))
	self.warning("Kart career wins storage unavailable; values remain unknown and pending awards are retained.")
	return nil
end

function Career:_record(player)
	local id=identity(player)
	if not id then return nil end
	local current=self.records[id]
	if not current then
		local known=self.sequences[id] or 0
		self.awardIds[id]=self.awardIds[id] or {}
		current={id=id,loaded=false,wins=nil,nextSeq=known,savedSeq=known,awards=self.awardIds[id],
			nextAttempt=0,failures=0,inFlight=false,removed=false}
		self.records[id]=current
	end
	return current
end

function Career:_prune(current)
	if current.removed and not current.inFlight and current.nextSeq&lt;=current.savedSeq then
		if self.records[current.id]==current then self.records[current.id]=nil end
	end
end

function Career:_queue(current, force)
	if not self.enabled or self.destroyed or current.inFlight then return false end
	local dirty=current.nextSeq&gt;current.savedSeq
	if current.loaded and not dirty then self:_prune(current); return false end
	if not force and self.clock()&lt;current.nextAttempt then return false end
	local store=self:_getStore()
	if not store then return false end
	current.inFlight=true
	local target=current.nextSeq
	self.spawn(function()
		local ok,value=pcall(function()
			if target&gt;current.savedSeq then
				return store:UpdateAsync("u_"..current.id,function(previous)
					local data=record(previous)
					if not data then error("Invalid stored career-win record; refusing to overwrite it") end
					local applied=data.sessions[self.session] or 0
					local delta=math.max(target-applied,0)
					data.wins+=delta
					data.sessions[self.session]=math.max(applied,target)
					return data
				end)
			end
			return store:GetAsync("u_"..current.id)
		end)
		local data=ok and record(value) or nil
		local watermark=data and (data.sessions[self.session] or 0) or 0
		if data and target&gt;current.savedSeq and watermark&lt;target then data=nil end
		if data then
			current.loaded=true
			current.wins=data.wins
			current.savedSeq=math.max(current.savedSeq,watermark)
			current.nextSeq=math.max(current.nextSeq,current.savedSeq)
			self.sequences[current.id]=math.max(self.sequences[current.id] or 0,current.nextSeq)
			current.failures=0; current.nextAttempt=0
		else
			-- Never replace an unknown count with 0 after an access failure,
			-- malformed record or an ambiguous write result.
			current.failures+=1
			current.nextAttempt=self.clock()+math.min(60,self.retryBase*2^math.min(current.failures-1,6))
			if current.failures==1 or current.failures%6==0 then
				self.warning("Kart career wins request failed for user "..current.id.."; pending awards retained for retry.")
			end
		end
		current.inFlight=false
		self:_prune(current)
	end)
	return true
end

function Career:Track(player)
	if not self.enabled or self.destroyed or self.closing then return end
	local current=self:_record(player)
	if not current then return end
	current.removed=false
	self:_queue(current,false)
end

function Career:Get(player)
	if not self.enabled then return nil end
	local id=identity(player)
	local current=id and self.records[id]
	if not current or not current.loaded then return nil end
	-- Confirmed storage plus actual locally earned awards still awaiting a save.
	return current.wins+math.max(current.nextSeq-current.savedSeq,0)
end

function Career:Award(player, awardId)
	if not self.enabled or self.destroyed or self.closing or type(awardId)~="string" or #awardId==0 then return false end
	local current=self:_record(player)
	if not current or current.awards[awardId] then return false end
	current.awards[awardId]=true
	current.nextSeq+=1
	self.sequences[current.id]=current.nextSeq
	self:_queue(current,false)
	return true
end

function Career:Flush(player)
	local id=identity(player)
	local current=id and self.records[id]
	return current and self:_queue(current,true) or false
end

function Career:Update(_dt)
	if not self.enabled or self.destroyed then return end
	for _,current in pairs(self.records) do self:_queue(current,false) end
end

function Career:Remove(player)
	local id=identity(player)
	local current=id and self.records[id]
	if not current then return end
	current.removed=true
	self:_queue(current,true)
	self:_prune(current)
	-- Failed dirty records deliberately remain queued after the Player is gone.
end

function Career:Close()
	if not self.enabled or self.destroyed or self.closing then return end
	self.closing=true
	local deadline=self.clock()+self.closeBudget
	for _,current in pairs(self.records) do
		if current.nextSeq&gt;current.savedSeq then self:_queue(current,true) end
	end
	while self.clock()&lt;deadline do
		local pending=false
		for _,current in pairs(self.records) do
			if current.nextSeq&gt;current.savedSeq then
				pending=true
				self:_queue(current,false)
			end
		end
		if not pending then return end
		self.wait(0.1)
	end
	local unsaved=0
	for _,current in pairs(self.records) do unsaved+=math.max(current.nextSeq-current.savedSeq,0) end
	if unsaved&gt;0 then
		self.warning("Kart career wins shutdown deadline reached with "..unsaved.." pending award(s). Storage access must be restored; these writes are not confirmed.")
	end
end

function Career:Destroy()
	if self.destroyed then return end
	self:Close()
	self.destroyed=true
end

return Career
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX11">
        <Properties>
          <string name="Name">KartMeshVisuals</string>
          <ProtectedString name="Source">-- Imported Blender meshes replace presentation only. The existing raycast rig,
-- wheel carriers, steering motor, seat, hand targets and effects remain intact.
local MeshVisuals={}
local GROUPS={
	"MainBody","FrontNose","LeftSidePod","RightSidePod","RearBody","RearBumper",
	"Seat","SteeringWheel","FrontLeftWheel","FrontRightWheel","RearLeftWheel",
	"RearRightWheel","LeftExhaust","RightExhaust","Chassis",
}
local wheelNames={FrontLeftWheel="FrontLeft",FrontRightWheel="FrontRight",RearLeftWheel="RearLeft",RearRightWheel="RearRight"}

local function finite(value)
	return type(value)=="number" and value==value and math.abs(value)&lt;math.huge
end
local function validFrame(cf)
	if typeof(cf)~="CFrame" then return false end
	for _,value in ipairs({cf:GetComponents()}) do if not finite(value) then return false end end
	return true
end
local function validSize(size)
	return typeof(size)=="Vector3" and finite(size.X) and finite(size.Y) and finite(size.Z)
		and size.X&gt;0 and size.Y&gt;0 and size.Z&gt;0 and math.max(size.X,size.Y,size.Z)&lt;32
end
local function scaledFrame(cf,scale)
	return CFrame.new(cf.Position*scale)*cf.Rotation
end
local function sanitize(part)
	for _,child in ipairs(part:GetChildren()) do
		-- Imported solid-color meshes need no scripts, constraints or attachments.
		if not child:IsA("SurfaceAppearance") then child:Destroy() end
	end
	part.Anchored=false; part.Massless=true
	part.CanCollide=false; part.CanTouch=false; part.CanQuery=false
	assert(finite(part.Transparency),"invalid mesh transparency")
	part.Transparency=math.clamp(part.Transparency,0,1)
end

function MeshVisuals.apply(rig,color,template)
	if not rig or not rig.model or not rig.chassis or not rig.hub or not rig.seat then return false,"invalid rig" end
	if rig.model:FindFirstChild("ImportedKartVisuals") then return true,"already applied" end
	-- The template is created by ImportBlender.command.luau after Studio uploads
	-- the FBX meshes to the experience owner's account. No asset IDs are invented.
	if not template then template=script.Parent:FindFirstChild("KartMeshTemplate") end
	if not template then rig.model:SetAttribute("VisualSource","Native"); return false,"no imported mesh template" end
	local holder
	local brakeLights={}
	local ok,result=pcall(function()
		assert(template:IsA("Model") and template:GetAttribute("KartMeshFormat")==1,"invalid mesh template format")
		local scale=rig.model:GetAttribute("ModelScale") or 1
		assert(finite(scale) and scale&gt;0 and scale&lt;=4,"invalid rig scale")
		local wheels=assert(rig.model:FindFirstChild("Wheels"),"missing wheel rig")
		local accepted={}
		for _,name in ipairs(GROUPS) do accepted[name]=true end
		for _,group in ipairs(template:GetChildren()) do assert(accepted[group.Name],"unexpected mesh group: "..group.Name) end
		holder=Instance.new("Folder"); holder.Name="ImportedKartVisuals"
		local count=0
		for _,name in ipairs(GROUPS) do
			local source=assert(template:FindFirstChild(name),"missing mesh group: "..name)
			assert(source:IsA("Folder") or source:IsA("Model"),"invalid mesh group: "..name)
			local pivot=source:GetAttribute("KartGroupPivot")
			assert(validFrame(pivot),"missing canonical group pivot: "..name)
			local carrier=rig.chassis
			if wheelNames[name] then
				local wheel=assert(wheels:FindFirstChild(wheelNames[name]),"missing wheel: "..name)
				carrier=assert(wheel:FindFirstChild("Tire"),"missing tire carrier: "..name)
			elseif name=="SteeringWheel" then carrier=rig.hub end
			local destination=Instance.new("Folder"); destination.Name=name; destination.Parent=holder
			local groupCount=0
			for _,part in ipairs(source:GetChildren()) do
				assert(part:IsA("MeshPart"),"template contains a non-mesh: "..part.Name)
				assert(validSize(part.Size) and validFrame(part.CFrame),"invalid mesh transform: "..part.Name)
				local copy=assert(part:Clone(),"mesh is not Archivable: "..part.Name)
				sanitize(copy)
				copy.Size=part.Size*scale
				-- Template CFrames are normalized chassis-local canonical units.
				-- Dynamic groups are expressed relative to their real motor pivot.
				local relative=carrier==rig.chassis and part.CFrame or pivot:ToObjectSpace(part.CFrame)
				copy.CFrame=carrier.CFrame*scaledFrame(relative,scale)
				if part:GetAttribute("KartPrimaryPaint")==true and color then copy.Color=color end
				if part:GetAttribute("KartBrakeLight")==true then table.insert(brakeLights,copy) end
				copy.Parent=destination
				local weld=Instance.new("WeldConstraint"); weld.Name="VisualWeld"
				weld.Part0=carrier; weld.Part1=copy; weld.Parent=copy
				groupCount+=1; count+=1
				assert(count&lt;=256,"mesh object budget exceeded")
			end
			assert(groupCount&gt;0,"empty mesh group: "..name)
		end
		return count
	end)
	if not ok then
		if holder then holder:Destroy() end
		rig.model:SetAttribute("VisualSource","Native")
		return false,tostring(result)
	end
	-- All clones and motor-relative transforms are valid before anything visible
	-- is hidden. A bad import leaves the complete native fallback drivable.
	local oldParts={}
	for _,part in ipairs(rig.model:GetDescendants()) do
		if part:IsA("BasePart") and part.Name~="BoostGlow" and part.Name~="BrakeLight" then table.insert(oldParts,part) end
	end
	holder.Parent=rig.model
	for _,part in ipairs(oldParts) do part.Transparency=1 end
	rig.model:SetAttribute("VisualSource","Blender")
	rig.model:SetAttribute("MeshObjectCount",result)
	rig.meshBrakeLights=brakeLights
	return true,"Blender meshes applied"
end

return table.freeze(MeshVisuals)
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX12">
        <Properties>
          <string name="Name">KartPresentation</string>
          <ProtectedString name="Source">-- Pure visual motion calculations. Never changes vehicle forces or turbo rules.
local Presentation={}

function Presentation.delta(dt)
	return type(dt)=="number" and dt==dt and math.clamp(dt,0,0.1) or 0
end

function Presentation.wheel(phase,filteredSpeed,actualSpeed,radius,dt)
	dt=Presentation.delta(dt)
	if radius&lt;=0 then return phase,0 end
	-- Ignore sub-pixel replication noise at rest; parked tires stop immediately.
	if math.abs(actualSpeed)&lt;0.05 then return phase,0 end
	local decay=math.exp(-16*dt)
	local speed=actualSpeed+(filteredSpeed-actualSpeed)*decay
	-- Analytic distance under the smoothing curve, so spin agrees across FPS.
	local distance=actualSpeed*dt+(filteredSpeed-actualSpeed)*(1-decay)/16
	return (phase-distance/radius)%(2*math.pi),speed
end

return table.freeze(Presentation)
</ProtectedString>
        </Properties>
      </Item>
    </Item>
    <Item class="Script" referent="RBX13">
      <Properties>
        <string name="Name">KartServer</string>
        <ProtectedString name="Source">local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local System = ReplicatedStorage:WaitForChild("KartSystem")
local Config = require(System.KartConfig)
local Dynamics = require(System.KartDynamics)
local Builder = require(System.KartBuilder)
local MeshVisuals = require(System.KartMeshVisuals)
local SeatLock = require(System.KartSeatLock)
local Race = require(System.KartRace)
local race = Race.new(Config)
local resetRace = Instance.new("BindableEvent")
resetRace.Name="ResetRace"; resetRace.Parent=script
resetRace.Event:Connect(function() race:ResetRound() end)

local remotes = Instance.new("Folder"); remotes.Name="Remotes"; remotes.Parent=System
local input = Instance.new("RemoteEvent"); input.Name="Input"; input.Parent=remotes
local states = {}
local playerStates = {}
local rates = {}
local chargeColors = {Color3.fromRGB(70,190,255),Color3.fromRGB(255,165,45)}
local world = workspace:FindFirstChild("RacingKarts") or Instance.new("Folder")
world.Name="RacingKarts"; world.Parent=workspace

local function restoreDriver(s)
	if s.restoring then return end
	s.restoring=true
	local previousHumanoid=s.humanoid
	if s.seatLock then s.seatLock:Release(); s.seatLock=nil end
	for part,original in pairs(s.driverMass or {}) do if part.Parent then part.Massless=original end end
	s.driverMass={}
	if s.driverStateConnection then s.driverStateConnection:Disconnect(); s.driverStateConnection=nil end
	for part,original in pairs(s.driverCollisions or {}) do if part.Parent then part.CanCollide=original end end
	s.driverCollisions={}
	if s.driverCollision then s.driverCollision:Destroy(); s.driverCollision=nil end
	for _,ik in ipairs(s.iks or {}) do ik:Destroy() end
	s.iks={}
	if s.waist and s.waist.Parent then s.waist.C0=s.waistBase end
	s.waist=nil
	s.humanoid=nil
	if s.player then playerStates[s.player]=nil end
	s.player=nil; s.throttle=0; s.steer=0; s.drift=false
	s.charge=0; s.boostEnd=0; s.boostPower=0
	s.turboArmed=false; s.wasDrift=false
	-- Cooldown is retained across character replacement/cleanup.
	s.model:SetAttribute("DriverUserId",0)
	s.model:SetAttribute("DriverLocked",false)
	s.prompt.Enabled=true
	-- Legitimate cleanup must detach living replaced/removed characters too.
	-- The Occupant listener is suppressed until this assignment is fully clear.
	if previousHumanoid and previousHumanoid.Parent then previousHumanoid.Sit=false end
	s.restoring=false
end

local function attachDriver(s)
	restoreDriver(s)
	local humanoid=s.seat.Occupant
	if not humanoid then return end
	local player=Players:GetPlayerFromCharacter(humanoid.Parent)
	if not player or humanoid.Health&lt;=0 or playerStates[player] or not race:TryJoin(player) then humanoid.Sit=false; return end
	s.player=player; playerStates[player]=s; s.humanoid=humanoid
	s.seatLock=SeatLock.new(s.seat,humanoid,function()
		return s.player==player and player.Parent==Players and player.Character==humanoid.Parent
			and humanoid:IsDescendantOf(workspace) and s.model:IsDescendantOf(workspace)
	end,function() if s.humanoid==humanoid then restoreDriver(s) end end)
	s.model:SetAttribute("DriverJumpingBeforeLock",s.seatLock.original.jumping)
	s.model:SetAttribute("DriverGettingUpBeforeLock",s.seatLock.original.gettingUp)
	s.prompt.Enabled=false; s.lastInput=workspace:GetServerTimeNow()
	s.chassis.Anchored=false
	s.chassis:SetNetworkOwner(nil) -- authoritative forces, boosts and speed caps
	-- An animated driver's limbs must not shift the physics assembly's COM or
	-- collide with its hull. Restore every original Massless flag on departure.
	s.driverMass={}
	s.driverCollisions={}
	s.driverCollision=Instance.new("Folder"); s.driverCollision.Name="DriverCollisionOverrides"; s.driverCollision.Parent=s.model
	local hulls={s.chassis}
	for _,part in ipairs(s.model.Suspension:GetChildren()) do
		if part:IsA("BasePart") and part.CanCollide then table.insert(hulls,part) end
	end
	for _,part in ipairs(humanoid.Parent:GetDescendants()) do
		if part:IsA("BasePart") then
			s.driverMass[part]=part.Massless; part.Massless=true
			s.driverCollisions[part]=part.CanCollide; part.CanCollide=false
			for _,hull in ipairs(hulls) do
				local constraint=Instance.new("NoCollisionConstraint"); constraint.Part0=part; constraint.Part1=hull; constraint.Parent=s.driverCollision
			end
		end
	end
	s.driverStateConnection=humanoid.StateChanged:Connect(function()
		-- Shorter body clearance must not let seated feet push against the road.
		-- Vehicle collision hulls remain enabled; avatar settings restore on cleanup.
		if s.humanoid==humanoid then
			for part in pairs(s.driverCollisions) do if part.Parent then part.CanCollide=false end end
		end
	end)
	s.model:SetAttribute("DriverUserId",player.UserId)
	if humanoid.RigType==Enum.HumanoidRigType.R15 then
		for _,side in ipairs({"Left","Right"}) do
			local upper=humanoid.Parent:FindFirstChild(side.."UpperArm")
			local hand=humanoid.Parent:FindFirstChild(side.."Hand")
			if upper and hand then
				local ik=Instance.new("IKControl"); ik.Name="Kart"..side.."Grip"
				ik.Type=Enum.IKControlType.Position; ik.ChainRoot=upper; ik.EndEffector=hand
				ik.Target=s.hub:FindFirstChild(side.."Grip"); ik.Weight=1; ik.SmoothTime=0.08; ik.Priority=10; ik.Parent=humanoid
				table.insert(s.iks,ik)
			end
		end
		local upperTorso=humanoid.Parent:FindFirstChild("UpperTorso")
		local waist=upperTorso and upperTorso:FindFirstChild("Waist")
		if waist and waist:IsA("Motor6D") then s.waist=waist; s.waistBase=waist.C0 end
	end
end

local function spawnKart(cf, colorName)
	local color=Config.Palette[colorName] or Config.Palette.Red
	local s=Builder.build("RacingKart",cf,color)
	MeshVisuals.apply(s,color)
	s.brakeLights={}
	for _,part in ipairs(s.model.Effects:GetChildren()) do
		if part:IsA("BasePart") and part.Name=="BrakeLight" then
			if #(s.meshBrakeLights or {})&gt;0 then part.Transparency=1 end
			table.insert(s.brakeLights,part)
		end
	end
	for _,part in ipairs(s.meshBrakeLights or {}) do table.insert(s.brakeLights,part) end
	for _,wheel in ipairs(s.wheels) do
		wheel.motor:SetAttribute("WheelRadius",Config.WheelRadius)
		wheel.motor:SetAttribute("ContactOrigin",wheel.origin)
		wheel.motor:SetAttribute("SuspensionDistance",Config.SuspensionRest)
	end
	s.model:SetAttribute("ColorName",colorName)
	s.model.Parent=world
	CollectionService:AddTag(s.model,"RacingKart")
	s.spawn=cf; s.throttle=0; s.steer=0; s.visualSteer=0; s.drift=false
	s.lastInput=0; s.charge=0; s.boostEnd=0; s.boostPower=0; s.cooldown=0; s.turboArmed=false
	s.turboEffect=0; s.trails={}
	for _,wheel in ipairs(s.wheels) do
		if not wheel.front then
			local a=Instance.new("Attachment"); a.Name="TurboTrailTop"; a.Position=wheel.origin+Vector3.new(0,0.05,0.5)*Config.ModelScale; a.Parent=s.chassis
			local b=Instance.new("Attachment"); b.Name="TurboTrailBottom"; b.Position=a.Position-Vector3.new(0,0.22*Config.ModelScale,0); b.Parent=s.chassis
			local trail=Instance.new("Trail"); trail.Name="BlueTurboTrail"; trail.Attachment0=a; trail.Attachment1=b
			trail.Color=ColorSequence.new(Color3.fromRGB(45,165,255),Color3.fromRGB(135,235,255))
			trail.Lifetime=0.32; trail.LightEmission=0.6; trail.MinLength=0.1; trail.Enabled=false
			trail.Transparency=NumberSequence.new(0.5,1); trail.Parent=s.model.Effects
			table.insert(s.trails,trail)
		end
	end
	for _,flame in ipairs(s.flames) do
		flame.emitter.Color=ColorSequence.new(Color3.fromRGB(175,245,255),Color3.fromRGB(25,115,255))
		flame.light.Color=Color3.fromRGB(50,170,255)
	end
	s.visualClock=0; s.iks={}; s.emptyTime=0
	s.filteredSteer=0; s.filteredThrottle=0; s.driftBlend=0; s.normal=Vector3.yAxis; s.driveAccel=0
	s.params=RaycastParams.new(); s.params.FilterType=Enum.RaycastFilterType.Exclude
	s.params.RespectCanCollide=true
	s.chassis:SetNetworkOwner(nil)
	s.prompt.Triggered:Connect(function(player)
		local humanoid=player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if not humanoid or humanoid.Health&lt;=0 or not root or playerStates[player] or s.seat.Occupant or s.reserved then return end
		if (root.Position-s.seat.Position).Magnitude&gt;11 or not race:CanJoin(player) then return end
		s.reserved=true; s.prompt.Enabled=false
		s.seat:Sit(humanoid)
		task.delay(1,function()
			s.reserved=false
			if s.model.Parent and not s.seat.Occupant then s.prompt.Enabled=true end
		end)
	end)
	s.seat:GetPropertyChangedSignal("Occupant"):Connect(function()
		if s.restoring then return end
		if s.seatLock and s.seatLock:Enforce() then return end
		attachDriver(s)
	end)
	table.insert(states,s)
end

local markers=workspace:FindFirstChild("KartSpawns")
if markers then
	for _,marker in ipairs(markers:GetChildren()) do
		if marker:IsA("BasePart") then
			marker.CanCollide=false; marker.CanTouch=false; marker.CanQuery=false; marker.Transparency=1
			spawnKart(marker.CFrame,marker:GetAttribute("ColorName") or (Config.Palette[marker.Name] and marker.Name) or "Red")
		end
	end
end
if #states==0 then spawnKart(Config.SpawnCFrame,"Red") end

input.OnServerEvent:Connect(function(player, throttle, steer, drift, ...)
	local now=workspace:GetServerTimeNow()
	local rate=rates[player]
	if not rate or now-rate.time&gt;=1 then rate={time=now,count=0}; rates[player]=rate end
	rate.count+=1
	if rate.count&gt;Config.InputRate+15 then return end
	local s=playerStates[player]
	if not s or s.seat.Occupant~=s.humanoid or s.humanoid.Health&lt;=0 then return end
	if select("#",...)~=0 or not Dynamics.finite(throttle) or not Dynamics.finite(steer) or type(drift)~="boolean" then return end
	s.lastInput=now
	s.throttle=math.clamp(throttle,-1,1); s.steer=math.clamp(steer,-1,1)
	s.drift=drift
end)

Players.PlayerRemoving:Connect(function(player)
	local s=playerStates[player]
	if s then restoreDriver(s) end
	rates[player]=nil
end)

RunService.PreSimulation:Connect(function(delta)
	local dt=math.min(delta,1/15)
	local now=workspace:GetServerTimeNow()
	local characters={}
	for _,player in ipairs(Players:GetPlayers()) do
		if player.Character then table.insert(characters,player.Character) end
	end
	for index=#states,1,-1 do
		local s=states[index]
		if not s.model:IsDescendantOf(workspace) or not s.chassis:IsDescendantOf(workspace)
			or not s.seat:IsDescendantOf(workspace) then
			restoreDriver(s); table.remove(states,index); continue
		end
		local root=s.chassis
		if s.seatLock then
			if not s.seatLock:Enforce() then restoreDriver(s) end
		end
		if root.Position.Y&lt;workspace.FallenPartsDestroyHeight+30 then
			-- Recover the seated assembly without unlocking a living driver.
			local character=s.player and s.player.Character
			local relative=character and root.CFrame:ToObjectSpace(character:GetPivot())
			root.Anchored=false; s.model:PivotTo(s.spawn)
			if character and relative then character:PivotTo(s.spawn*relative) end
			root.AssemblyLinearVelocity=Vector3.zero; root.AssemblyAngularVelocity=Vector3.zero
			s.charge=0; s.boostEnd=0; s.boostPower=0; s.turboArmed=false; s.wasDrift=false
		end
		if s.player and now-s.lastInput&gt;Config.InputTimeout then
			s.throttle=0; s.steer=0; s.drift=false; s.charge=0; s.turboArmed=false; s.wasDrift=false
		end
		local exclusions={s.model,table.unpack(characters)}
		s.params.FilterDescendantsInstances=exclusions
		local mass=root.AssemblyMass
		if root.Anchored then mass=root:GetMass() end
		local cf=root.CFrame
		local velocity=root.AssemblyLinearVelocity
		local speed=velocity:Dot(cf.LookVector)
		local contacts={}; local groundNormal=Vector3.zero
		for _,wheel in ipairs(s.wheels) do
			local mount=cf:PointToWorldSpace(wheel.origin)
			local ray=workspace:Raycast(mount,-cf.UpVector*(Config.WheelRadius+Config.SuspensionRest+Config.SuspensionTravel),s.params)
			wheel.distance=Config.SuspensionRest+Config.SuspensionTravel
			wheel.force.Force=Vector3.zero
			if ray and ray.Normal.Y&gt;0.15 then
				wheel.distance=math.max(-0.2,ray.Distance-Config.WheelRadius)
				local compression=Config.SuspensionRest-wheel.distance
				-- Include moving ground velocity so platforms do not kick the springs.
				local groundVelocity=Vector3.zero
				if ray.Instance:IsA("BasePart") then groundVelocity=ray.Instance:GetVelocityAtPosition(ray.Position) end
				-- Damp heave here, not angular point velocity: four full-strength
				-- corner dampers massively overdamp the low-inertia chassis roll.
				-- Pitch/roll receive a separate inertia-scaled angular damper below.
				local vertical=(velocity-groundVelocity):Dot(cf.UpVector)
				local support=Dynamics.suspension(compression,vertical,workspace.Gravity,Config)*mass/4
				wheel.force.Force=cf.UpVector*support
				table.insert(contacts,wheel); groundNormal+=ray.Normal
			end
		end
		local grounded=#contacts&gt;=2
		local drifting,boost=Dynamics.updateBoost(s,now,dt,grounded,speed,Config)
		s.turboEffect=Dynamics.approach(s.turboEffect,boost&gt;0 and 1 or 0,boost&gt;0 and 14 or 5,dt)
		s.filteredSteer=Dynamics.approach(s.filteredSteer,s.player and s.steer or 0,Config.SteerResponse,dt)
		s.filteredThrottle=Dynamics.approach(s.filteredThrottle,s.player and s.throttle or 0,Config.ThrottleResponse,dt)
		if math.abs(s.filteredThrottle)&lt;0.001 then s.filteredThrottle=0 end
		s.driftBlend=Dynamics.approach(s.driftBlend,drifting and 1 or 0,drifting and Config.DriftEnterResponse or Config.DriftExitResponse,dt)
		local steerAngle,desiredYaw=Dynamics.steering(speed,s.filteredSteer,s.driftBlend,Config)
		local targetNormal=grounded and groundNormal.Unit or s.normal
		s.normal=s.normal:Lerp(targetNormal,1-math.exp(-dt*Config.NormalResponse)).Unit
		local normal=s.normal
		local forward=cf.LookVector-normal*cf.LookVector:Dot(normal)
		if forward.Magnitude&gt;0.01 then forward=forward.Unit else forward=cf.LookVector end
		local right=forward:Cross(normal).Unit
		-- Tire traction acts once at the COM. It no longer injects a second yaw
		-- controller at the axles or rolls the chassis by acting above its COM.
		local sideAccel=Dynamics.lateral(speed,velocity:Dot(right),s.filteredSteer,s.driftBlend,Config)
		local drive=Dynamics.longitudinal(speed,s.filteredThrottle,boost,Config)
		if not s.player then drive=math.clamp(-speed*10,-80,80) end
		s.driveAccel=Dynamics.approach(s.driveAccel,drive,10,dt)
		s.driveForce.Force=grounded and (forward*s.driveAccel+right*sideAccel)*mass*(#contacts/4) or Vector3.zero
		if grounded then
			local angular=root.AssemblyAngularVelocity
			local tilt=cf.UpVector:Cross(normal)
			local inertia=mass*(root.Size.X^2+root.Size.Z^2)/12
			local pitchInertia=mass*(root.Size.Y^2+root.Size.Z^2)/12
			local rollInertia=mass*(root.Size.X^2+root.Size.Y^2)/12
			local yawAccel=math.clamp((desiredYaw-angular:Dot(normal))*Config.YawResponse,-Config.MaxYawAcceleration,Config.MaxYawAcceleration)
			-- Springs handle contact roll/pitch; this bounded damper suppresses
			-- excess tilt instead of repeatedly forcing a new orientation.
			local angularDamping=cf.RightVector*angular:Dot(cf.RightVector)*pitchInertia*26
				+cf.LookVector*angular:Dot(cf.LookVector)*rollInertia*26
			s.torque.Torque=tilt*10*inertia-angularDamping+normal*yawAccel*inertia
		else s.torque.Torque=-root.AssemblyAngularVelocity*mass*0.8 end
		-- Empty vehicles settle before anchoring, then remain parked even on slopes.
		if not s.player then
			s.emptyTime+=dt
			if grounded and (velocity.Magnitude&lt;1 or s.emptyTime&gt;2) then
				root.AssemblyLinearVelocity=Vector3.zero; root.AssemblyAngularVelocity=Vector3.zero; root.Anchored=true
			end
		else
			s.emptyTime=0
			local hardLimit=Config.MaxSpeed+Config.TurboPower+15
			local horizontal=Vector3.new(velocity.X,0,velocity.Z)
			if horizontal.Magnitude&gt;hardLimit then
				local capped=horizontal.Unit*hardLimit
				root.AssemblyLinearVelocity=Vector3.new(capped.X,velocity.Y,capped.Z)
			end
		end
		s.visualSteer=steerAngle
		s.visualClock+=delta
		if s.visualClock&gt;=1/20 then
			s.visualClock=0
			local charge=math.clamp(s.charge/Config.DriftChargeTime,0,1)
			for _,wheel in ipairs(s.wheels) do
				wheel.motor:SetAttribute("SuspensionDistance",wheel.distance)
				wheel.emitterAt.Position=wheel.origin-Vector3.new(0,wheel.distance+Config.WheelRadius,0)
				wheel.smoke.Rate=drifting and not wheel.front and 12 or 0
				wheel.sparks.Rate=drifting and not wheel.front and (5+charge*15) or 0
				wheel.sparks.Color=ColorSequence.new(chargeColors[1]:Lerp(chargeColors[2],charge))
				for _,glow in ipairs(wheel.glow or {}) do glow.Transparency=1-s.turboEffect*0.75 end
			end
			s.model:SetAttribute("SteerAngle",s.visualSteer)
			s.model:SetAttribute("DriftBlend",s.driftBlend)
			if s.waist then s.waist.C0=s.waistBase*CFrame.Angles(0,0,-s.visualSteer*0.16) end
			for _,flame in ipairs(s.flames) do
				flame.emitter.Rate=s.turboEffect&gt;0.02 and s.turboEffect*35 or 0
				flame.light.Brightness=s.turboEffect*2
				flame.smoke.Rate=s.player and s.filteredThrottle&gt;0.1 and 3 or 0
			end
			for _,trail in ipairs(s.trails) do
				trail.Enabled=s.turboEffect&gt;0.1
				trail.Transparency=NumberSequence.new(1-s.turboEffect*0.55,1)
			end
			for _,light in ipairs(s.brakeLights) do
				if light.Parent then
					local braking=s.throttle&lt;0 and speed&gt;2
					light.Material=braking and Enum.Material.Neon or Enum.Material.SmoothPlastic
					light.Color=braking and Color3.fromRGB(255,30,35) or Color3.fromRGB(110,5,10)
				end
			end
			s.model:SetAttribute("Speed",math.abs(speed)); s.model:SetAttribute("Boosting",boost&gt;0)
			s.model:SetAttribute("DriftCharge",charge)
			s.model:SetAttribute("TurboArmed",s.turboArmed==true)
			s.model:SetAttribute("BoostEnd",s.boostEnd)
			s.model:SetAttribute("TurboCooldownEnd",s.cooldown)
			s.model:SetAttribute("TurboCooldownRemaining",math.max(0,s.cooldown-now))
			s.model:SetAttribute("DriftReady",now&gt;=s.cooldown and boost==0)
			s.model:SetAttribute("DriverLocked",s.seatLock~=nil)
		end
	end
	race:Update(states,dt)
end)
</ProtectedString>
        <bool name="Disabled">true</bool>
      </Properties>
    </Item>
    <Item class="LocalScript" referent="RBX14">
      <Properties>
        <string name="Name">KartController</string>
        <ProtectedString name="Source">local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local RunService=game:GetService("RunService")
local ContextActionService=game:GetService("ContextActionService")
local UserInputService=game:GetService("UserInputService")
local CollectionService=game:GetService("CollectionService")
local player=Players.LocalPlayer
local input=ReplicatedStorage:WaitForChild("KartSystem"):WaitForChild("Remotes"):WaitForChild("Input")
local active,seat,root
local throttle,steer=0,0
local drift=false
local held={}
local analog=Vector2.zero
local clock=0
local Config=require(ReplicatedStorage:WaitForChild("KartSystem"):WaitForChild("KartConfig"))
local Dynamics=require(ReplicatedStorage.KartSystem:WaitForChild("KartDynamics"))
local Presentation=require(ReplicatedStorage.KartSystem:WaitForChild("KartPresentation"))
local presentations={}
local cameraFocus,cameraHeading,lastCameraRoot
local cameraCF
local previousCamera
local previousJump
local previousZoom
local HUD=require(ReplicatedStorage.KartSystem:WaitForChild("KartHUD"))
local hud=HUD.new(player:WaitForChild("PlayerGui"),Config,{
	player=player,players=Players,raceState=ReplicatedStorage.KartSystem:WaitForChild("RaceState"),
})
local previousStates
local seatedHumanoid
local originalStates=setmetatable({},{__mode="k"})
local lockedStates={Enum.HumanoidStateType.Jumping,Enum.HumanoidStateType.GettingUp}

-- Capture local defaults before entering; do not sample a state already locked
-- by another part of the seating lifecycle and later restore that false value.
local function rememberCharacter(character)
	local humanoid=character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid",10)
	if humanoid and not originalStates[humanoid] then
		local states={}
		for _,state in ipairs(lockedStates) do states[state]=humanoid:GetStateEnabled(state) end
		originalStates[humanoid]=states
	end
end
player.CharacterAdded:Connect(rememberCharacter)
if player.Character then rememberCharacter(player.Character) end

local function send()
	if active then input:FireServer(throttle,steer,drift) end
end

local function action(name,state,obj)
	if UserInputService:GetFocusedTextBox() then
		held={}; analog=Vector2.zero; throttle=0; steer=0; drift=false; send()
		return Enum.ContextActionResult.Pass
	end
	if name=="KartBlockExitJump" then return Enum.ContextActionResult.Sink end
	local down=state==Enum.UserInputState.Begin or state==Enum.UserInputState.Change
	if state==Enum.UserInputState.Cancel then down=false end
	if name=="KartThumbstick" then
		analog=down and Vector2.new(obj.Position.X,obj.Position.Y) or Vector2.zero

	else held[name..":"..obj.KeyCode.Name]=down end
	local function pressed(actionName)
		for key,value in pairs(held) do if value and key:sub(1,#actionName+1)==actionName..":" then return true end end
		return false
	end
	throttle=(pressed("KartForward") and 1 or 0)-(pressed("KartReverse") and 1 or 0)
	steer=(pressed("KartRight") and 1 or 0)-(pressed("KartLeft") and 1 or 0)
	if math.abs(analog.Y)&gt;0.15 then throttle=analog.Y end
	if math.abs(analog.X)&gt;0.15 then steer=analog.X end
	drift=pressed("KartDrift")
	return Enum.ContextActionResult.Sink
end

local bindings={
	{"KartForward","Gas",Enum.KeyCode.W,Enum.KeyCode.Up,Enum.KeyCode.ButtonR2},
	{"KartReverse","Brake",Enum.KeyCode.S,Enum.KeyCode.Down,Enum.KeyCode.ButtonL2},
	{"KartLeft","Left",Enum.KeyCode.A,Enum.KeyCode.Left},
	{"KartRight","Right",Enum.KeyCode.D,Enum.KeyCode.Right},
	{"KartDrift","DRIFT",Enum.KeyCode.LeftShift,Enum.KeyCode.RightShift,Enum.KeyCode.ButtonA,Enum.KeyCode.ButtonX},
	{"KartBlockExitJump","",Enum.KeyCode.Space,Enum.KeyCode.E,Enum.KeyCode.F,Enum.KeyCode.ButtonB},
}

local function stop()
	if not active then return end
	throttle=0; steer=0; drift=false; send()
	for _,binding in ipairs(bindings) do ContextActionService:UnbindAction(binding[1]) end
	ContextActionService:UnbindAction("KartThumbstick")
	if seatedHumanoid and seatedHumanoid.Parent and previousStates then
		for state,enabled in pairs(previousStates) do seatedHumanoid:SetStateEnabled(state,enabled) end
	end
	seatedHumanoid=nil; previousStates=nil
	if previousJump~=nil then player.AutoJumpEnabled=previousJump end
	if previousZoom then player.CameraMinZoomDistance=previousZoom[1]; player.CameraMaxZoomDistance=previousZoom[2] end
	local camera=workspace.CurrentCamera
	if camera and previousCamera then
		camera.CameraType=previousCamera.kind
		camera.CameraSubject=previousCamera.subject
		camera.FieldOfView=previousCamera.fov
	end
	active=nil; seat=nil; root=nil; cameraCF=nil; cameraFocus=nil; cameraHeading=nil; lastCameraRoot=nil; hud:SetVisible(false)
	held={}; analog=Vector2.zero
end

local function start(model)
	if active==model then return end
	stop()
	local driverSeat=model:FindFirstChild("DriverSeat")
	local chassis=model:FindFirstChild("Chassis")
	if not driverSeat or not chassis then return end
	active=model; seat=driverSeat; root=chassis
	local camera=workspace.CurrentCamera
	if not camera then stop(); return end
	previousCamera={kind=camera.CameraType,subject=camera.CameraSubject,fov=camera.FieldOfView}
	previousJump=player.AutoJumpEnabled; player.AutoJumpEnabled=false
	previousZoom={player.CameraMinZoomDistance,player.CameraMaxZoomDistance}
	camera.CameraType=Enum.CameraType.Scriptable
	seatedHumanoid=player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	previousStates={}
	if seatedHumanoid then
		for _,state in ipairs(lockedStates) do
			local original=originalStates[seatedHumanoid]
			local attribute=state==Enum.HumanoidStateType.Jumping and "DriverJumpingBeforeLock" or "DriverGettingUpBeforeLock"
			local beforeLock=model:GetAttribute(attribute)
			if type(beforeLock)=="boolean" then previousStates[state]=beforeLock
			else previousStates[state]=original and original[state] end
			if previousStates[state]==nil then previousStates[state]=seatedHumanoid:GetStateEnabled(state) end
			seatedHumanoid:SetStateEnabled(state,false)
		end
		seatedHumanoid.Jump=false
	end
	for index,binding in ipairs(bindings) do
		local keys={table.unpack(binding,3)}
		local touch=binding[1]~="KartBlockExitJump"
		ContextActionService:BindActionAtPriority(binding[1],action,touch,5000,table.unpack(keys))
		if touch then
			ContextActionService:SetTitle(binding[1],binding[2])
			local positions={UDim2.new(1,-88,1,-166),UDim2.new(1,-170,1,-100),UDim2.new(0,45,1,-130),UDim2.new(0,133,1,-130),UDim2.new(1,-88,1,-82)}
			ContextActionService:SetPosition(binding[1],positions[index])
			local button=ContextActionService:GetButton(binding[1])
			if button then
				button.ImageColor3=binding[1]=="KartDrift" and Color3.fromRGB(76,224,255) or Color3.fromRGB(38,57,83)
				button.ImageTransparency=0.12
			end
		end
	end
	ContextActionService:BindActionAtPriority("KartThumbstick",action,false,5000,Enum.KeyCode.Thumbstick1)
	hud:SetVisible(true); clock=1
end

local function prepareVisuals(model)
	if presentations[model] then return end
	local chassis=model:FindFirstChild("Chassis")
	local wheels=model:FindFirstChild("Wheels")
	local steering=model:FindFirstChild("SteeringWheel")
	if not chassis or not wheels or not steering then return end
	local hub=steering:FindFirstChild("Hub")
	local motor=hub and hub:FindFirstChild("SteeringMotor")
	if not motor then return end
	local state={root=chassis,wheels={},steering=motor,base=motor.C0,angle=0}
	for _,wheel in ipairs(wheels:GetChildren()) do
		local tire=wheel:FindFirstChild("Tire")
		local wheelMotor=tire and tire:FindFirstChild("WheelMotor")
		if wheelMotor then
			table.insert(state.wheels,{motor=wheelMotor,origin=wheelMotor:GetAttribute("ContactOrigin") or wheelMotor.C0.Position+Vector3.new(0,Config.SuspensionRest,0),radius=wheelMotor:GetAttribute("WheelRadius") or Config.WheelRadius,distance=Config.SuspensionRest,spin=0,speed=0,front=wheel.Name:sub(1,5)=="Front"})
		end
	end
	presentations[model]=state
end

-- Every observer animates the same replicated assembly locally at render rate.
-- Motors are visual only; no client writes physics velocity or position.
RunService:BindToRenderStep("KartVisuals",Enum.RenderPriority.Character.Value+1,function(dt)
	dt=Presentation.delta(dt)
	for model,state in pairs(presentations) do
		if not model:IsDescendantOf(workspace) or not state.root:IsDescendantOf(workspace) then presentations[model]=nil; continue end
		state.angle=Dynamics.approach(state.angle,model:GetAttribute("SteerAngle") or 0,18,dt)
		for _,wheel in ipairs(state.wheels) do
			local target=wheel.motor:GetAttribute("SuspensionDistance") or Config.SuspensionRest
			local response=target&lt;wheel.distance and Config.VisualSuspensionResponse*2 or Config.VisualSuspensionResponse
			wheel.distance=Dynamics.approach(wheel.distance,target,response,dt)
			local direction=(state.root.CFrame*CFrame.Angles(0,wheel.front and state.angle or 0,0)).LookVector
			local pv=state.root:GetVelocityAtPosition(state.root.CFrame:PointToWorldSpace(wheel.origin))
			wheel.spin,wheel.speed=Presentation.wheel(wheel.spin,wheel.speed,pv:Dot(direction),wheel.radius,dt)
			wheel.motor.C0=CFrame.new(wheel.origin-Vector3.new(0,wheel.distance,0))*CFrame.Angles(0,wheel.front and state.angle or 0,0)*CFrame.Angles(wheel.spin,0,0)
		end
		state.steering.C0=state.base*CFrame.Angles(0,0,state.angle*1.8)
	end
end)

local function watch(model)
	prepareVisuals(model)
	local function changed()
		prepareVisuals(model)
		if model:GetAttribute("DriverUserId")==player.UserId then start(model)
		elseif active==model then stop() end
	end
	model:GetAttributeChangedSignal("DriverUserId"):Connect(changed)
	model.AncestryChanged:Connect(function() if active==model and not model:IsDescendantOf(workspace) then stop() end end)
	changed()
end
for _,model in ipairs(CollectionService:GetTagged("RacingKart")) do watch(model) end
CollectionService:GetInstanceAddedSignal("RacingKart"):Connect(watch)
player.CharacterRemoving:Connect(stop)
UserInputService.WindowFocusReleased:Connect(function()
	held={}; analog=Vector2.zero; throttle=0; steer=0; drift=false; send()
end)
UserInputService.TextBoxFocused:Connect(function()
	held={}; analog=Vector2.zero; throttle=0; steer=0; drift=false; send()
end)

UserInputService.JumpRequest:Connect(function()
	if active and seatedHumanoid then seatedHumanoid.Jump=false end
end)

local rayParams=RaycastParams.new(); rayParams.FilterType=Enum.RaycastFilterType.Exclude; rayParams.RespectCanCollide=true
RunService:BindToRenderStep("KartCamera",Enum.RenderPriority.Camera.Value+1,function(dt)
	if not active or not root then return end
	if not root:IsDescendantOf(workspace) then stop(); return end
	clock+=dt
	if clock&gt;=1/30 then clock=0; send() end
	local camera=workspace.CurrentCamera
	if not camera then return end
	dt=Presentation.delta(dt)
	local cf=root.CFrame
	if lastCameraRoot and (root.Position-lastCameraRoot).Magnitude&gt;48 then
		cameraFocus=nil; cameraHeading=nil
	end
	lastCameraRoot=root.Position
	local speed=active:GetAttribute("Speed") or 0
	local boosting=active:GetAttribute("Boosting") or false
	local flat=Vector3.new(cf.LookVector.X,0,cf.LookVector.Z)
	if flat.Magnitude&lt;0.01 then flat=Vector3.new(0,0,-1) else flat=flat.Unit end
	local motion=Vector3.new(root.AssemblyLinearVelocity.X,0,root.AssemblyLinearVelocity.Z)
	local blend=active:GetAttribute("DriftBlend") or 0
	if motion.Magnitude&gt;10 and motion.Unit:Dot(flat)&gt;0.3 then flat=flat:Lerp(motion.Unit,blend*Config.CameraDriftFollow).Unit end
	local heading=cameraHeading and cameraHeading:Lerp(flat,1-math.exp(-dt*Config.CameraHeadingResponse)) or flat
	cameraHeading=heading.Magnitude&gt;0.001 and heading.Unit or flat
	-- Compensate the horizontal filter's steady-speed lag; otherwise stacking
	-- position and CFrame filters makes the kart outrun its camera at high speed.
	local targetFocus=root.Position+Vector3.new(0,Config.CameraFocusHeight,0)+motion/Config.CameraPositionResponse
	if cameraFocus then
		local planar=1-math.exp(-dt*Config.CameraPositionResponse)
		local vertical=1-math.exp(-dt*Config.CameraHeightResponse)
		cameraFocus=Vector3.new(cameraFocus.X+(targetFocus.X-cameraFocus.X)*planar,cameraFocus.Y+(targetFocus.Y-cameraFocus.Y)*vertical,cameraFocus.Z+(targetFocus.Z-cameraFocus.Z)*planar)
	else cameraFocus=targetFocus end
	local focus=cameraFocus+cameraHeading*Config.CameraLookAhead
	local desired=focus-cameraHeading*(Config.CameraDistance+math.min(speed/40,2)*Config.ModelScale)+Vector3.new(0,Config.CameraHeight,0)
	rayParams.FilterDescendantsInstances={active,player.Character}
	local hit=workspace:Raycast(focus,desired-focus,rayParams)
	if hit then desired=hit.Position+hit.Normal*0.6 end
	local desiredCF=CFrame.lookAt(desired,focus)
	cameraCF=desiredCF -- focus and heading have already been independently filtered
	camera.CFrame=cameraCF -- no procedural shake, including drift and turbo
	local targetFov=70+math.clamp(speed/100,0,1)*12+(boosting and 5 or 0)
	camera.FieldOfView+=(targetFov-camera.FieldOfView)*(1-math.exp(-dt*5))
	hud:Update(active,speed,dt,workspace:GetServerTimeNow(),camera.ViewportSize,UserInputService.TouchEnabled,{
		lap=player:GetAttribute("KartLap"),totalLaps=player:GetAttribute("KartTotalLaps"),
		coins=player:GetAttribute("KartCoins"),wins=player:GetAttribute("KartWins"),place=player:GetAttribute("KartPlace"),
	})
end)
</ProtectedString>
        <bool name="Disabled">true</bool>
      </Properties>
    </Item>
  </Item>
</roblox>