local assertions=0
local function check(condition,message) assert(condition,message); assertions+=1 end
check(Rules.counter(nil)==nil and Rules.counter("2")==nil,"unknown values stay unknown")
check(Rules.counter(-1)==nil and Rules.counter(math.huge)==nil and Rules.counter(0/0)==nil,"invalid counters rejected")
check(Rules.counter(0)==0 and Rules.counter(3.9)==3,"nonnegative counters sanitized")
local state=Rules.new()
check(Rules.visit(state,2,3,2)==nil and state.lap==0,"start cannot skip gate one")
check(Rules.visit(state,1,3,2)=="start" and state.lap==1,"actual start sets lap one")
check(Rules.visit(state,1,3,2)==nil,"duplicate start ignored")
check(Rules.visit(state,3,3,2)==nil,"checkpoint skipping ignored")
check(Rules.visit(state,2,3,2)=="checkpoint" and state.expected==3,"sequential checkpoint")
check(Rules.visit(state,2,3,2)==nil,"duplicate checkpoint ignored")
Rules.visit(state,3,3,2)
check(Rules.visit(state,1,3,2)=="lap" and state.lap==2 and state.completed==1,"full route increments one lap")
Rules.resetRoute(state)
check(not state.started and state.expected==1 and state.completed==1,"route reset preserves completed laps")
Rules.visit(state,1,3,2)
check(state.lap==2,"restart resumes correct current lap")
Rules.visit(state,2,3,2); Rules.visit(state,3,3,2)
check(Rules.visit(state,1,3,2)=="finish" and state.finished,"race finishes at configured total")
check(Rules.visit(state,1,3,2)==nil,"finish cannot repeat")
local round={}
check(Rules.claimWinner(round,11) and not Rules.claimWinner(round,12) and round.winner==11,"one actual winner per round")
state=Rules.new()
check(Rules.collect(state,"a",2) and state.coins==2,"actual pickup credits value")
check(not Rules.collect(state,"a",2) and state.coins==2,"same coin cannot repeat")
check(not Rules.collect(state,"b",-1) and not Rules.collect(state,"b",0/0),"invalid coin value rejected")
state.finished=true
check(not Rules.collect(state,"b",1),"finished racer cannot farm coins")
local half=vec(2,2,2)
check(Rules.entry(nil,vec(0,0,0),half)==0,"initial in-gate position may start")
check(Rules.entry(vec(0,0,0),vec(1,0,0),half)==nil,"parking inside gate does not repeat")
check(math.abs(Rules.entry(vec(-8,0,0),vec(8,0,0),half)-0.375)<1e-9,"fast sweep catches thin gate")
check(Rules.entry(vec(-8,5,0),vec(8,5,0),half)==nil,"outside sweep misses gate")

resetWorld()
local p,k=player(1)
local race=Race.new(Config)
race:Update({k},0.11)
check(p:GetAttribute("KartLap")==nil and p:GetAttribute("KartCoins")==nil and p:GetAttribute("KartWins")==nil,"no invented unconfigured stats")
p:SetAttribute("Lap",2); p:SetAttribute("TotalLaps",5); p:SetAttribute("Coins",7); p:SetAttribute("Wins",4)
race:Update({k},0.11)
check(p:GetAttribute("KartLap")==2 and p:GetAttribute("KartTotalLaps")==5,"actual attribute lap sources")
check(p:GetAttribute("KartCoins")==7 and p:GetAttribute("KartWins")==4,"actual attribute currency/win sources")
p:SetAttribute("Coins",9); race:Update({k},0.11)
check(p:GetAttribute("KartCoins")==9,"external source updates dynamically")
p:SetAttribute("Lap",nil); p:SetAttribute("Coins",nil)
local stats=instance("Folder","leaderstats",p)
local lap=instance("IntValue","CurrentLap",stats); lap.Value=3
local coins=instance("NumberValue","Coins",stats); coins.Value=11
race:Update({k},0.11)
check(p:GetAttribute("KartLap")==3 and p:GetAttribute("KartCoins")==11,"leaderstats alias sources")
check(p:GetAttribute("Coins")==nil and coins.Value==11,"bridge never overwrites foreign stats")
race:Destroy()
check(p:GetAttribute("KartLap")==nil and p:GetAttribute("Wins")==4,"destroy clears only owned snapshots")

resetWorld()
local root=course(2)
p,k=player(11)
local p2,k2=player(12)
race=Race.new(Config)
local function move(kart,x)
	kart.chassis.Position=vec(x,0,0)
	race:Update({k,k2},0.11)
end
race:Update({k,k2},0.11)
check(p:GetAttribute("KartLap")==0 and p:GetAttribute("KartTotalLaps")==2 and p:GetAttribute("KartWins")==0,"configured course exposes actual initial race state")
move(k,0); check(p:GetAttribute("KartLap")==1,"entering actual start gate starts race")
move(k,0); check(race.states[p].expected==2,"parked gate cannot farm")
move(k,40); check(race.states[p].expected==1,"swept crossings process sequential gates")
move(k,0); check(p:GetAttribute("KartLap")==2,"actual completed route advances lap")
move(k,40); move(k,0)
check(race.states[p].finished and p:GetAttribute("KartWins")==1,"first actual finisher earns win")
move(k,40); move(k,0)
check(p:GetAttribute("KartWins")==1,"finished racer cannot earn repeat win")
move(k2,0); move(k2,40); move(k2,0); move(k2,40); move(k2,0)
check(race.states[p2].finished and p2:GetAttribute("KartWins")==0,"later finisher is not labeled winner")
race:ResetRound(); race:Update({k,k2},0.11)
check(not race.states[p].finished and p:GetAttribute("KartWins")==1,"new round resets race and retains session wins")
race:Destroy()

